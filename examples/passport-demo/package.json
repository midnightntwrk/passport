{
  "name": "passport-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:c1": "node scripts/prepare-c1.mjs",
    "test:c1": "npm run prepare:c1 && node scripts/check-c1-draft.mjs",
    "check:pwa": "node scripts/check-pwa.mjs",
    "test:pwa": "npm run build && npm run check:pwa",
