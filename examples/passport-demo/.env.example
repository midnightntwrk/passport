# Dynamic dashboard environment ID. This is safe to expose to the browser.
VITE_DYNAMIC_ENVIRONMENT_ID=

# Midnight indexer GraphQL endpoint behind the mobile Home screen's recent
# transactions. Pass the HTTP URL — the client derives its own WebSocket URL.
# Defaults to the preview indexer when unset.
# VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Origin of the Midnight Raffle example dApp listed in the Apps registry
# (decided 2026/08/05 — replaces the deprecated VITE_ATLAS_URL). It must be a
# separate origin from Passport for the profile consent handshake to be real.
# Defaults to http://localhost:5177 when unset.
# VITE_RAFFLE_URL=http://localhost:5177

# Telegram support channel. When set, the Home screen renders a "Support on
# Telegram" pill in its footer area; when unset, no support link is shown.
# VITE_TELEGRAM_URL=https://t.me/midnightpassport

# ---------------------------------------------------------------------------
# Choosing a network
# ---------------------------------------------------------------------------
# The whole app follows VITE_MIDNIGHT_NETWORK_ID: the wallet signs there, the
# network switcher opens there, names register there, and the faucet and
# explorer links point there. Unset means `preview`.
#
# VITE_MIDNIGHT_NETWORK_ID=preview
# VITE_MIDNIGHT_NODE_URL=https://rpc.preview.midnight.network
# VITE_MIDNIGHT_PROVING_URL=https://proof-server.preview.midnight.network
#
# Sponsored fees. Unset means sponsorship is OFF and every fee is the user's;
# there is no default URL. The client gates on `available > 0` from the
# service's own /wallet-status, never on a hopeful assumption.
# VITE_SPONSOR_URL=https://api-preview.1am.xyz
#
# PRE-PRODUCTION — DO NOT SET THESE YET (measured 2026/08/06)
# -----------------------------------------------------------
# Every preprod endpoint is healthy, and the sponsor is funded there — it is
# the first environment where the sponsored-fee gate genuinely opens
# (`available: 1`, ~29.8 DUST, synced). The app is fully network-generalised
# and was verified against preprod end to end: preprod addresses, preprod
# indexer, availability decoded from the preprod `.night` TLD, preprod faucet
# link, sponsor gate AVAILABLE.
#
# It still cannot ship, for one reason: the FIRST sync. A cold wallet walks the
# chain from genesis, and preprod is ~1.98M blocks deep against preview's
# ~296k. Measured in-tab, on the same machine, minutes apart:
#
#   preview   4% -> synced in ~75 s, heap steady at ~90 MB
#   preprod   3% after 150 s, heap climbing ~25 MB/s, tab CRASHES at ~4.2 GB
#
# The fix would be a server-assisted first sync, which does not exist as a
# public primitive today. Until it does, this demo stays on preview.
#
#   VITE_MIDNIGHT_NETWORK_ID=preprod
#   VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
#   VITE_MIDNIGHT_NODE_URL=https://rpc.preprod.midnight.network
#   VITE_MIDNIGHT_PROVING_URL=https://proof-server.preprod.midnight.network
#   VITE_SPONSOR_URL=https://api-preprod.1am.xyz

# Configure these in the Dynamic dashboard before live validation:
# - Midnight enabled under Chains & Networks
# - Embedded wallets created on sign-up
# - Private Key Exports enabled under Embedded Wallets > Security
# - Discord and/or Email enabled under Authentication
# - http://localhost:5175 added to Allowed Origins
