{
  "id": "/",
  "name": "Midnight Passport",
  "short_name": "Passport",
  "description": "Your Midnight name, your money, and the apps you have connected — in one installable app.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#f5f5f3",
  "theme_color": "#0a0a0a",
  "categories": [
    "finance",
    "utilities"
  ],
  "icons": [
    {
      "src": "/icons/passport-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/passport-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/passport-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/midnight-symbol.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "monochrome"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Passport",
      "short_name": "Passport",
      "url": "/",
      "icons": [
        {
          "src": "/icons/passport-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
