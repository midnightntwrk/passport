# Origin of the Passport app this raffle talks to. Must be a separate origin
# from the raffle itself for the postMessage handshake to mean anything.
# Defaults to http://localhost:5175 when unset.
# VITE_PASSPORT_ORIGIN=http://localhost:5175

# Telegram support channel shown on the ticket. No link is rendered when unset.
# VITE_TELEGRAM_URL=https://t.me/midnightpassport

# ---------------------------------------------------------------------------
# On-chain entry
# ---------------------------------------------------------------------------
# The preview unshielded address (mn_addr…) the raffle operator controls.
# SET IT and "Enter the raffle" asks Passport for a real NIGHT transfer: the
# user approves it in Passport's own sheet, the wallet signs and submits, and
# the ticket carries the node's transaction id.
# LEAVE IT UNSET and the raffle stays profile-only: no transaction request is
# ever sent and the footer says nothing is on-chain.
#
# The demo operator address below is derived from a deliberately public seed —
# sha256('midnight-passport-demo/raffle-operator/v1') — so anybody running the
# demo can inspect or sweep what it collects. Replace it for anything real.
# VITE_RAFFLE_COLLECTION_ADDRESS=mn_addr_preview13p3kycpxgk0yen88a9m4xja59p5npw40wkh6exa5ppgv28arfk2s3ut6lg

# Entry price in ATOMIC NIGHT units (1 NIGHT = 1_000_000). Default 100000 = 0.1.
# VITE_RAFFLE_ENTRY_AMOUNT=100000
