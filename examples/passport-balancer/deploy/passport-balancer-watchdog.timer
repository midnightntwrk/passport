[Unit]
Description=Probe the whole Midnight Passport sponsor stack every minute

[Timer]
# Five minutes after boot: the balancer resumes from its snapshot in about a
# second, but a cold start walks the chain, and probing it before it can
# possibly be ready would only ever produce noise.
OnBootSec=5min
# Every minute. It was two, and on 2026/09/05 the sponsor was unable to submit
# for five hours: at one minute a tick, three strikes is three minutes of
# continuous fault before anything is restarted, and a spend in flight still
# holds every restart off regardless of the streak.
OnUnitActiveSec=1min
AccuracySec=5s
# So the probe never lands on the same second as the balancer's own
# sixty-second snapshot save or its DUST registration retry.
RandomizedDelaySec=10
Unit=passport-balancer-watchdog.service

[Install]
WantedBy=timers.target
