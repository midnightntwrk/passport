[Unit]
Description=Supervise the Midnight Passport sponsor stack and restart what has stopped answering
Documentation=file:///opt/passport-balancer/deploy/passport-balancer-watchdog.sh
# Nothing to do while the service it watches is not meant to be running.
After=passport-balancer.service

[Service]
Type=oneshot
# WATCHDOG_ALERT_WEBHOOK and WATCHDOG_REBOOT live here, mode 600, root-owned,
# and not in the repository. The leading `-` makes the file optional: with no
# file and no webhook the script posts nothing and behaves exactly as before.
EnvironmentFile=-/etc/passport-balancer-watchdog.env
ExecStart=/usr/local/lib/passport-balancer-watchdog.sh
# One check must never outlive its own interval, or two of them overlap and
# both strike for the same failure. The interval is a minute now, and the
# script's own budget is five probes of five seconds plus two status reads —
# under 30 s — so this is the outer bound rather than the expected duration.
TimeoutStartSec=50
StandardOutput=journal
StandardError=journal
