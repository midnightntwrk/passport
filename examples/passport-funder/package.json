{
  "name": "passport-funder",
  "version": "0.1.0",
  "description": "Self-hosted activation funder for Midnight Passport: drips activation-sized NIGHT to brand-new wallets so their first .night claim executes immediately.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/server.ts src/generate-seed.ts --bundle --format=esm --platform=node --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "npm run build && node dist/server.mjs",
    "generate-seed": "npm run build && node dist/generate-seed.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.0.3",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.1",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "4.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "3.0.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "3.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
