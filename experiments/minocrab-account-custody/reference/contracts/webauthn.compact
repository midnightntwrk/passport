// Profiled WebAuthn assertion verification. Every signed byte is reconstructed
// in-circuit; a client-supplied hash or a client-only JSON check is insufficient.
// This profile accepts the Level-3 JSON order type/challenge/origin/crossOrigin,
// with crossOrigin=false, no additional members, and 37-byte authenticatorData.
// originLength is a compile-time profile parameter, not a padded signed string.
module WebAuthn<#originLength> {
  import CompactStandardLibrary;

  export struct WebAuthnPolicy {
    rp_id_hash: Bytes<32>;
    origin: Bytes<originLength>;
  }

  circuit byte_bits(b: Uint<8>): Vector<8, Boolean> {
    const b7 = b >= 128;
    const v6 = b7 ? b - 128 : b;
    const b6 = v6 >= 64;
    const v5 = b6 ? v6 - 64 : v6;
    const b5 = v5 >= 32;
    const v4 = b5 ? v5 - 32 : v5;
    const b4 = v4 >= 16;
    const v3 = b4 ? v4 - 16 : v4;
    const b3 = v3 >= 8;
    const v2 = b3 ? v3 - 8 : v3;
    const b2 = v2 >= 4;
    const v1 = b2 ? v2 - 4 : v2;
    const b1 = v1 >= 2;
    const v0 = b1 ? v1 - 2 : v1;
    return [b7, b6, b5, b4, b3, b2, b1, v0 == 1];
  }

  circuit b64char(a: Boolean, b: Boolean, c: Boolean,
                  d: Boolean, e: Boolean, f: Boolean): Uint<8> {
    const index = ((a ? 32 : 0) + (b ? 16 : 0) + (c ? 8 : 0)
                  + (d ? 4 : 0) + (e ? 2 : 0) + (f ? 1 : 0)) as Uint<6>;
    return index < 26 ? ((index + 65) as Uint<8>)
      : index < 52 ? ((index + 71) as Uint<8>)
      : index < 62 ? ((index - 4) as Uint<8>)
      : index == 62 ? (45 as Uint<8>) : (95 as Uint<8>);
  }

  circuit b64three(input: Bytes<3>): Bytes<4> {
    const a = byte_bits(input[0]);
    const b = byte_bits(input[1]);
    const c = byte_bits(input[2]);
    return Bytes[
      b64char(a[0], a[1], a[2], a[3], a[4], a[5]),
      b64char(a[6], a[7], b[0], b[1], b[2], b[3]),
      b64char(b[4], b[5], b[6], b[7], c[0], c[1]),
      b64char(c[2], c[3], c[4], c[5], c[6], c[7])
    ];
  }

  export pure circuit webauthn_challenge_base64(challenge: Bytes<32>): Bytes<43> {
    const a = byte_bits(challenge[30]);
    const b = byte_bits(challenge[31]);
    return Bytes[
      ...b64three(slice<3>(challenge, 0)), ...b64three(slice<3>(challenge, 3)),
      ...b64three(slice<3>(challenge, 6)), ...b64three(slice<3>(challenge, 9)),
      ...b64three(slice<3>(challenge, 12)), ...b64three(slice<3>(challenge, 15)),
      ...b64three(slice<3>(challenge, 18)), ...b64three(slice<3>(challenge, 21)),
      ...b64three(slice<3>(challenge, 24)), ...b64three(slice<3>(challenge, 27)),
      b64char(a[0], a[1], a[2], a[3], a[4], a[5]),
      b64char(a[6], a[7], b[0], b[1], b[2], b[3]),
      b64char(b[4], b[5], b[6], b[7], false, false)
    ];
  }

  export pure circuit webauthn_client_data_hash(
    challenge: Bytes<32>, origin: Bytes<originLength>
  ): Bytes<32> {
    // An unescaped quote/backslash must never create another JSON member.
    for (const b of origin) {
      assert(b >= 33 && b <= 126 && b != 34 && b != 92, "invalid origin bytes");
    }
    return persistentHash<[Bytes<36>, Bytes<43>, Bytes<12>, Bytes<originLength>, Bytes<22>]>([
      pad(36, "{\"type\":\"webauthn.get\",\"challenge\":\""),
      webauthn_challenge_base64(challenge), pad(12, "\",\"origin\":\""),
      origin, pad(22, "\",\"crossOrigin\":false}")
    ]);
  }

  export pure circuit p256_verify_digest(
    digest: Bytes<32>, sig: Secp256r1EcdsaSignature, pk: Secp256r1Point
  ): Boolean {
    assert(sig.r != default<Secp256r1Scalar>, "zero ECDSA r");
    assert(sig.s != default<Secp256r1Scalar>, "zero ECDSA s");
    // The native verifier rejects identity keys and infinity results, validates
    // curve arithmetic and reduces the message and R.x modulo the group order.
    // Scalar types are canonical. Both low-S and high-S are deliberately valid.
    return secp256r1EcdsaVerify(digest, sig, pk);
  }

  export pure circuit webauthn_verify(
    challenge: Bytes<32>, policy: WebAuthnPolicy,
    authenticator_data: Bytes<37>, sig: Secp256r1EcdsaSignature,
    pk: Secp256r1Point
  ): Boolean {
    assert(slice<32>(authenticator_data, 0) == policy.rp_id_hash, "WebAuthn RP mismatch");
    // UP + UV required for every operation. AT/ED and reserved bits are clear;
    // BS implies BE. Accept ordinary, backup-eligible, and backed-up passkeys.
    const flags = authenticator_data[32];
    assert(flags == 5 || flags == 13 || flags == 29, "WebAuthn flags require UP and UV");
    // signCount is signed but deliberately not an anti-replay counter: synced
    // passkeys may return zero. Device/grant nonces carry transaction freshness.
    const digest = persistentHash<[Bytes<37>, Bytes<32>]>([
      authenticator_data, webauthn_client_data_hash(challenge, policy.origin)
    ]);
    return p256_verify_digest(digest, sig, pk);
  }
}
