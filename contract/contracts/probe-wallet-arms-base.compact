  tag: Bytes<32>, self_addr: ContractAddress, x: Bytes<32>, y: Bytes<32>, envelope: Uint<8>,
  epoch: Uint<32>, counter: Uint<64>
): [] {
  derived = disclose(derive_descriptor_entry_w65(tag, self_addr, x, y, envelope, epoch, counter));
}

