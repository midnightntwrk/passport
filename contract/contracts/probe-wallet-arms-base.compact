// The ed25519 class: a Solana key by its point, with its encoding and
// x-coordinate as checked inputs. probe_encode_ed25519 measures the encoding
// alone; the derivations add the A != O assert and return [key, value] (the
// probes write the value).
export circuit probe_encode_ed25519(pk: Curve25519Point, pk_bytes: Vector<32, Uint<8>>, pk_x: Vector<32, Uint<8>>): [] {
  derived = disclose(encode_public_key_ed25519(pk, pk_bytes, pk_x));
}

export circuit probe_entry_ed25519(
  tag: Bytes<32>, self_addr: ContractAddress, pk: Curve25519Point, pk_bytes: Vector<32, Uint<8>>,
  pk_x: Vector<32, Uint<8>>, blind: Bytes<32>, epoch: Uint<32>, counter: Uint<64>
): [] {
  derived = disclose(derive_descriptor_entry_ed25519(tag, self_addr, pk, pk_bytes, pk_x, blind, epoch, counter)[1]);
}

export circuit probe_boot_ed25519(
  tag: Bytes<32>, salt: Bytes<32>, pk: Curve25519Point, pk_bytes: Vector<32, Uint<8>>,
  pk_x: Vector<32, Uint<8>>, blind: Bytes<32>
): [] {
  derived = disclose(derive_descriptor_boot_ed25519(tag, salt, pk, pk_bytes, pk_x, blind)[1]);
}

export circuit probe_grant_id_ed25519(
  tag: Bytes<32>, self_addr: ContractAddress, pk: Curve25519Point, pk_bytes: Vector<32, Uint<8>>,
  pk_x: Vector<32, Uint<8>>, blind: Bytes<32>, origin_hash: Bytes<32>, slot: Uint<8>
): [] {
  derived = disclose(derive_descriptor_grant_id_ed25519(tag, self_addr, pk, pk_bytes, pk_x, blind, origin_hash, slot)[1]);
}

export circuit probe_blind(tag: Bytes<32>, signature: Bytes<64>): [] {
  derived = disclose(derive_blind(tag, signature));
}

export circuit probe_grant_scope_salt(tag: Bytes<32>, blind: Bytes<32>, self_addr: ContractAddress, auth_nonce: Uint<64>): [] {
  derived = disclose(derive_grant_scope_salt(tag, blind, self_addr, auth_nonce));
}

