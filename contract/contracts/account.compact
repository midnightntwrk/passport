pragma language_version >= 0.17.0;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Midnight account custody contract — ECDSA-secp256k1 arm.
//
// This branch variant instantiates the MIP-0012 §4 authorisation seam with
// ECDSA over secp256k1 (the standard library's secp256k1EcdsaVerify circuit,
// ZKIR v3) in place of the JubJub Schnorr scheme of MIP-0013 that the main
// branch carries. It is an engineering stand-in for the planned secp256r1
// (P-256) passkey arm: secp256r1 verification has ZKIR v3 operations
// upstream (ledger 9.1.0.0-rc.4) but no Compact language surface yet, while
// secp256k1 verification shipped in Compact toolchain 0.33/0.34-rc and runs
// on the ledger the ledger-9 networks deploy today. The two curves share the
// short-Weierstrass ECDSA shape, so the later k1 → r1 swap is a
// type-and-constants substitution behind the same seam.
//
// This arm is NOT a MIP-0013 conforming scheme: MIP-0013 R2 selects JubJub
// and rejects secp256k1 ECDSA for account authorisation. MIP-0012 §4 keeps
// the seam credential-scheme-agnostic and requires conforming contracts to
// document which instantiating standard their seam implements: this
// contract implements the seam with an ECDSA arm pending the secp256r1
// standard (the unclaimed secp256r1 slot of docs/plans/MIPS.md). Everything
// below the seam — custody, inbox, mirror bookkeeping — is byte-identical
// to the main branch and remains MIP-0012 conforming.
//
// Scheme differences from the JubJub Schnorr trunk:
//
//   - pk is a Secp256k1Point; the signature is the standard library's
//     Secp256k1EcdsaSignature struct {r, s}; verification is
//     secp256k1EcdsaVerify(challenge, sig, pk), which interprets the
//     32-byte challenge as a big-endian integer and reduces it mod the
//     curve order internally.
//
//   - No grinding nonce. The JubJub arm ground each challenge below the
//     JubJub subgroup order so the in-circuit `as Field` cast succeeded
//     (MIP-0013 §5.2); ECDSA consumes the digest natively, so grind_nonce
//     disappears from every gated circuit's argument list and every
//     challenge preimage.
//
//   - The challenge no longer binds a signature commitment. Schnorr's
//     challenge binds R by construction; an ECDSA message must not depend
//     on its own signature, so the sig_r term leaves the preimage. The
//     preimage is [DST_CIRCUIT, self, pk, ...args, ...witness_values,
//     auth_nonce], with pk encoded as coordinate bytes (below).
//
//   - Domain separation: every tag carries the arm marker
//     ("midnight:account:device:k1:v1", "midnight:account:auth:k1:v1:…"),
//     so no entry or challenge of this arm can collide with the JubJub
//     arm's, and a future r1 arm takes fresh ":r1:" tags.
//
//   - Key encoding: device entries, the boot commitment, and challenges
//     bind the key as the two little-endian 32-byte encodings of the
//     affine coordinates (secp256k1PointX/Y cast to Bytes<32>) — an
//     explicit byte encoding independent signers reproduce without the
//     compiler's field-aligned point layout.
//
//   - Malleability: secp256k1EcdsaVerify accepts both low-S and high-S
//     forms, and (r, s) and (r, n − s) verify identically. Both forms
//     authorise the same challenge, whose device entry is consumed on
//     execution (AUTH-9) and whose auth_nonce advances, so a malleated
//     twin cannot replay, and signatures are never used as identifiers.
//     No low-S constraint is imposed — deliberately, because real P-256
//     authenticators emit high-S signatures and the r1 passkey arm must
//     accept them.
//
// Everything else — DST derivation via persistentHash of the zero-padded
// ASCII tag (midnight-improvement-proposals#249), the rolling single-use
// device entry (AUTH-9), witness-value binding (AUTH-10), the dedicated
// auth_nonce (AUTH-8), the boot-commitment bootstrap
// (midnight-improvement-proposals#250), and the custody semantics of
// MIP-0012 — is carried over from the main branch unchanged.
//
// Toolchain: requires the ZKIR v3 backend (compile with --feature-zkir-v3,
// Compact toolchain 0.33.0-rc or later; the secp256k1 surface lives in the
// compiler's zkir-v3-library.compact and is loaded only when the v3 IR is
// enabled) and a ledger-9 network with a ZKIR-3.0-capable proof server.
// ---------------------------------------------------------------------------

// ── Witness (MIP-0012 §6.3): the wallet-local coin store ────────────────────
//
// Supplies the qualified description of a held shielded coin at spend time.
// The description never exists in public ledger state; it enters the proof
// as private input.

witness held_coin(color: Bytes<32>): QualifiedShieldedCoinInfo;

// ── Public ledger state ─────────────────────────────────────────────────────

// MIP-0012 §3.

export ledger round: Uint<64>;
// Strictly increased by every state-changing circuit (INV-7).

export ledger enc_key: Bytes<32>;
// The account encryption public key (X25519). Depositors encrypt coin
// descriptions to this key. Set at deploy; rotated only via rotate_enc_key.

export ledger inbox: Map<Uint<64>, Bytes<192>>;
export ledger inbox_count: Uint<64>;
// Append-only encrypted coin descriptions (InboxEntry v1, MIP-0012 §6.4),
// keyed by ordinal. Discovery and recovery channel (INV-4).

export ledger unshielded_balances: Map<Bytes<32>, Uint<128>>;
// Explicit mirror of the contract's unshielded holdings per color; a lower
// bound on holdings (MIP-0012 §5, INV-8). Night is the all-zero color.

export ledger spec_version: Uint<32>;
// MIP-0012 §8: feature gate for clients.

// MIP-0013 §3 state shape, instantiated by this arm's scheme.

export ledger devices: Set<Bytes<32>>;
// Single-use device entries (MIP-0013 §3). Every gated call consumes the
// acting device's current entry and inserts its successor (AUTH-9).

export ledger device_epoch: Uint<32>;
// Bumped only by the future recovery seam (MIP-0013 §8). Entries hashed
// under an older epoch can never match an in-circuit recomputation, so
// they are inert (AUTH-6).

export ledger device_count: Uint<8>;
// Devices active in the current epoch. Guards the last-device rule (AUTH-5).

export ledger auth_nonce: Uint<64>;
// Bumped by every seam-gated call, and only by seam-gated calls (AUTH-2,
// AUTH-8). Every challenge covers it; a signature authorises at most one
// executed call.

export ledger boot: Bytes<32>;
export ledger booted: Boolean;
// Deploy-time bootstrap (MIP-0013 §3 as amended by
// midnight-improvement-proposals#250). The initial device's address-bound
// entry cannot be computed at deploy time in principle: the contract
// address is derived from the deploy transaction's content, so no
// deploy-time code can know it, and kernel.self() evaluates to the ZERO
// address inside a constructor. The constructor therefore stores a salted
// boot commitment H(DST_BOOT, salt, pk); the permissionless
// activate_initial_device circuit recomputes it, inserts the real entry at
// use counter 0, and burns the commitment. Only the committed key can
// activate (no race); the salt is fresh per account, so pre-activation
// state carries no cross-account-stable device value.

// ── Constructor ─────────────────────────────────────────────────────────────
//
// MIP-0013 §3 semantics via the boot commitment (see the `boot` cell): the
// deploying client computes boot = derive_boot_commitment(salt, pk) and
// calls activate_initial_device(pk, salt) immediately after deploy to
// insert the initial entry at epoch 0 and use counter 0.

constructor(initial_device_boot: Bytes<32>, encryption_key: Bytes<32>) {
  round        = 0 as Uint<64>;
  enc_key      = disclose(encryption_key);
  inbox_count  = 0 as Uint<64>;
  spec_version = 1 as Uint<32>;
  boot         = disclose(initial_device_boot);
  booted       = false;
  device_epoch = 0 as Uint<32>;
  device_count = 0 as Uint<8>;
  auth_nonce   = 0 as Uint<64>;
}

// Deterministic bootstrap: only the committed public key can activate, so
// the permissionless circuit cannot be front-run to register a foreign
// key. Increments round like the other permissionless circuits; does not
// touch auth_nonce (AUTH-8).
export circuit activate_initial_device(pk: Secp256k1Point, salt: Bytes<32>): [] {
  assert(!booted, "already activated");
  assert(derive_boot_commitment(salt, pk) == boot, "boot commitment mismatch");
  devices.insert(disclose(derive_device_entry(
    kernel.self(), pk, device_epoch, 0 as Uint<64>
  )));
  device_count = 1 as Uint<8>;
  booted       = true;
  boot         = pad(32, "");
  bump_round();
}

// Boot commitment: DST_BOOT = "midnight:account:boot:k1:v1" zero-padded to
// 32 bytes (arm-marked; to be registered under the MPS-0027 registry). The
// key is bound as its little-endian affine coordinate bytes, the same
// encoding the device entries use.
export pure circuit derive_boot_commitment(salt: Bytes<32>, pk: Secp256k1Point): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>(
    [pad(32, "midnight:account:boot:k1:v1"), salt,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>]
  );
}

// ── Entries and challenge constructions ─────────────────────────────────────
//
// All domain-separation tags below are arm-marked (":k1:") and are to be
// registered under the MPS-0027 registry once it ratifies.

// Rolling device entry (MIP-0013 §3): the account address makes entries
// for one key unequal across accounts; the epoch makes revocation total
// without enumerating the set; the use counter makes every entry
// single-use (AUTH-9). DST_DEVICE = "midnight:account:device:k1:v1"
// zero-padded to 32 bytes. The key is bound as the little-endian 32-byte
// encodings of its affine coordinates.
export pure circuit derive_device_entry(
  self_addr: ContractAddress,
  pk:        Secp256k1Point,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Uint<32>, Uint<64>]>(
    [pad(32, "midnight:account:device:k1:v1"), self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     epoch, counter]
  );
}

// Scalar-to-point helper: pk = sk·G. Exposed so signers can use the
// contract's own curve arithmetic (generator included) instead of a
// foreign secp256k1 library.
export pure circuit compute_public_point(scalar: Secp256k1Scalar): Secp256k1Point {
  return ecMulGenerator(scalar);
}

// Per-circuit challenges. Preimage:
//   [DST_CIRCUIT, self, pk_x, pk_y, ...args, ...witness_values, auth_nonce]
// The gated circuit passes kernel.self(), the values its witness
// invocations actually returned (AUTH-10), and its live auth_nonce; the
// signer passes the deployed address, the witness values the call will
// execute against (which the client pipeline MUST hand to the approver),
// and the observed auth_nonce. There is no signature term (an ECDSA
// message must not depend on its own signature) and no grinding nonce
// (secp256k1EcdsaVerify reduces the 32-byte challenge mod n natively).

export pure circuit challenge_withdraw_unshielded(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<128>, UserAddress, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     color, amount, recipient, nonce_value]
  );
}

// The two witness-consuming circuits bind the held_coin return value into
// the challenge (AUTH-10): the approver signs over the exact qualified
// coin the spend will consume, so a proving environment cannot substitute
// a different coin under a valid signature.
export pure circuit challenge_withdraw_shielded(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  coin:        QualifiedShieldedCoinInfo,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, ZswapCoinPublicKey, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     recipient, color, amount, coin, nonce_value]
  );
}

export pure circuit challenge_withdraw_shielded_to_contract(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  coin:        QualifiedShieldedCoinInfo,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_shielded_to_contract")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, ContractAddress, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     recipient, color, amount, coin, nonce_value]
  );
}

export pure circuit challenge_append_inbox(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  entry:       Bytes<192>,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:append_inbox")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<192>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     entry, nonce_value]
  );
}

export pure circuit challenge_rotate_enc_key(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  new_key:     Bytes<32>,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:rotate_enc_key")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     new_key, nonce_value]
  );
}

export pure circuit challenge_add_device(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  new_pk:      Secp256k1Point,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:add_device")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     secp256k1PointX(new_pk) as Bytes<32>, secp256k1PointY(new_pk) as Bytes<32>,
     nonce_value]
  );
}

export pure circuit challenge_remove_device(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  entry:       Bytes<32>,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:remove_device")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     entry, nonce_value]
  );
}

// ── The authorisation seam (MIP-0012 §4, ECDSA-secp256k1 instantiation) ─────
//
// One internal seam gates every asset-releasing and state-changing circuit
// other than deposits (INV-1). Replacing the credential scheme touches this
// circuit and the challenge constructions only. Order: consume the device
// entry (and insert its successor), challenge (computed by the caller),
// verification, freshness.
//
// The entry consumed and the successor inserted are disclosed by the ledger
// operations themselves; both are single-use values (AUTH-9). The signature
// material (pk, sig) is witness data of the proof and appears in no public
// output. An unregistered key, a stale epoch, and a wrong use counter all
// fail the membership assert identically.

circuit require_authorised(
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  challenge:   Bytes<32>,
): [] {
  const entry = disclose(derive_device_entry(kernel.self(), pk, device_epoch, use_counter));
  assert(devices.member(entry), "unknown device entry");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry(
    kernel.self(), pk, device_epoch, ((use_counter + (1 as Uint<64>)) as Uint<64>)
  )));
  // The verify interprets the challenge as a big-endian integer and reduces
  // it mod the curve order internally; both low-S and high-S signature
  // forms are accepted (see the malleability note in the header).
  assert(
    secp256k1EcdsaVerify(challenge, sig, pk),
    "invalid signature"
  );
  auth_nonce = ((auth_nonce + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

circuit bump_round(): [] {
  round = ((round + (1 as Uint<64>)) as Uint<64>);
}

// Unshielded mirror bookkeeping (MIP-0012 §5).

circuit credit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  if (unshielded_balances.member(color)) {
    unshielded_balances.insert(
      color,
      ((unshielded_balances.lookup(color) + amount) as Uint<128>)
    );
  } else {
    unshielded_balances.insert(color, amount);
  }
}

circuit debit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  assert(unshielded_balances.member(color), "no balance for color");
  const bal = unshielded_balances.lookup(color);
  assert(bal >= amount, "insufficient balance");
  unshielded_balances.insert(color, ((bal - amount) as Uint<128>));
}

// ── Unshielded custody (MIP-0012 §5) ────────────────────────────────────────

// Permissionless: anyone may fund the account. Increments round (§4).
export circuit deposit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  const c = disclose(color);
  const a = disclose(amount);
  receiveUnshielded(c, a);
  credit_unshielded(c, a);
  bump_round();
}

// Authorised: checks and debits the mirror, then sends to a user address.
export circuit withdraw_unshielded(
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const challenge = challenge_withdraw_unshielded(
    kernel.self(), pk, color, amount, recipient, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  const c = disclose(color);
  const a = disclose(amount);
  debit_unshielded(c, a);
  sendUnshielded(c, a, right<ContractAddress, UserAddress>(disclose(recipient)));
}

// ── Shielded custody, stateless (MIP-0012 §6) ───────────────────────────────

// Permissionless deposit (§6.2): claims the coin for the contract and
// appends the depositor-encrypted InboxEntry. The contract cannot verify
// the correspondence between coin and entry (S3); honest clients detect
// mismatches at discovery by recomputing the commitment against chain data.
export circuit deposit_shielded(coin: ShieldedCoinInfo, entry: Bytes<192>): [] {
  receiveShielded(disclose(coin));
  inbox.insert(inbox_count, disclose(entry));
  inbox_count = ((inbox_count + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

// Inbox append without a coin claim (§6.2): change-coin backfill. Gated
// behind the seam per the MAY of §6.2 (S9 spam defence) — backfill is
// always performed by the owner's own client, so gating loses nothing.
export circuit append_inbox(
  entry:       Bytes<192>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const challenge = challenge_append_inbox(
    kernel.self(), pk, entry, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  inbox.insert(inbox_count, disclose(entry));
  inbox_count = ((inbox_count + (1 as Uint<64>)) as Uint<64>);
}

// Authorised spend to a user's Zswap key (§6.3). The coin description
// enters through the held_coin witness, never from ledger state.
//
// Change rule (§6.3, normative): sendShielded already routes change back
// to the contract as a live, self-owned output — the baseline realisation
// persists result.change directly, with no re-owning step. The surviving
// change description is returned to the caller through the transaction's
// communication commitment (not public); the client re-captures its
// mt_index and backfills the inbox via append_inbox (INV-4).
export circuit withdraw_shielded(
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): Maybe<ShieldedCoinInfo> {
  // The witness is invoked first so its returned value enters the
  // challenge (AUTH-10): the signature authorises spending exactly this
  // qualified coin, not any coin of this color.
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded(
    kernel.self(), pk, recipient, color, amount, coin, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  const result = sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount),
  );
  if (disclose(result.change.is_some)) {
    return some<ShieldedCoinInfo>(disclose(result.change.value));
  }
  return none<ShieldedCoinInfo>();
}

// Authorised contract-recipient spend — the direct-transfer mode of §6.6
// (linking accepted). The output MUST be claimed by the receiving
// contract's deposit path in the same client-composed transaction; a
// contract-addressed output carries that address in cleartext, so a direct
// payment publishes the pair of accounts. Conforming clients MUST default
// to one-hop routing and produce this only by deliberate per-payment
// choice. Onward change handling is identical to the baseline circuit's.
//
// Returns [sent, change]: the composing client passes `sent` (the stdlib
// SendResult.sent coin — its nonce is the deterministic evolution of the
// input coin's) to the receiving contract's deposit_shielded claim, and
// persists `change` per the surviving-coin rule. Both travel privately in
// the communication commitment.
export circuit withdraw_shielded_to_contract(
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_to_contract(
    kernel.self(), pk, recipient, color, amount, coin, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  const result = sendShielded(
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount),
  );
  if (disclose(result.change.is_some)) {
    return [disclose(result.sent), some<ShieldedCoinInfo>(disclose(result.change.value))];
  }
  return [disclose(result.sent), none<ShieldedCoinInfo>()];
}

// ── Encryption-key lifecycle (MIP-0012 §6.7) ────────────────────────────────
//
// Exactly one way to change enc_key. After rotation the client SHOULD
// re-encrypt held-coin descriptions into fresh inbox entries under the new
// key so the inbox walk succeeds with the new secret alone.

export circuit rotate_enc_key(
  new_key:     Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const challenge = challenge_rotate_enc_key(
    kernel.self(), pk, new_key, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  enc_key = disclose(new_key);
}

// ── Device lifecycle ────────────────────────────────────────────────────────
//
// Any active device is sufficient to authorise (1-of-n at the contract
// surface). The JubJub trunk points threshold policies at a FROST
// committee's joint key behind a single entry; ECDSA thresholdisation is
// deliberately out of scope for this arm (it is one of MIP-0013 R2's
// grounds for rejecting ECDSA as the standard scheme) — the arm exists to
// validate the seam and the verifier shape, not a threshold story.

// Inserts the new key's entry at the current epoch and use counter 0.
// The contract cannot detect re-registration of an active key whose chain
// has advanced past counter 0; clients MUST track the device roster and
// MUST NOT re-add an active key (S11).
export circuit add_device(
  new_pk:      Secp256k1Point,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const challenge = challenge_add_device(
    kernel.self(), pk, new_pk, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  const new_entry = disclose(derive_device_entry(
    kernel.self(), new_pk, device_epoch, 0 as Uint<64>
  ));
  assert(!devices.member(new_entry), "device entry already present");
  devices.insert(new_entry);
  device_count = ((device_count + (1 as Uint<8>)) as Uint<8>);
}

// Removes a device's CURRENT entry, supplied as the literal set element:
// removing a lost device requires its public key and current use counter,
// recovered from the client roster or the S11 rescan.
export circuit remove_device(
  entry:       Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
): [] {
  const challenge = challenge_remove_device(
    kernel.self(), pk, entry, auth_nonce
  );
  require_authorised(pk, use_counter, sig, challenge);
  const e = disclose(entry);
  assert(device_count > (1 as Uint<8>), "cannot remove last device");
  assert(devices.member(e), "unknown device entry");
  devices.remove(e);
  device_count = ((device_count - (1 as Uint<8>)) as Uint<8>);
}
