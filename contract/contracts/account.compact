pragma language_version >= 0.17.0;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Midnight account custody contract — reference implementation.
//
// Implements, together, the two building blocks of the MPS-0018 keystone:
//
//   MIP-0012 (Contract Custody of Midnight-Native Assets)
//     - unshielded custody with an explicit per-color balance mirror (§5);
//     - stateless shielded custody: no held coin's description (nonce,
//       color, value) ever enters public ledger state (§6.1); deposits pair
//       the protocol coin claim with an encrypted inbox entry (§6.2); spends
//       take the coin from the `held_coin` witness (§6.3); change follows
//       the surviving-coin rule (§6.3, R4);
//     - the InboxEntry v1 container is 192 opaque bytes (§6.4) — all entry
//       cryptography is client-side, the contract never inspects entries;
//     - the direct-transfer mode (§6.6): an optional contract-recipient
//       spend circuit, claimed by the receiving contract's deposit path in
//       the same client-composed transaction;
//     - encryption-key lifecycle: exactly one authorised rotation path
//       (§6.7).
//
//   MIP-0013 (Multi-key Account Authorisation for Custody Contracts)
//     - every asset-releasing circuit is gated by an in-circuit signature
//       verification against a rolling single-use device entry (AUTH-9);
//     - the challenge binds the per-circuit domain-separation tag, the
//       account address, the signing key, the full argument list, the
//       ORDERED VALUES RETURNED BY EVERY WITNESS INVOCATION (AUTH-10), and
//       the authorisation counter (§5.1);
//     - a dedicated `auth_nonce` advanced only by gated calls (R4), so
//       permissionless deposits cannot invalidate a pending authorisation
//       (AUTH-8);
//     - device lifecycle: add_device inserts a new entry at use counter 0;
//       remove_device consumes a literal set element, with the last-device
//       rule (AUTH-5); the epoch mechanism (AUTH-6) is present in state,
//       and its only bump site is the recovery seam of MIP-0013 §8, which
//       awaits the recovery-paths MIP — no recovery circuit is exposed
//       here yet.
//
// ── Authorisation arms ──────────────────────────────────────────────────────
//
// The MIP-0012 §4 seam is credential-scheme-agnostic. This contract carries
// it as CO-RESIDENT ARMS: every gated operation is exported once per
// registered scheme, as `<operation>_with_<arm>`. Each arm's entry circuit
// computes its own challenge, passes its own seam chip (device-entry roll +
// in-circuit verification), and then calls the SAME internal custody chip —
// the custody semantics exist exactly once, below every arm.
//
//   arm `jubjub` — Schnorr over JubJub, the normative MIP-0013 scheme.
//     Verification is s·G == R + c·pk. The challenge additionally binds the
//     signature commitment R and a grinding nonce: signers grind until the
//     hash's little-endian value falls below the JubJub subgroup order
//     (MIP-0013 §5.2) so the in-circuit scalar cast is canonical.
//     DST families: "midnight:account:device:v1",
//     "midnight:account:auth:v1:*", "midnight:account:boot:v1".
//
//   arm `k256` — ECDSA over secp256k1, an interim engineering arm. NOT a
//     MIP-0013 conforming scheme (MIP-0013 R2 selects JubJub and rejects
//     secp256k1 ECDSA); it stands in for the planned secp256r1 (P-256)
//     passkey arm until that curve has a Compact language surface, the two
//     curves sharing the short-Weierstrass ECDSA shape. The challenge binds
//     no signature term (an ECDSA message must not depend on its own
//     signature) and no grinding nonce (secp256k1EcdsaVerify reduces the
//     32-byte challenge mod the curve order natively). Keys are bound as
//     the little-endian 32-byte encodings of the affine coordinates.
//     Malleability: (r, s) and (r, n − s) verify identically; both forms
//     authorise the same challenge, whose device entry is consumed on
//     execution (AUTH-9) and whose auth_nonce advances, so a malleated twin
//     cannot replay, and signatures are never used as identifiers. No low-S
//     constraint is imposed — deliberately, because real P-256
//     authenticators emit high-S signatures and the r1 arm must accept
//     them. DST families: "midnight:account:device:k1:v1",
//     "midnight:account:auth:k1:v1:*", "midnight:account:boot:k1:v1".
//
// Per-arm circuits instead of one circuit with an in-circuit scheme choice:
// Compact compiles every exported circuit to its own proof, so a proof
// through a `_with_jubjub` circuit pays only the Schnorr constraints and a
// proof through `_with_k256` only the ECDSA constraints. A single circuit
// selecting the scheme by conditional would make every authorisation pay
// for every registered scheme. Later arms (`_with_p256` when secp256r1
// becomes expressible, possibly `_with_ed25519`) are added the same way:
// one seam chip, one challenge family, one thin export per operation — the
// custody chips do not change.
//
// The arms share ONE device set: the arm marker inside each entry's
// domain-separation tag keeps the arms' entries disjoint, and each seam
// chip can only match entries of its own arm. `device_count` and the
// last-device rule (AUTH-5) span the arms: the invariant is that the
// account retains at least one usable device of ANY arm. Cross-arm
// enrolment is first-class: add_device binds the NEW device as its derived
// ENTRY (a Bytes<32>, computed client-side with the new device's arm's
// exported derivation circuit), so a JubJub device authorises the
// enrolment of a k256 device and vice versa — this is the migration path
// between arms. The contract cannot inspect an entry argument's epoch or
// counter; clients MUST derive enrolment entries with the CURRENT
// device_epoch and use counter 0 (a stale-epoch entry is inert but still
// counts toward device_count until removed — see S11).
//
// DST construction (§5.1 as amended by midnight-improvement-proposals#249):
//   every per-circuit DST is derived unconditionally as
//   persistentHash<[Bytes<64>]> of the ASCII tag zero-padded to 64 bytes,
//   regardless of the tag's length. The original "zero-padded or hashed to
//   32 bytes" wording specified neither the arm selection nor the hash
//   construction; #249 codifies the derivation used here.
//
// Exported pure circuits mirror every challenge construction so that
// signers (TypeScript, Rust, HSM profiles) can reproduce the exact
// field-aligned encoding through the contract's own toolchain; independent
// implementations reproduce persistentHash bit-exactly instead (MIP-0013
// §2).
//
// Toolchain: requires the ZKIR v3 backend (compile with --feature-zkir-v3,
// Compact toolchain 0.33.0-rc or later; the secp256k1 surface lives in the
// compiler's zkir-v3-library.compact and is loaded only when the v3 IR is
// enabled) and a ledger-9 network with a ZKIR-3.0-capable proof server.
// ---------------------------------------------------------------------------

// ── Witness (MIP-0012 §6.3): the wallet-local coin store ────────────────────
//
// Supplies the qualified description of a held shielded coin at spend time.
// The description never exists in public ledger state; it enters the proof
// as private input.

witness held_coin(color: Bytes<32>): QualifiedShieldedCoinInfo;

// ── Public ledger state ─────────────────────────────────────────────────────

// MIP-0012 §3.

export ledger round: Uint<64>;
// Strictly increased by every state-changing circuit (INV-7).

export ledger enc_key: Bytes<32>;
// The account encryption public key (X25519). Depositors encrypt coin
// descriptions to this key. Set at deploy; rotated only via rotate_enc_key.

export ledger inbox: Map<Uint<64>, Bytes<192>>;
export ledger inbox_count: Uint<64>;
// Append-only encrypted coin descriptions (InboxEntry v1, MIP-0012 §6.4),
// keyed by ordinal. Discovery and recovery channel (INV-4).

export ledger unshielded_balances: Map<Bytes<32>, Uint<128>>;
// Explicit mirror of the contract's unshielded holdings per color; a lower
// bound on holdings (MIP-0012 §5, INV-8). Night is the all-zero color.

export ledger spec_version: Uint<32>;
// MIP-0012 §8: feature gate for clients.

// MIP-0013 §3.

export ledger devices: Set<Bytes<32>>;
// Single-use device entries (MIP-0013 §3), of every arm: the arm marker in
// each entry's DST keeps the arms disjoint. Every gated call consumes the
// acting device's current entry and inserts its successor (AUTH-9).

export ledger device_epoch: Uint<32>;
// Bumped only by the future recovery seam (MIP-0013 §8). Entries hashed
// under an older epoch can never match an in-circuit recomputation, so
// they are inert (AUTH-6).

export ledger device_count: Uint<8>;
// Devices active in the current epoch, across all arms. Guards the
// last-device rule (AUTH-5).

export ledger auth_nonce: Uint<64>;
// Bumped by every seam-gated call, and only by seam-gated calls (AUTH-2,
// AUTH-8). Every challenge covers it; a signature authorises at most one
// executed call.

export ledger boot: Bytes<32>;
export ledger booted: Boolean;
// Deploy-time bootstrap (MIP-0013 §3 as amended by
// midnight-improvement-proposals#250). The initial device's address-bound
// entry cannot be computed at deploy time in principle: the contract
// address is derived from the deploy transaction's content, so no
// deploy-time code can know it, and kernel.self() evaluates to the ZERO
// address inside a constructor. The constructor therefore stores a salted
// boot commitment H(DST_BOOT, salt, pk); the permissionless
// activate_initial_device circuit of the committed key's arm recomputes
// it, inserts the real entry at use counter 0, and burns the commitment.
// The arm marker in DST_BOOT selects which arm's activation circuit can
// match. Only the committed key can activate (no race); the salt is fresh
// per account, so pre-activation state carries no cross-account-stable
// device value.

// ── Constructor ─────────────────────────────────────────────────────────────
//
// MIP-0013 §3 semantics via the boot commitment (see the `boot` cell): the
// deploying client computes boot = derive_boot_commitment_with_<arm>(salt,
// pk) for the initial device's arm and calls the matching
// activate_initial_device_with_<arm>(pk, salt) immediately after deploy to
// insert the initial entry at epoch 0 and use counter 0.

constructor(initial_device_boot: Bytes<32>, encryption_key: Bytes<32>) {
  round        = 0 as Uint<64>;
  enc_key      = disclose(encryption_key);
  inbox_count  = 0 as Uint<64>;
  spec_version = 1 as Uint<32>;
  boot         = disclose(initial_device_boot);
  booted       = false;
  device_epoch = 0 as Uint<32>;
  device_count = 0 as Uint<8>;
  auth_nonce   = 0 as Uint<64>;
}

// ── Bootstrap (per arm) ─────────────────────────────────────────────────────
//
// Deterministic bootstrap: only the committed public key can activate, so
// the permissionless circuit cannot be front-run to register a foreign
// key. Increments round like the other permissionless circuits; does not
// touch auth_nonce (AUTH-8).

// Shared tail of both activation circuits. The caller has already checked
// the boot commitment for its arm.
circuit do_activate_initial_device(entry: Bytes<32>): [] {
  devices.insert(disclose(entry));
  device_count = 1 as Uint<8>;
  booted       = true;
  boot         = pad(32, "");
  bump_round();
}

export circuit activate_initial_device_with_jubjub(pk: JubjubPoint, salt: Bytes<32>): [] {
  assert(!booted, "already activated");
  assert(derive_boot_commitment_with_jubjub(salt, pk) == boot, "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_jubjub(
    kernel.self(), pk, device_epoch, 0 as Uint<64>
  ));
}

export circuit activate_initial_device_with_k256(pk: Secp256k1Point, salt: Bytes<32>): [] {
  assert(!booted, "already activated");
  assert(derive_boot_commitment_with_k256(salt, pk) == boot, "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_k256(
    kernel.self(), pk, device_epoch, 0 as Uint<64>
  ));
}

// Boot commitments (arm-marked DST_BOOT, zero-padded to 32 bytes; to be
// registered under the MPS-0027 registry).

// Arm jubjub: DST_BOOT = "midnight:account:boot:v1".
export pure circuit derive_boot_commitment_with_jubjub(salt: Bytes<32>, pk: JubjubPoint): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, JubjubPoint]>(
    [pad(32, "midnight:account:boot:v1"), salt, pk]
  );
}

// Arm k256: DST_BOOT = "midnight:account:boot:k1:v1". The key is bound as
// its little-endian affine coordinate bytes, the same encoding the arm's
// device entries use.
export pure circuit derive_boot_commitment_with_k256(salt: Bytes<32>, pk: Secp256k1Point): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>(
    [pad(32, "midnight:account:boot:k1:v1"), salt,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>]
  );
}

// ── Device entries (MIP-0013 §3, per arm) ───────────────────────────────────
//
// Rolling device entry: the account address makes entries for one key
// unequal across accounts; the epoch makes revocation total without
// enumerating the set; the use counter makes every entry single-use
// (AUTH-9); the arm marker in the DST keeps the arms' entries disjoint.
// All domain-separation tags below are to be registered under the MPS-0027
// registry once it ratifies (MIP-0012 S6, MIP-0013 Path to Active).

// Arm jubjub: DST_DEVICE = "midnight:account:device:v1" zero-padded to
// 32 bytes.
export pure circuit derive_device_entry_with_jubjub(
  self_addr: ContractAddress,
  pk:        JubjubPoint,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, Uint<32>, Uint<64>]>(
    [pad(32, "midnight:account:device:v1"), self_addr, pk, epoch, counter]
  );
}

// Arm k256: DST_DEVICE = "midnight:account:device:k1:v1" zero-padded to
// 32 bytes. The key is bound as the little-endian 32-byte encodings of its
// affine coordinates — an explicit byte encoding independent signers
// reproduce without the compiler's field-aligned point layout.
export pure circuit derive_device_entry_with_k256(
  self_addr: ContractAddress,
  pk:        Secp256k1Point,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Uint<32>, Uint<64>]>(
    [pad(32, "midnight:account:device:k1:v1"), self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     epoch, counter]
  );
}

// Scalar-to-point helpers: R = r·G, pk = sk·G. Exposed so signers use the
// contract's own curve arithmetic (generator included) instead of a
// foreign curve library.

export pure circuit compute_public_point_with_jubjub(scalar: Field): JubjubPoint {
  return ecMulGenerator(scalar as JubjubScalar);
}

export pure circuit compute_public_point_with_k256(scalar: Secp256k1Scalar): Secp256k1Point {
  return ecMulGenerator(scalar);
}

// ── Challenge constructions, arm jubjub (MIP-0013 §5) ───────────────────────
//
// Preimage (§5.1):
//   [DST_CIRCUIT, self, sig_r, pk, ...args, ...witness_values,
//    auth_nonce, grind_nonce]
// The gated circuit passes kernel.self(), the values its witness
// invocations actually returned (AUTH-10), and its live auth_nonce; the
// signer passes the deployed address, the witness values the call will
// execute against (which the client pipeline MUST hand to the approver,
// §5.3), and the observed auth_nonce. The signer grinds grind_nonce until
// the hash, read little-endian, is strictly below the JubJub subgroup
// order r_J (§5.2).

export pure circuit challenge_withdraw_unshielded_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<32>, Uint<128>, UserAddress, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, color, amount, recipient, nonce_value, grind_nonce]
  );
}

// The two witness-consuming circuits bind the held_coin return value into
// the challenge (AUTH-10): the approver signs over the exact qualified
// coin the spend will consume, so a proving environment cannot substitute
// a different coin under a valid signature.
export pure circuit challenge_withdraw_shielded_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  coin:        QualifiedShieldedCoinInfo,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:withdraw_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, ZswapCoinPublicKey, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, recipient, color, amount, coin, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_withdraw_shielded_to_contract_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  coin:        QualifiedShieldedCoinInfo,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:withdraw_shielded_to_contract")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, ContractAddress, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, recipient, color, amount, coin, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_append_inbox_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  entry:       Bytes<192>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:append_inbox")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<192>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, entry, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_rotate_enc_key_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  new_key:     Bytes<32>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:rotate_enc_key")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<32>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, new_key, nonce_value, grind_nonce]
  );
}

// add_device binds the NEW device as its derived entry (see the device
// lifecycle section): the entry is a collision-resistant commitment to the
// new key AND its arm, so the approval covers both, and enrolment across
// arms needs no per-arm-pair circuit.
export pure circuit challenge_add_device_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  new_entry:   Bytes<32>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:add_device")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<32>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, new_entry, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_remove_device_with_jubjub(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  entry:       Bytes<32>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:remove_device")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<32>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, entry, nonce_value, grind_nonce]
  );
}

// ── Challenge constructions, arm k256 ───────────────────────────────────────
//
// Preimage:
//   [DST_CIRCUIT, self, pk_x, pk_y, ...args, ...witness_values, auth_nonce]
// Same binding discipline as the jubjub arm (AUTH-10, §5.3), with two
// scheme-driven differences: no signature term (an ECDSA message must not
// depend on its own signature) and no grinding nonce (secp256k1EcdsaVerify
// reduces the 32-byte challenge mod n natively).

export pure circuit challenge_withdraw_unshielded_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<128>, UserAddress, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     color, amount, recipient, nonce_value]
  );
}

export pure circuit challenge_withdraw_shielded_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  coin:        QualifiedShieldedCoinInfo,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, ZswapCoinPublicKey, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     recipient, color, amount, coin, nonce_value]
  );
}

export pure circuit challenge_withdraw_shielded_to_contract_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  coin:        QualifiedShieldedCoinInfo,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:withdraw_shielded_to_contract")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, ContractAddress, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     recipient, color, amount, coin, nonce_value]
  );
}

export pure circuit challenge_append_inbox_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  entry:       Bytes<192>,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:append_inbox")]
