pragma language_version 0.23;

import CompactStandardLibrary;

// ---------------------------------------------------------------------------
// Midnight account custody contract — reference implementation.
//
// Implements, together, the two building blocks of the MPS-0018 keystone:
//
//   MIP-0012 (Contract Custody of Midnight-Native Assets)
//     - unshielded custody with an explicit per-color balance mirror (§5);
//     - stateless shielded custody: no held coin's description (nonce,
//       color, value) ever enters public ledger state (§6.1); deposits pair
//       the protocol coin claim with an encrypted inbox entry (§6.2); spends
//       take the coin from the `held_coin` witness (§6.3); change follows
//       the surviving-coin rule (§6.3, R4);
//     - the InboxEntry v1 container is 192 opaque bytes (§6.4) — all entry
//       cryptography is client-side, the contract never inspects entries;
//     - the direct-transfer mode (§6.6): an optional contract-recipient
//       spend circuit, claimed by the receiving contract's deposit path in
//       the same client-composed transaction;
//     - encryption-key lifecycle: exactly one authorised rotation path
//       (§6.7).
//
//   MIP-0013 (Multi-key Account Authorisation for Custody Contracts)
//     - every asset-releasing circuit is gated by an in-circuit JubJub
//       Schnorr verification (§4): s·G == R + c·pk against a device key
//       active in the current epoch;
//     - the challenge c binds the per-circuit domain-separation tag, the
//       account address, R, pk, the full argument list, the authorisation
//       counter, and the grinding nonce (§5.1); signers grind until the
//       hash's little-endian value falls below the JubJub subgroup order
//       (§5.2) so the in-circuit `as Field` cast always succeeds;
//     - a dedicated `auth_nonce` advanced only by gated calls (R4), so
//       permissionless deposits cannot invalidate a pending authorisation
//       (AUTH-8);
//     - device lifecycle: add_device / remove_device with the last-device
//       rule (AUTH-5); the epoch mechanism (AUTH-6) is present in state,
//       and its only bump site is the recovery seam of MIP-0013 §8, which
//       awaits the recovery-paths MIP — no recovery circuit is exposed
//       here yet.
//
// Deviations from the MIP texts, to be folded back as errata:
//   - MIP-0013 §3 declares `devices: Map<Field, Uint<32>>` while defining
//     the commitment as a persistentHash output (Bytes<32>). A Bytes<32>
//     value cannot be safely cast to Field (no grinding on that path; the
//     range check would fail for roughly half of all keys), so this
//     implementation keys the device map by Bytes<32>.
//   - Every per-circuit tag "midnight:account:auth:v1:<circuit-name>"
//     exceeds 32 bytes, so this implementation uniformly takes the hashed
//     arm of §5.1's "zero-padded or hashed to 32 bytes":
//     DST = persistentHash of the tag string zero-padded to 64 bytes.
//
// Exported pure circuits mirror every challenge construction so that
// signers (TypeScript, Rust, HSM profiles) can reproduce the exact
// field-aligned encoding through the contract's own toolchain; independent
// implementations reproduce persistentHash bit-exactly instead (MIP-0013
// §2).
// ---------------------------------------------------------------------------

// ── Witness (MIP-0012 §6.3): the wallet-local coin store ────────────────────
//
// Supplies the qualified description of a held shielded coin at spend time.
// The description never exists in public ledger state; it enters the proof
// as private input.

witness held_coin(color: Bytes<32>): QualifiedShieldedCoinInfo;

// ── Public ledger state ─────────────────────────────────────────────────────

// MIP-0012 §3.

export ledger round: Uint<64>;
// Strictly increased by every state-changing circuit (INV-7).

export ledger enc_key: Bytes<32>;
// The account encryption public key (X25519). Depositors encrypt coin
// descriptions to this key. Set at deploy; rotated only via rotate_enc_key.

export ledger inbox: Map<Uint<64>, Bytes<192>>;
export ledger inbox_count: Uint<64>;
// Append-only encrypted coin descriptions (InboxEntry v1, MIP-0012 §6.4),
// keyed by ordinal. Discovery and recovery channel (INV-4).

export ledger unshielded_balances: Map<Bytes<32>, Uint<128>>;
// Explicit mirror of the contract's unshielded holdings per color; a lower
// bound on holdings (MIP-0012 §5, INV-8). Night is the all-zero color.

export ledger spec_version: Uint<32>;
// MIP-0012 §8: feature gate for clients.

// MIP-0013 §3.

export ledger devices: Map<Bytes<32>, Uint<32>>;
// device commitment -> epoch at registration. Keyed by Bytes<32> (see the
// erratum note in the header).

export ledger device_epoch: Uint<32>;
// Bumped only by the future recovery seam (MIP-0013 §8). Entries recorded
// under an older epoch are inert (AUTH-6).

export ledger device_count: Uint<8>;
// Devices active in the current epoch. Guards the last-device rule (AUTH-5).

export ledger auth_nonce: Uint<64>;
// Bumped by every seam-gated call, and only by seam-gated calls (AUTH-2,
// AUTH-8). Every challenge covers it; a signature authorises at most one
// executed call.

// ── Constructor ─────────────────────────────────────────────────────────────
//
// MIP-0013 §3: deployed with exactly one device commitment at epoch 0,
// device_count = 1, auth_nonce = 0. The initial device's public key is
// supplied whole; its commitment is computed in-circuit so client and
// contract cannot diverge on the derivation.

constructor(initial_device_pk: JubjubPoint, encryption_key: Bytes<32>) {
  round        = 0 as Uint<64>;
  enc_key      = disclose(encryption_key);
  inbox_count  = 0 as Uint<64>;
  spec_version = 1 as Uint<32>;
  devices.insert(disclose(derive_device_commitment(initial_device_pk)), 0 as Uint<32>);
  device_epoch = 0 as Uint<32>;
  device_count = 1 as Uint<8>;
  auth_nonce   = 0 as Uint<64>;
}

// ── Commitments and challenge constructions (MIP-0013 §3, §5) ───────────────
//
// All domain-separation tags below are to be registered under the MPS-0027
// registry once it ratifies (MIP-0012 S6, MIP-0013 Path to Active).

// Device commitment: persistentHash([DST_DEVICE, pk]) with
// DST_DEVICE = "midnight:account:device:v1" zero-padded to 32 bytes.
export pure circuit derive_device_commitment(pk: JubjubPoint): Bytes<32> {
  return persistentHash<[Bytes<32>, JubjubPoint]>(
    [pad(32, "midnight:account:device:v1"), pk]
  );
}

// Scalar-to-point helper: R = r·G, pk = sk·G. Exposed so signers use the
// contract's own curve arithmetic (generator included) instead of a
// foreign JubJub library.
export pure circuit compute_public_point(scalar: Field): JubjubPoint {
  return ecMulGenerator(scalar);
}

// Per-circuit challenges (MIP-0013 §5.1). Preimage:
//   [DST_CIRCUIT, self, sig_r, pk, ...args, auth_nonce, grind_nonce]
// The gated circuit passes kernel.self() and its live auth_nonce; the
// signer passes the deployed address and the observed auth_nonce. The
// signer grinds grind_nonce until the hash, read little-endian, is
// strictly below the JubJub subgroup order r_J (§5.2).

export pure circuit challenge_withdraw_unshielded(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<32>, Uint<128>, UserAddress, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, color, amount, recipient, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_withdraw_shielded(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:withdraw_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, ZswapCoinPublicKey, Bytes<32>, Uint<128>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, recipient, color, amount, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_withdraw_shielded_to_contract(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:withdraw_shielded_to_contract")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, ContractAddress, Bytes<32>, Uint<128>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, recipient, color, amount, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_append_inbox(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  entry:       Bytes<192>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:v1:append_inbox")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, JubjubPoint, Bytes<192>, Uint<64>, Uint<64>]>(
    [dst, self_addr, sig_r, pk, entry, nonce_value, grind_nonce]
  );
}

export pure circuit challenge_rotate_enc_key(
  self_addr:   ContractAddress,
  sig_r:       JubjubPoint,
  pk:          JubjubPoint,
  new_key:     Bytes<32>,
  nonce_value: Uint<64>,
  grind_nonce: Uint<64>,
