// ── The authorisation seam (MIP-0012 §4), one chip per arm ──────────────────
//
// One seam chip per arm gates every asset-releasing and state-changing
// circuit other than deposits (INV-1). Adding a credential scheme adds a
// seam chip and a challenge family; the custody chips below are untouched.
// Order per MIP-0013 §4: consume the device entry (and insert its
// successor), challenge (computed by the caller), verification, freshness.
//
// The entry consumed and the successor inserted are disclosed by the ledger
// operations themselves; both are single-use values (AUTH-9; MIP-0013 S4
// bounds the residual transcript chaining). The signature material is
// witness data of the proof and appears in no public output. An
// unregistered key, a key of the other arm, a stale epoch, and a wrong use
// counter all fail the membership assert identically.

circuit require_authorised_with_jubjub(
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  challenge:   Bytes<32>,
): [] {
  // The same weak-key break the k256 arm has, on the normative arm. The seam
  // asserts s·G == R + c·pk, so a pk of small order lets the key-dependent
  // term be predicted or erased: at the identity it vanishes outright and any
  // s with R = s·G passes with no private key. JubJub's identity is the
  // ordinary affine point (0, 1), not a flagged encoding, so nothing about the
  // type rules it out. Cofactor-clearing rejects it and the rest of the
  // 8-torsion in one check: [8]P == O exactly when P has small order.
  assert(ecMul(pk, 8 as JubjubScalar) != ecMulGenerator(0 as JubjubScalar),
         "device key has small order");
  const entry = disclose(derive_device_entry_with_jubjub(kernel.self(), pk, device_epoch, use_counter));
  assert(devices.member(entry), "unknown device entry");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry_with_jubjub(
    kernel.self(), pk, device_epoch, ((use_counter + (1 as Uint<64>)) as Uint<64>)
  )));
  // The signer ground the challenge below the JubJub subgroup order
  // (§5.2), so the scalar image of the cast chain is canonical and matches
  // the scalar the signer used.
  const c = challenge as Field;
  assert(
    ecMulGenerator(sig_s as JubjubScalar) == ecAdd(sig_r, ecMul(pk, c as JubjubScalar)),
    "invalid signature"
  );
  auth_nonce = ((auth_nonce + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

circuit require_authorised_with_k256(
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  challenge:   Bytes<32>,
  envelope:    Uint<8>,
): [] {
  require_live_k256_key(pk);
  const entry = disclose(derive_device_entry_with_k256(
    kernel.self(), pk, envelope, device_epoch, use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry_with_k256(
    kernel.self(), pk, envelope, device_epoch,
    ((use_counter + (1 as Uint<64>)) as Uint<64>)
  )));
  // The signature covers the envelope digest of the challenge, never the
  // challenge itself. The envelope cannot be equivocated per call: the
  // entry derivation above binds it, so a wrong id fails the membership
  // assert before any signature is examined. The verify interprets its
  // digest as a big-endian integer and reduces it mod the curve order
  // internally; both low-S and high-S signature forms are accepted (see
  // the malleability note in the header).
  const digest = envelope_digest(envelope, challenge);
  assert(
    secp256k1EcdsaVerify(digest, sig, pk),
    "invalid signature"
  );
  auth_nonce = ((auth_nonce + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

circuit bump_round(): [] {
  round = ((round + (1 as Uint<64>)) as Uint<64>);
}

// Unshielded mirror bookkeeping (MIP-0012 §5).

circuit credit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  if (unshielded_balances.member(color)) {
    unshielded_balances.insert(
      color,
      ((unshielded_balances.lookup(color) + amount) as Uint<128>)
    );
  } else {
    unshielded_balances.insert(color, amount);
  }
}

circuit debit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  assert(unshielded_balances.member(color), "no balance for color");
  const bal = unshielded_balances.lookup(color);
  assert(bal >= amount, "insufficient balance");
  unshielded_balances.insert(color, ((bal - amount) as Uint<128>));
}

// ── Custody chips (shared by every arm) ─────────────────────────────────────
//
// The MIP-0012 operation bodies, exactly once. Every `_with_<arm>` export
// below is challenge + seam chip + one of these. None of them touches
// auth_nonce or round — the seam chips own both.

// MIP-0012 §5: check and debit the mirror, then send to a user address.
circuit do_withdraw_unshielded(
  color:     Bytes<32>,
  amount:    Uint<128>,
  recipient: UserAddress,
): [] {
  const c = disclose(color);
  const a = disclose(amount);
  debit_unshielded(c, a);
  sendUnshielded(c, a, right<ContractAddress, UserAddress>(disclose(recipient)));
}

// MIP-0012 §6.2: inbox append without a coin claim (change-coin backfill).
circuit do_append_inbox(entry: Bytes<192>): [] {
  inbox.insert(inbox_count, disclose(entry));
  inbox_count = ((inbox_count + (1 as Uint<64>)) as Uint<64>);
}

// MIP-0012 §6.3: spend to a user's Zswap key. Change rule (§6.3,
// normative): sendShielded already routes change back to the contract as a
// live, self-owned output — the baseline realisation persists result.change
// directly, with no re-owning step. The surviving change description is
// returned to the caller through the transaction's communication
// commitment (not public); the client re-captures its mt_index and
// backfills the inbox via append_inbox (INV-4).
circuit do_withdraw_shielded(
  recipient: ZswapCoinPublicKey,
  amount:    Uint<128>,
  coin:      QualifiedShieldedCoinInfo,
): Maybe<ShieldedCoinInfo> {
  const result = sendShielded(
    disclose(coin),
    left<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount),
  );
  if (disclose(result.change.is_some)) {
    return some<ShieldedCoinInfo>(disclose(result.change.value));
  }
  return none<ShieldedCoinInfo>();
}

// MIP-0012 §6.6: the direct-transfer mode (see the exported circuits for
// the linking caveat). Returns [sent, change].
circuit do_withdraw_shielded_to_contract(
  recipient: ContractAddress,
  amount:    Uint<128>,
  coin:      QualifiedShieldedCoinInfo,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const result = sendShielded(
    disclose(coin),
    right<ZswapCoinPublicKey, ContractAddress>(disclose(recipient)),
    disclose(amount),
  );
  if (disclose(result.change.is_some)) {
    return [disclose(result.sent), some<ShieldedCoinInfo>(disclose(result.change.value))];
  }
  return [disclose(result.sent), none<ShieldedCoinInfo>()];
}

// MIP-0012 §6.7: the single enc_key mutation site.
circuit do_rotate_enc_key(new_key: Bytes<32>): [] {
  enc_key = disclose(new_key);
}

// MIP-0013 §6: enrol an already-derived entry (any arm).
circuit do_add_device(new_entry: Bytes<32>): [] {
  const e = disclose(new_entry);
  assert(!devices.member(e), "device entry already present");
  devices.insert(e);
  device_count = ((device_count + (1 as Uint<8>)) as Uint<8>);
}

// MIP-0013 §6: remove a literal entry (any arm), last-device rule.
//
// AUTH-5 requires that a removal never leaves the account without a device
// that can authorise. A count alone cannot carry that guarantee here: entries
// arrive already derived (§6 cross-arm enrolment), so device_count counts
// entries rather than demonstrably usable keys, and an account holding one
// real device plus one mis-derived entry would satisfy device_count > 1 while
// the removal stranded it permanently.
//
// The rule is therefore anchored on the caller instead: caller_entry is the
// authorising device's post-roll entry, and it may not be the entry removed.
// Every removal is thus authorised by a device that has just proved itself in
// this same transaction and that survives the removal, so at least one usable
// device always remains — a guarantee the count could only approximate. The
// count check is retained as a cheap redundant floor. A mis-derived entry can
// still inflate device_count until removed; it can no longer cause a lockout.
circuit do_remove_device(entry: Bytes<32>, caller_entry: Bytes<32>): [] {
  const e = disclose(entry);
  assert(device_count > (1 as Uint<8>), "cannot remove last device");
  assert(e != disclose(caller_entry), "cannot remove the authorising device");
  assert(devices.member(e), "unknown device entry");
  devices.remove(e);
  device_count = ((device_count - (1 as Uint<8>)) as Uint<8>);
}

// ── Unshielded custody (MIP-0012 §5) ────────────────────────────────────────

// Permissionless: anyone may fund the account. Increments round (§4).
export circuit deposit_unshielded(color: Bytes<32>, amount: Uint<128>): [] {
  const c = disclose(color);
  const a = disclose(amount);
  receiveUnshielded(c, a);
  credit_unshielded(c, a);
  bump_round();
}

// Authorised withdrawal to a user address.

export circuit withdraw_unshielded_with_jubjub(
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_withdraw_unshielded_with_jubjub(
    kernel.self(), sig_r, pk, color, amount, recipient, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_withdraw_unshielded(color, amount, recipient);
}

export circuit withdraw_unshielded_with_k256(
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_withdraw_unshielded_with_k256(
    kernel.self(), pk, color, amount, recipient, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_withdraw_unshielded(color, amount, recipient);
}

// ── Shielded custody, stateless (MIP-0012 §6) ───────────────────────────────

// Permissionless deposit (§6.2): claims the coin for the contract and
// appends the depositor-encrypted InboxEntry. The contract cannot verify
// the correspondence between coin and entry (S3); honest clients detect
// mismatches at discovery by recomputing the commitment against chain data.
export circuit deposit_shielded(coin: ShieldedCoinInfo, entry: Bytes<192>): [] {
  receiveShielded(disclose(coin));
  inbox.insert(inbox_count, disclose(entry));
  inbox_count = ((inbox_count + (1 as Uint<64>)) as Uint<64>);
  bump_round();
}

// Inbox append without a coin claim (§6.2): change-coin backfill. Gated
// behind the seam per the MAY of §6.2 (S9 spam defence) — backfill is
// always performed by the owner's own client, so gating loses nothing.

export circuit append_inbox_with_jubjub(
  entry:       Bytes<192>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_append_inbox_with_jubjub(
    kernel.self(), sig_r, pk, entry, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_append_inbox(entry);
}

export circuit append_inbox_with_k256(
  entry:       Bytes<192>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_append_inbox_with_k256(
    kernel.self(), pk, entry, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_append_inbox(entry);
}

// Authorised spend to a user's Zswap key (§6.3). The coin description
// enters through the held_coin witness, never from ledger state. The
// witness is invoked before the challenge so its returned value enters the
// challenge (AUTH-10): the signature authorises spending exactly this
// qualified coin, not any coin of this color.

export circuit withdraw_shielded_with_jubjub(
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_with_jubjub(
    kernel.self(), sig_r, pk, recipient, color, amount, coin, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  return do_withdraw_shielded(recipient, amount, coin);
}

export circuit withdraw_shielded_with_k256(
  recipient:   ZswapCoinPublicKey,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_with_k256(
    kernel.self(), pk, recipient, color, amount, coin, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  return do_withdraw_shielded(recipient, amount, coin);
}

// Authorised contract-recipient spend — the direct-transfer mode of §6.6
// (linking accepted). The output MUST be claimed by the receiving
// contract's deposit path in the same client-composed transaction; a
// contract-addressed output carries that address in cleartext, so a direct
// payment publishes the pair of accounts. Conforming clients MUST default
// to one-hop routing and produce this only by deliberate per-payment
// choice. Onward change handling is identical to the baseline circuit's.
//
// Returns [sent, change]: the composing client passes `sent` (the stdlib
// SendResult.sent coin — its nonce is the deterministic evolution of the
// input coin's) to the receiving contract's deposit_shielded claim, and
// persists `change` per the surviving-coin rule. Both travel privately in
// the communication commitment.

export circuit withdraw_shielded_to_contract_with_jubjub(
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_to_contract_with_jubjub(
    kernel.self(), sig_r, pk, recipient, color, amount, coin, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

export circuit withdraw_shielded_to_contract_with_k256(
  recipient:   ContractAddress,
  color:       Bytes<32>,
  amount:      Uint<128>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  const challenge = challenge_withdraw_shielded_to_contract_with_k256(
    kernel.self(), pk, recipient, color, amount, coin, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

// ── Encryption-key lifecycle (MIP-0012 §6.7) ────────────────────────────────
//
// Exactly one way to change enc_key. After rotation the client SHOULD
// re-encrypt held-coin descriptions into fresh inbox entries under the new
// key so the inbox walk succeeds with the new secret alone.

export circuit rotate_enc_key_with_jubjub(
  new_key:     Bytes<32>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_rotate_enc_key_with_jubjub(
    kernel.self(), sig_r, pk, new_key, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_rotate_enc_key(new_key);
}

export circuit rotate_enc_key_with_k256(
  new_key:     Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_rotate_enc_key_with_k256(
    kernel.self(), pk, new_key, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_rotate_enc_key(new_key);
}

// ── Device lifecycle (MIP-0013 §6) ──────────────────────────────────────────
//
// Any active device of any arm is sufficient to authorise (1-of-n at the
// contract surface). On the jubjub arm, threshold policies live behind a
// single device entry whose key is a FROST committee's joint key (MIP-0013
// §7) — this contract neither knows nor cares. ECDSA thresholdisation is
// deliberately out of scope for the k256 arm (it is one of MIP-0013 R2's
// grounds for rejecting ECDSA as the standard scheme).
//
// The NEW device is passed as its derived entry, computed client-side with
// the exported derive_device_entry_with_<arm> circuit of the NEW device's
// arm — so the authorising arm and the enrolled arm are independent, and
// enrolling a device of a future arm needs no change here. The entry is a
// collision-resistant commitment to the new key, its arm, the epoch, and
// the use counter, so the approval covers all four. The contract cannot
// inspect the entry's preimage: clients MUST derive it with the CURRENT
// device_epoch and use counter 0.
//
// Be precise about what a mis-derived entry does, because the guarantee is
// weaker than "inert" along two of its three dimensions.
//
//   address  An entry bound to a different contract address can never match a
//            seam recomputation. Genuinely dead weight.
//   counter  An entry at the CURRENT epoch and use counter k > 0 is NOT dead:
//            the seam recomputes against the caller-supplied use_counter, so
//            it authorises as soon as its key signs with use_counter = k.
//   epoch    An entry at a PAST epoch is dead. An entry at a FUTURE epoch is
//            dormant, not dead, and this is the sharp edge: nothing here binds
//            device_epoch, so any authorised device can enrol an entry derived
//            at device_epoch + 1. It matches nothing today and goes live the
//            moment the epoch advances.
//
// That last case is a live constraint on the MIP-0013 §8 recovery seam, which
// is the only thing that will ever bump device_epoch. AUTH-6 exists so that a
// bump revokes a compromised device set WITHOUT enumerating it, and a
// pre-planted future-epoch entry defeats exactly that: the device being
// evicted survives its own eviction. **A recovery seam added here MUST clear
// the device set as part of the bump rather than rely on entries going
// stale** (equivalently, entries must be stored stamped with the epoch the
// CONTRACT observed at enrolment, rather than one carried in a preimage the
// contract cannot inspect). See README erratum 7.
//
// None of these can strand the account, because a removal may not remove the
// device that authorised it (AUTH-5, do_remove_device), and all of them count
// toward device_count until removed.
//
// LIVENESS IS NOT THE PROBLEM HERE; REVOCATION IS. Nothing constrains a
// device to exactly one live entry, so an enrolled device can enrol a
// SECOND entry for its OWN key. The seam consumes its current entry and
// inserts the successor, then this circuit inserts the planted one, and the
// device is live at two counters. remove_device retires one set ELEMENT, and
// resolving which element belongs to a device returns the first live counter
// found, so a revocation removes one and the device keeps authorising on the
// other. Measured on-node in src/tests/probe-revocation.ts.
//
// Deriving the entry in-circuit from new_pk does NOT fix this: a device whose
// chain has advanced past counter 0 has left that entry vacant, so enrolling
// its own key plants exactly the element such a derivation emits. The probe
// exercises both shapes and both bypass. The contract cannot decide "this key
// is already enrolled" over the current ledger shape (it holds an opaque
// entry, or a key whose other entries it cannot search for), and stating the
// rule as a client obligation (S11) does not help, because the party it binds
// is the adversary in this threat model. Closing it needs a per-device
// identity the CONTRACT maintains, which is a ledger-schema change and so a
// redeploy: see README erratum 8, which carries the shape.

export circuit add_device_with_jubjub(
  new_entry:   Bytes<32>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_add_device_with_jubjub(
    kernel.self(), sig_r, pk, new_entry, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  do_add_device(new_entry);
}

export circuit add_device_with_k256(
  new_entry:   Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_add_device_with_k256(
    kernel.self(), pk, new_entry, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_add_device(new_entry);
}

// Removes a device's CURRENT entry, supplied as the literal set element
// (MIP-0013 §6): removing a lost device requires its public key and
// current use counter, recovered from the client roster or the S11
// rescan. Entry-typed, so a device of either arm removes a device of
// either arm.

export circuit remove_device_with_jubjub(
  entry:       Bytes<32>,
  pk:          JubjubPoint,
  use_counter: Uint<64>,
  sig_r:       JubjubPoint,
  sig_s:       Field,
  grind_nonce: Uint<64>,
): [] {
  const challenge = challenge_remove_device_with_jubjub(
    kernel.self(), sig_r, pk, entry, auth_nonce, grind_nonce
  );
  require_authorised_with_jubjub(pk, use_counter, sig_r, sig_s, challenge);
  // The seam has rolled the caller to use_counter + 1; that entry is the one
  // it must not remove (removing its pre-roll entry already fails membership).
  do_remove_device(entry, derive_device_entry_with_jubjub(
    kernel.self(), pk, device_epoch, ((use_counter + (1 as Uint<64>)) as Uint<64>)
  ));
}

export circuit remove_device_with_k256(
  entry:       Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_remove_device_with_k256(
    kernel.self(), pk, entry, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  // As above: the caller's post-roll entry is off limits.
  do_remove_device(entry, derive_device_entry_with_k256(
    kernel.self(), pk, envelope, device_epoch,
    ((use_counter + (1 as Uint<64>)) as Uint<64>)
  ));
}

// ═══════════════════════════════════════════════════════════════════════════
// Scoped grants (the scoped-grants MIP): a second authoriser class behind
// the same custody chips.
//
// A grant twin `<operation>_with_grant_<arm>` verifies a grant record and a
// grantee signature where the device twin verifies a device entry and a
// device signature, then calls the SAME custody chip. The grant seam is
// three chips per grantee arm (authenticate, check the spend scope, settle)
// over the pure derivations below; the lifecycle circuits (issue, revoke,
// revoke all) sit behind the unchanged device seam of the device arm that
// authorises them. Grant calls read and advance the record's own nonce and
// never auth_nonce (GR-5), so a grantee cannot invalidate a pending owner
// authorisation.
//
// Every preimage is a byte concatenation of fixed-width elements hashed
// with SHA-256 (persistentHash over byte atoms is SHA-256 of the raw
// concatenation); the exported pure circuits are one implementation of the
// recipe, not its definition. Tag families (MIP section 14):
//   midnight:account:grant:id:{v1,k1:v1}          raw 32-byte pad, element
//   midnight:account:grant:{obj,spent,rp,scope}:v1 raw 32-byte pad, element
//   midnight:account:grant:auth:{v1,k1:v1}:<op>   hashed from a 64-byte pad
//   midnight:account:auth:{v1,k1:v1}:{issue_grant,revoke_grant,
//     revoke_all_grants}                            the existing device family
// ═══════════════════════════════════════════════════════════════════════════

// ── Grant identity (MIP section 4.3) ────────────────────────────────────────
//
// Recomputed in-circuit from the presented key at every use, so a mismatch
// of key, origin, slot, arm, or envelope fails at the membership assert. The
// k256 key is bound as the little-endian affine coordinate bytes, as the
// arm's device entries bind it; the JubJub key as the JubjubPoint element.

export pure circuit derive_grant_id_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  envelope:    Uint<8>,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Uint<8>, Bytes<32>, Uint<8>]>(
    [pad(32, "midnight:account:grant:id:k1:v1"), self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     envelope, origin_hash, slot]
  );
}

export pure circuit derive_grant_id_with_jubjub(
  self_addr:   ContractAddress,
  pk:          JubjubPoint,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, JubjubPoint, Bytes<32>, Uint<8>]>(
    [pad(32, "midnight:account:grant:id:v1"), self_addr, pk, origin_hash, slot]
  );
}

// ── Commitments and the scope digest (MIP section 4.5) ──────────────────────
//
// The hiding of all three commitments rests on scope_salt being fresh per
// issuance and staying with the owner and the grantee.

export pure circuit derive_grant_object_commit(
  scope_salt:     Bytes<32>,
  color:          Bytes<32>,
  recipient_kind: Uint<8>,
  recipient:      Bytes<32>,
  max_coin_value: Uint<128>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>, Uint<8>, Bytes<32>, Uint<128>]>(
    [pad(32, "midnight:account:grant:obj:v1"), scope_salt, color,
     recipient_kind, recipient, max_coin_value]
  );
}

export pure circuit derive_grant_spent_commit(
  scope_salt: Bytes<32>,
  spent:      Uint<128>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Uint<128>]>(
    [pad(32, "midnight:account:grant:spent:v1"), scope_salt, spent]
  );
}

export pure circuit derive_grant_rp_commit(
  scope_salt: Bytes<32>,
  rp_id_hash: Bytes<32>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>]>(
    [pad(32, "midnight:account:grant:rp:v1"), scope_salt, rp_id_hash]
  );
}

// The single element through which the issue_grant device challenge binds
// the whole plaintext scope. Flags enter as single bytes: a Boolean's
// field-aligned encoding is a one-byte atom (0x01 true, 0x00 false), so the
// Boolean elements below hash exactly as flag(b) of the MIP's notation.
export pure circuit derive_grant_scope_digest(
  scope_salt:                       Bytes<32>,
  op_withdraw_unshielded:           Boolean,
  op_withdraw_shielded:             Boolean,
  op_withdraw_shielded_to_contract: Boolean,
  read:                             Boolean,
  color:                            Bytes<32>,
  recipient_kind:                   Uint<8>,
  recipient:                        Bytes<32>,
  max_coin_value:                   Uint<128>,
  per_call_cap:                     Uint<128>,
  cap:                              Uint<128>,
  expires_at:                       Uint<64>,
  rp_id_hash:                       Bytes<32>,
  read_pk_hash:                     Bytes<32>,
  window_len:                       Uint<64>,
  window_cap:                       Uint<128>,
): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Boolean, Boolean, Boolean, Boolean, Bytes<32>, Uint<8>, Bytes<32>, Uint<128>, Uint<128>, Uint<128>, Uint<64>, Bytes<32>, Bytes<32>, Uint<64>, Uint<128>]>(
    [pad(32, "midnight:account:grant:scope:v1"), scope_salt,
     op_withdraw_unshielded, op_withdraw_shielded, op_withdraw_shielded_to_contract, read,
     color, recipient_kind, recipient, max_coin_value,
     per_call_cap, cap, expires_at, rp_id_hash, read_pk_hash, window_len, window_cap]
  );
}

// ── Grant challenge constructions, grantee arm k256 (MIP section 6.3) ───────
//
// Preimage:
//   [DST, self, pk_x, pk_y, grant_id, issued_at, ...args, ...witness_values,
//    g.nonce]
// with DST = persistentHash<[Bytes<64>]> of
// "midnight:account:grant:auth:k1:v1:<operation>" zero-padded to 64 bytes.
// No signature term and no grinding nonce, as on the device arm. grant_id
// makes one signature unusable across two grants of the same key;
// issued_at isolates incarnations of one id (GR-6); the record's nonce,
// read in-circuit, is the freshness element (GR-5).

export pure circuit challenge_withdraw_unshielded_with_grant_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  grant_id:    Bytes<32>,
  issued_at:   Uint<64>,
  color:       Bytes<32>,
  amount:      Uint<128>,
  recipient:   UserAddress,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:grant:auth:k1:v1:withdraw_unshielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>, Bytes<32>, Uint<128>, UserAddress, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     grant_id, issued_at, color, amount, recipient, nonce_value]
  );
}

// The shielded twin binds the held_coin return value (AUTH-10) and the
// change entry the grantee pre-encrypted, with the enc_key it encrypted to.
export pure circuit challenge_withdraw_shielded_with_grant_k256(
  self_addr:    ContractAddress,
  pk:           Secp256k1Point,
  grant_id:     Bytes<32>,
  issued_at:    Uint<64>,
  recipient:    ZswapCoinPublicKey,
  color:        Bytes<32>,
  amount:       Uint<128>,
  change_entry: Bytes<192>,
  enc_pk:       Bytes<32>,
  coin:         QualifiedShieldedCoinInfo,
  nonce_value:  Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:grant:auth:k1:v1:withdraw_shielded")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>, ZswapCoinPublicKey, Bytes<32>, Uint<128>, Bytes<192>, Bytes<32>, QualifiedShieldedCoinInfo, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     grant_id, issued_at, recipient, color, amount, change_entry, enc_pk, coin, nonce_value]
  );
}

// ── Lifecycle challenge constructions, device arm k256 (MIP section 6.1) ────
//
// In the existing device tag family ("midnight:account:auth:k1:v1:*") and
// the existing k256 preimage shape. issue_grant's argument list is
// [grant_id, scope_digest]: the whole plaintext scope enters through the
// digest (GR-16).

export pure circuit challenge_issue_grant_with_k256(
  self_addr:    ContractAddress,
  pk:           Secp256k1Point,
  grant_id:     Bytes<32>,
  scope_digest: Bytes<32>,
  nonce_value:  Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:issue_grant")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     grant_id, scope_digest, nonce_value]
  );
}

export pure circuit challenge_revoke_grant_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  grant_id:    Bytes<32>,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:revoke_grant")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     grant_id, nonce_value]
  );
}

export pure circuit challenge_revoke_all_grants_with_k256(
  self_addr:   ContractAddress,
  pk:          Secp256k1Point,
  nonce_value: Uint<64>,
): Bytes<32> {
  const dst = persistentHash<[Bytes<64>]>(
    [pad(64, "midnight:account:auth:k1:v1:revoke_all_grants")]
  );
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, Uint<64>]>(
    [dst, self_addr,
     secp256k1PointX(pk) as Bytes<32>, secp256k1PointY(pk) as Bytes<32>,
     nonce_value]
  );
}

// ── The grant seam (MIP section 6.2), grantee arm k256 ──────────────────────
//
// Three chips shared by the arm's twins, in the MIP's step order:
//   authenticate_grant  steps 1 to 3: key guard, identity, liveness;
//   check_spend_scope   steps 4 and 5: operation flag, object commitment,
//                       caps, spent commitment, recipient pin (arm-agnostic);
//   settle_grant        steps 6 and 7: signature over the twin's challenge,
//                       write-back of nonce + 1 and the new spent_commit,
//                       round.
// The challenge is computed by the twin between authenticate and settle
// because it binds the record's nonce and issued_at, which only the lookup
// yields. Every predicate is evaluated over the value the custody chip will
// consume. Disclosed per call: grant_id (lookup and write-back), the
// rewritten nonce and spent_commit, and the kernel comparison's argument;
// pk, origin_hash, slot, scope_salt, the openings, spent_prev, enc_pk, and
// the signature stay witness data (GR-15).

circuit authenticate_grant_with_k256(
  pk:          Secp256k1Point,
  envelope:    Uint<8>,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): [Bytes<32>, GrantRecord] {
  // Every caller of this chip is a spend. A connector `signData` key
  // (envelope 1) is a blind 32-byte signing surface, and every element of a
  // grant challenge is public or attacker-chosen, so another site the same
  // wallet connects to could obtain a valid spend signature by asking the
  // wallet to sign an opaque message. Envelope-1 grants are therefore
  // read-only: issuable and enumerable, with no twin to call. Enforced here
  // rather than delegated to the authoriser, which the threat model does
  // not trust.
  assert(envelope == (0 as Uint<8>), "envelope not admitted for a spend grant");
  // Step 1: the same weak-key rejection the device seam applies (GR-14).
  require_live_k256_key(pk);
  // Step 2: identity. The lookup is dominated by the membership assert;
  // never combine the two in one boolean expression, both operands of which
  // are evaluated.
  const id = disclose(derive_grant_id_with_k256(kernel.self(), pk, envelope, origin_hash, slot));
  assert(grants.member(id), "unknown grant");
  const g = grants.lookup(id);
  // Step 3: liveness. The expiry test is a select with both sides
  // evaluated; the kernel comparison's argument reaches the public
  // transcript, which is harmless because the record is public.
  assert(g.active, "grant revoked");
  assert(g.epoch == device_epoch, "grant epoch stale");
  assert(g.gen == grant_generation, "grant generation stale");
  assert(g.scope.expires_at == (0 as Uint<64>) || kernel.blockTimeLessThan(g.scope.expires_at),
         "grant expired");
  return [id, g];
}

// Steps 4 and 5 over the consumed values: obj_color is the witness coin's
// color on the shielded twins and the color argument on the unshielded one;
// this_kind and recipient_bytes are the twin's recipient kind and the bytes
// of the recipient it sends to. Returns the narrowed cumulative spend.
circuit check_spend_scope(
  g:                GrantRecord,
  op_admitted:      Boolean,
  scope_salt:       Bytes<32>,
  obj_color:        Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  amount:           Uint<128>,
  spent_prev:       Uint<128>,
  this_kind:        Uint<8>,
  recipient_bytes:  Bytes<32>,
): Uint<128> {
  assert(op_admitted, "operation not in scope");
  assert(derive_grant_object_commit(scope_salt, obj_color, recipient_kind, pinned_recipient, max_coin_value)
           == g.scope.object_commit,
         "scope object mismatch");
  assert(amount <= g.scope.per_call_cap, "amount above per-call cap");
  assert(derive_grant_spent_commit(scope_salt, spent_prev) == g.spent_commit,
         "spent opening mismatch");
  // Widened sum first, then the cap test, then the narrowing cast: the two
  // failures are distinct (a wrap attempt fails the cap, never the cast).
  const wide = spent_prev + amount;
  assert(wide <= g.scope.cap, "cumulative cap exceeded");
  const new_spent = wide as Uint<128>;
  assert(recipient_kind == (0 as Uint<8>)
           || (recipient_kind == this_kind && pinned_recipient == recipient_bytes),
         "recipient not admitted by pin");
  return new_spent;
}

// The shielded twins' additional step-5 predicates: the consumed coin's
// value is bounded by the committed max_coin_value (R7), and the enc_key
// the grantee encrypted the change entry to is the live one, so a rotation
// between signing and inclusion aborts the call instead of orphaning change.
circuit check_shielded_grant_bounds(
  coin:           QualifiedShieldedCoinInfo,
  max_coin_value: Uint<128>,
  enc_pk:         Bytes<32>,
): [] {
  assert(coin.value <= max_coin_value, "coin above max_coin_value");
  assert(enc_pk == enc_key, "stale encryption key");
}

// Steps 6 and 7. The signature covers envelope_digest(envelope, h), both S
// forms accepted, as on the device arm. The write-back is a full struct
// literal with the record's own fields carried through; auth_nonce,
// devices, device_count, and enc_key are never written here.
circuit settle_grant_with_k256(
  id:         Bytes<32>,
  g:          GrantRecord,
  pk:         Secp256k1Point,
  envelope:   Uint<8>,
  challenge:  Bytes<32>,
  sig:        Secp256k1EcdsaSignature,
  scope_salt: Bytes<32>,
  new_spent:  Uint<128>,
): [] {
  const digest = envelope_digest(envelope, challenge);
  assert(secp256k1EcdsaVerify(digest, sig, pk), "invalid grant signature");
  grants.insert(id, GrantRecord {
    epoch:        g.epoch,
    gen:          g.gen,
    issued_at:    g.issued_at,
    nonce:        ((g.nonce + (1 as Uint<64>)) as Uint<64>),
    spent_commit: disclose(derive_grant_spent_commit(scope_salt, new_spent)),
    window_start: g.window_start,
    window_spent: g.window_spent,
    active:       g.active,
    scope:        g.scope
  });
  bump_round();
}

// ── Grant twins, grantee arm k256 (MIP section 6.1) ─────────────────────────
//
// Operation arguments first, then the grant authorising material in the
// MIP's order. There is no nonce argument: the record's nonce is read
// in-circuit. Recipient kinds: 1 UserAddress, 2 ZswapCoinPublicKey,
// 3 ContractAddress.

export circuit withdraw_unshielded_with_grant_k256(
  color:            Bytes<32>,
  amount:           Uint<128>,
  recipient:        UserAddress,
  pk:               Secp256k1Point,
  envelope:         Uint<8>,
  origin_hash:      Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  sig:              Secp256k1EcdsaSignature,
): [] {
  const [id, g] = authenticate_grant_with_k256(pk, envelope, origin_hash, slot);
  const new_spent = check_spend_scope(
    g, g.scope.op_withdraw_unshielded, scope_salt, color,
    recipient_kind, pinned_recipient, max_coin_value, amount, spent_prev,
    1 as Uint<8>, recipient.bytes
  );
  const challenge = challenge_withdraw_unshielded_with_grant_k256(
    kernel.self(), pk, id, g.issued_at, color, amount, recipient, g.nonce
  );
  settle_grant_with_k256(id, g, pk, envelope, challenge, sig, scope_salt, new_spent);
  do_withdraw_unshielded(color, amount, recipient);
}

// The witness is invoked first so its returned value enters the challenge
// (AUTH-10) and the scope predicates test the coin actually consumed. After
// the custody chip, the change entry the grantee pre-encrypted is appended
// through the inbox chip in the same circuit, under a disclosed branch on
// whether the send produced change (INV-4 under a grant).
export circuit withdraw_shielded_with_grant_k256(
  recipient:        ZswapCoinPublicKey,
  color:            Bytes<32>,
  amount:           Uint<128>,
  change_entry:     Bytes<192>,
  enc_pk:           Bytes<32>,
  pk:               Secp256k1Point,
  envelope:         Uint<8>,
  origin_hash:      Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  sig:              Secp256k1EcdsaSignature,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  const [id, g] = authenticate_grant_with_k256(pk, envelope, origin_hash, slot);
  const new_spent = check_spend_scope(
    g, g.scope.op_withdraw_shielded, scope_salt, coin.color,
    recipient_kind, pinned_recipient, max_coin_value, amount, spent_prev,
    2 as Uint<8>, recipient.bytes
  );
  check_shielded_grant_bounds(coin, max_coin_value, enc_pk);
  const challenge = challenge_withdraw_shielded_with_grant_k256(
    kernel.self(), pk, id, g.issued_at, recipient, color, amount, change_entry, enc_pk, coin, g.nonce
  );
  settle_grant_with_k256(id, g, pk, envelope, challenge, sig, scope_salt, new_spent);
  const result = do_withdraw_shielded(recipient, amount, coin);
  if (disclose(result.is_some)) {
    do_append_inbox(change_entry);
  }
  return result;
}

// ── Grant lifecycle chips (MIP section 7.1) ─────────────────────────────────
//
// Device-gated through the unchanged device seam, which has advanced
// auth_nonce and round before these bodies run. Every Map.lookup is
// dominated by a member branch or assert. No spread or update syntax: every
// struct literal is spelled out in full.

circuit do_issue_grant(
  grant_id:                         Bytes<32>,
  op_withdraw_unshielded:           Boolean,
  op_withdraw_shielded:             Boolean,
  op_withdraw_shielded_to_contract: Boolean,
  read:                             Boolean,
  color:                            Bytes<32>,
  recipient_kind:                   Uint<8>,
  recipient:                        Bytes<32>,
  max_coin_value:                   Uint<128>,
  per_call_cap:                     Uint<128>,
  cap:                              Uint<128>,
  expires_at:                       Uint<64>,
  rp_id_hash:                       Bytes<32>,
  read_pk_hash:                     Bytes<32>,
  window_len:                       Uint<64>,
  window_cap:                       Uint<128>,
  scope_salt:                       Bytes<32>,
): [] {
  const id = disclose(grant_id);
  // No live record under this id. Issue over an absent id, a tombstone, or
  // an inert record succeeds; expiry is not evaluated here, so an expired
  // but unrevoked record is live for this test (revoke first, MIP 7.2).
  if (grants.member(id)) {
    const old = grants.lookup(id);
    assert(!old.active || old.epoch != device_epoch || old.gen != grant_generation,
           "grant already active");
  }
  // Issue rules of MIP section 5.1, in order.
  const spend = op_withdraw_unshielded || op_withdraw_shielded || op_withdraw_shielded_to_contract;
  assert(spend || read, "empty scope");
  assert(!(op_withdraw_shielded || op_withdraw_shielded_to_contract) || read,
         "shielded spend requires read");
  assert(per_call_cap <= cap, "per-call cap above cap");
  assert(!spend || cap > (0 as Uint<128>), "spend without cap");
  assert(!spend || max_coin_value >= per_call_cap, "coin bound below per-call cap");
  assert(!read || read_pk_hash != pad(32, ""), "read without delegate key");
  assert(window_len == (0 as Uint<64>) && window_cap == (0 as Uint<128>),
         "window bounds reserved");
  assert(spend
           || (color == pad(32, "") && recipient_kind == (0 as Uint<8>)
               && recipient == pad(32, "") && max_coin_value == (0 as Uint<128>)
               && per_call_cap == (0 as Uint<128>) && cap == (0 as Uint<128>)),
         "read-only grant carries object fields");
  // The whole record. color, recipient, max_coin_value, and rp_id_hash are
  // never disclosed; only their commitments are.
  grants.insert(id, GrantRecord {
    epoch:        device_epoch,
    gen:          grant_generation,
    issued_at:    auth_nonce,
    nonce:        0 as Uint<64>,
    spent_commit: disclose(derive_grant_spent_commit(scope_salt, 0 as Uint<128>)),
    window_start: 0 as Uint<64>,
    window_spent: 0 as Uint<128>,
    active:       true,
    scope: GrantScope {
      op_withdraw_unshielded:           disclose(op_withdraw_unshielded),
      op_withdraw_shielded:             disclose(op_withdraw_shielded),
      op_withdraw_shielded_to_contract: disclose(op_withdraw_shielded_to_contract),
      read:                             disclose(read),
      object_commit: disclose(derive_grant_object_commit(
        scope_salt, color, recipient_kind, recipient, max_coin_value
      )),
      per_call_cap:  disclose(per_call_cap),
      cap:           disclose(cap),
      expires_at:    disclose(expires_at),
      rp_commit:     disclose(derive_grant_rp_commit(scope_salt, rp_id_hash)),
      read_pk_hash:  disclose(read_pk_hash),
      window_len:    0 as Uint<64>,
      window_cap:    0 as Uint<128>
    }
  });
}

circuit do_revoke_grant(grant_id: Bytes<32>): [] {
  const id = disclose(grant_id);
  assert(grants.member(id), "unknown grant");
  const old = grants.lookup(id);
  assert(old.active, "grant not live");
  grants.insert(id, GrantRecord {
    epoch:        old.epoch,
    gen:          old.gen,
    issued_at:    old.issued_at,
    nonce:        old.nonce,
    spent_commit: old.spent_commit,
    window_start: old.window_start,
    window_spent: old.window_spent,
    active:       false,
    scope:        old.scope
  });
}

// The generation bump carries safety (GR-9); clearing the map is the
// optional state relief the MIP permits.
circuit do_revoke_all_grants(): [] {
  grant_generation = ((grant_generation + (1 as Uint<32>)) as Uint<32>);
  grants.resetToDefault();
}

// ── Grant lifecycle, device arm k256 ────────────────────────────────────────

export circuit issue_grant_with_k256(
  grant_id:                         Bytes<32>,
  op_withdraw_unshielded:           Boolean,
  op_withdraw_shielded:             Boolean,
  op_withdraw_shielded_to_contract: Boolean,
  read:                             Boolean,
  color:                            Bytes<32>,
  recipient_kind:                   Uint<8>,
  recipient:                        Bytes<32>,
  max_coin_value:                   Uint<128>,
  per_call_cap:                     Uint<128>,
  cap:                              Uint<128>,
  expires_at:                       Uint<64>,
  rp_id_hash:                       Bytes<32>,
  read_pk_hash:                     Bytes<32>,
  window_len:                       Uint<64>,
  window_cap:                       Uint<128>,
  scope_salt:                       Bytes<32>,
  pk:                               Secp256k1Point,
  use_counter:                      Uint<64>,
  sig:                              Secp256k1EcdsaSignature,
  envelope:                         Uint<8>,
): [] {
  const scope_digest = derive_grant_scope_digest(
    scope_salt, op_withdraw_unshielded, op_withdraw_shielded,
    op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient,
    max_coin_value, per_call_cap, cap, expires_at, rp_id_hash, read_pk_hash,
    window_len, window_cap
  );
  const challenge = challenge_issue_grant_with_k256(
    kernel.self(), pk, grant_id, scope_digest, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_issue_grant(
    grant_id, op_withdraw_unshielded, op_withdraw_shielded,
    op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient,
    max_coin_value, per_call_cap, cap, expires_at, rp_id_hash, read_pk_hash,
    window_len, window_cap, scope_salt
  );
}

export circuit revoke_grant_with_k256(
  grant_id:    Bytes<32>,
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_revoke_grant_with_k256(
    kernel.self(), pk, grant_id, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_revoke_grant(grant_id);
}

export circuit revoke_all_grants_with_k256(
  pk:          Secp256k1Point,
  use_counter: Uint<64>,
  sig:         Secp256k1EcdsaSignature,
  envelope:    Uint<8>,
): [] {
  const challenge = challenge_revoke_all_grants_with_k256(
    kernel.self(), pk, auth_nonce
  );
  require_authorised_with_k256(pk, use_counter, sig, challenge, envelope);
  do_revoke_all_grants();
}
