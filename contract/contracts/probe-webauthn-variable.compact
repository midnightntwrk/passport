  assert(25 < hint.origin_length ? (hint.origin[25] == data[116] && hint.origin[25] >= 33 && hint.origin[25] <= 126 && hint.origin[25] != 34 && hint.origin[25] != 92) : hint.origin[25] == 0, "origin encoding mismatch");
  assert(26 < hint.origin_length ? (hint.origin[26] == data[117] && hint.origin[26] >= 33 && hint.origin[26] <= 126 && hint.origin[26] != 34 && hint.origin[26] != 92) : hint.origin[26] == 0, "origin encoding mismatch");
  assert(27 < hint.origin_length ? (hint.origin[27] == data[118] && hint.origin[27] >= 33 && hint.origin[27] <= 126 && hint.origin[27] != 34 && hint.origin[27] != 92) : hint.origin[27] == 0, "origin encoding mismatch");
  assert(28 < hint.origin_length ? (hint.origin[28] == data[119] && hint.origin[28] >= 33 && hint.origin[28] <= 126 && hint.origin[28] != 34 && hint.origin[28] != 92) : hint.origin[28] == 0, "origin encoding mismatch");
  assert(29 < hint.origin_length ? (hint.origin[29] == data[120] && hint.origin[29] >= 33 && hint.origin[29] <= 126 && hint.origin[29] != 34 && hint.origin[29] != 92) : hint.origin[29] == 0, "origin encoding mismatch");
  assert(30 < hint.origin_length ? (hint.origin[30] == data[121] && hint.origin[30] >= 33 && hint.origin[30] <= 126 && hint.origin[30] != 34 && hint.origin[30] != 92) : hint.origin[30] == 0, "origin encoding mismatch");
  assert(31 < hint.origin_length ? (hint.origin[31] == data[122] && hint.origin[31] >= 33 && hint.origin[31] <= 126 && hint.origin[31] != 34 && hint.origin[31] != 92) : hint.origin[31] == 0, "origin encoding mismatch");
  assert(32 < hint.origin_length ? (hint.origin[32] == data[123] && hint.origin[32] >= 33 && hint.origin[32] <= 126 && hint.origin[32] != 34 && hint.origin[32] != 92) : hint.origin[32] == 0, "origin encoding mismatch");
  assert(33 < hint.origin_length ? (hint.origin[33] == data[124] && hint.origin[33] >= 33 && hint.origin[33] <= 126 && hint.origin[33] != 34 && hint.origin[33] != 92) : hint.origin[33] == 0, "origin encoding mismatch");
  assert(34 < hint.origin_length ? (hint.origin[34] == data[125] && hint.origin[34] >= 33 && hint.origin[34] <= 126 && hint.origin[34] != 34 && hint.origin[34] != 92) : hint.origin[34] == 0, "origin encoding mismatch");
