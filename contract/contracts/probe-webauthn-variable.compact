export pure circuit policy_commitment(rp_hash: Bytes<32>, origin: Bytes<96>, origin_length: Uint<16>, pk: Secp256r1Point): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<96>, Uint<16>, Bytes<32>, Bytes<32>]>([
    rp_hash, origin, origin_length, secp256r1PointX(pk) as Bytes<32>, secp256r1PointY(pk) as Bytes<32>
  ]);
}

export circuit hash_bytes(data: Bytes<256>, length: Uint<16>): Bytes<32> {
  const digest = sha256_bounded(data, length);
  accepted = disclose(digest);
  return disclose(digest);
}

export circuit verify_webauthn(data: Bytes<256>, length: Uint<16>, rp_hash: Bytes<32>, authenticator_data: Bytes<37>, sig: Secp256r1EcdsaSignature, pk: Secp256r1Point): [] {
  assert(length <= 256, "client data exceeds capacity");
  const hint = inspect_json(data, length);
  assert(hint.origin_length > 0 && hint.origin_length <= 96, "origin length out of range");
  assert(hint.prefix_length == 112 + hint.origin_length, "dishonest prefix length");
  assert(length > hint.prefix_length, "truncated client data");
  assert(policy_commitment(rp_hash, hint.origin, hint.origin_length, pk) == enrolled_policy, "unknown key or origin policy");
  assert(slice<36>(data, 0) == pad(36, "{\"type\":\"webauthn.get\",\"challenge\":\""), "client data type/prefix mismatch");
  assert(slice<43>(data, 36) == webauthn_challenge_base64(expected_challenge), "challenge mismatch");
  assert(slice<12>(data, 79) == pad(12, "\",\"origin\":\""), "origin field missing");
  assert(0 < hint.origin_length ? (hint.origin[0] == data[91] && hint.origin[0] >= 33 && hint.origin[0] <= 126 && hint.origin[0] != 34 && hint.origin[0] != 92) : hint.origin[0] == 0, "origin encoding mismatch");
  assert(1 < hint.origin_length ? (hint.origin[1] == data[92] && hint.origin[1] >= 33 && hint.origin[1] <= 126 && hint.origin[1] != 34 && hint.origin[1] != 92) : hint.origin[1] == 0, "origin encoding mismatch");
  assert(2 < hint.origin_length ? (hint.origin[2] == data[93] && hint.origin[2] >= 33 && hint.origin[2] <= 126 && hint.origin[2] != 34 && hint.origin[2] != 92) : hint.origin[2] == 0, "origin encoding mismatch");
  assert(3 < hint.origin_length ? (hint.origin[3] == data[94] && hint.origin[3] >= 33 && hint.origin[3] <= 126 && hint.origin[3] != 34 && hint.origin[3] != 92) : hint.origin[3] == 0, "origin encoding mismatch");
  assert(4 < hint.origin_length ? (hint.origin[4] == data[95] && hint.origin[4] >= 33 && hint.origin[4] <= 126 && hint.origin[4] != 34 && hint.origin[4] != 92) : hint.origin[4] == 0, "origin encoding mismatch");
  assert(5 < hint.origin_length ? (hint.origin[5] == data[96] && hint.origin[5] >= 33 && hint.origin[5] <= 126 && hint.origin[5] != 34 && hint.origin[5] != 92) : hint.origin[5] == 0, "origin encoding mismatch");
  assert(6 < hint.origin_length ? (hint.origin[6] == data[97] && hint.origin[6] >= 33 && hint.origin[6] <= 126 && hint.origin[6] != 34 && hint.origin[6] != 92) : hint.origin[6] == 0, "origin encoding mismatch");
  assert(7 < hint.origin_length ? (hint.origin[7] == data[98] && hint.origin[7] >= 33 && hint.origin[7] <= 126 && hint.origin[7] != 34 && hint.origin[7] != 92) : hint.origin[7] == 0, "origin encoding mismatch");
  assert(8 < hint.origin_length ? (hint.origin[8] == data[99] && hint.origin[8] >= 33 && hint.origin[8] <= 126 && hint.origin[8] != 34 && hint.origin[8] != 92) : hint.origin[8] == 0, "origin encoding mismatch");
  assert(9 < hint.origin_length ? (hint.origin[9] == data[100] && hint.origin[9] >= 33 && hint.origin[9] <= 126 && hint.origin[9] != 34 && hint.origin[9] != 92) : hint.origin[9] == 0, "origin encoding mismatch");
  assert(10 < hint.origin_length ? (hint.origin[10] == data[101] && hint.origin[10] >= 33 && hint.origin[10] <= 126 && hint.origin[10] != 34 && hint.origin[10] != 92) : hint.origin[10] == 0, "origin encoding mismatch");
  assert(11 < hint.origin_length ? (hint.origin[11] == data[102] && hint.origin[11] >= 33 && hint.origin[11] <= 126 && hint.origin[11] != 34 && hint.origin[11] != 92) : hint.origin[11] == 0, "origin encoding mismatch");
