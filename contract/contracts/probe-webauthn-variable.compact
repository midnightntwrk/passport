pure circuit padded_byte(input: Uint<8>, index: Uint<16>, length: Uint<16>, padded_length: Uint<16>, bit_length: Bytes<4>): Uint<8> {
  return index < length ? input
    : index == length ? 128
    : index == padded_length - 2 ? bit_length[2]
    : index == padded_length - 1 ? bit_length[3]
    : 0;
}

