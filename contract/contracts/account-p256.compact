// P-256 / profiled WebAuthn arm, included by account.compact. All custody,
// grant-scope and recovery mutations use the existing shared chips.
// Keys, RP and exact origin are private authorisation inputs. Device entries
// and boot commitments bind the policy, so a prover cannot choose a new RP.
// Grant identity binds origin; its salted rp_commit binds the RP separately.

// Keep these structs internal: Compact 0.35's exported-struct TypeScript
// unifier omits curve-secp256r1. Inline ABI emission handles the same fields.
struct P256Auth {
  pk: Secp256r1Point;
  use_counter: Uint<64>;
  policy: WebAuthnPolicy;
  authenticator_data: Bytes<37>;
  sig: Secp256r1EcdsaSignature;
}

struct P256GrantAuth {
  pk: Secp256r1Point;
  policy: WebAuthnPolicy;
  authenticator_data: Bytes<37>;
  sig: Secp256r1EcdsaSignature;
}

export pure circuit compute_public_point_with_p256(scalar: Secp256r1Scalar): Secp256r1Point {
  return ecMulGenerator(scalar);
}

export pure circuit derive_boot_commitment_with_p256(
  salt: Bytes<32>, pk: Secp256r1Point, policy: WebAuthnPolicy
): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, WebAuthnPolicy]>([
    pad(32, "midnight:account:boot:r1:v2"), salt,
    secp256r1PointX(pk) as Bytes<32>, secp256r1PointY(pk) as Bytes<32>, policy
  ]);
}

export pure circuit derive_device_entry_with_p256(
  self_addr: ContractAddress, pk: Secp256r1Point, policy: WebAuthnPolicy,
  epoch: Uint<32>, counter: Uint<64>
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, WebAuthnPolicy, Uint<32>, Uint<64>]>([
    pad(32, "midnight:account:device:r1:v2"), self_addr,
    secp256r1PointX(pk) as Bytes<32>, secp256r1PointY(pk) as Bytes<32>, policy, epoch, counter
  ]);
}

export circuit activate_initial_device_with_p256(
  pk: Secp256r1Point, salt: Bytes<32>, policy: WebAuthnPolicy
): [] {
  assert(!booted, "already activated");
  // Point-coordinate extraction rejects identity; foreign point inputs are
  // constrained by the native curve type. P-256 has cofactor one.
  assert(derive_boot_commitment_with_p256(salt, pk, policy) == boot, "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_p256(kernel.self(), pk, policy, device_epoch, 0));
}

circuit require_authorised_with_p256(auth: P256Auth, challenge: Bytes<32>): [] {
  const entry = disclose(derive_device_entry_with_p256(
    kernel.self(), auth.pk, auth.policy, device_epoch, auth.use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  assert(webauthn_verify(challenge, auth.policy, auth.authenticator_data, auth.sig, auth.pk),
         "invalid WebAuthn signature");
  devices.remove(entry);
  devices.insert(disclose(derive_device_entry_with_p256(
    kernel.self(), auth.pk, auth.policy, device_epoch, (auth.use_counter + 1) as Uint<64>
  )));
  auth_nonce = (auth_nonce + 1) as Uint<64>;
  bump_round();
}

// Field-aligned tuples flatten in declaration order. The generic argument
// tuple below preserves the byte recipe of the other ECDSA arm with r1 DSTs.
circuit p256_device_challenge<T>(
  tag: Bytes<64>, self_addr: ContractAddress, pk: Secp256r1Point,
  args: T, nonce_value: Uint<64>
): Bytes<32> {
  return persistentHash<[Bytes<32>, ContractAddress, Bytes<32>, Bytes<32>, T, Uint<64>]>([
    persistentHash<[Bytes<64>]>([tag]), self_addr,
    secp256r1PointX(pk) as Bytes<32>, secp256r1PointY(pk) as Bytes<32>, args, nonce_value
  ]);
}

export pure circuit challenge_withdraw_unshielded_with_p256(
  self_addr: ContractAddress, pk: Secp256r1Point, color: Bytes<32>, amount: Uint<128>,
  recipient: UserAddress, nonce_value: Uint<64>
): Bytes<32> {
  return p256_device_challenge<[Bytes<32>, Uint<128>, UserAddress]>(
    pad(64, "midnight:account:auth:r1:v1:withdraw_unshielded"), self_addr, pk,
    [color, amount, recipient], nonce_value);
}

export pure circuit challenge_withdraw_shielded_with_p256(
  self_addr: ContractAddress, pk: Secp256r1Point, recipient: ZswapCoinPublicKey,
  color: Bytes<32>, amount: Uint<128>, coin: QualifiedShieldedCoinInfo, nonce_value: Uint<64>
): Bytes<32> {
  return p256_device_challenge<[ZswapCoinPublicKey, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo]>(
    pad(64, "midnight:account:auth:r1:v1:withdraw_shielded"), self_addr, pk,
    [recipient, color, amount, coin], nonce_value);
}

export pure circuit challenge_withdraw_shielded_to_contract_with_p256(
  self_addr: ContractAddress, pk: Secp256r1Point, recipient: ContractAddress,
  color: Bytes<32>, amount: Uint<128>, coin: QualifiedShieldedCoinInfo, nonce_value: Uint<64>
): Bytes<32> {
  return p256_device_challenge<[ContractAddress, Bytes<32>, Uint<128>, QualifiedShieldedCoinInfo]>(
    pad(64, "midnight:account:auth:r1:v1:withdraw_shielded_to_contract"), self_addr, pk,
    [recipient, color, amount, coin], nonce_value);
}

export pure circuit challenge_append_inbox_with_p256(
  self_addr: ContractAddress, pk: Secp256r1Point, entry: Bytes<192>, nonce_value: Uint<64>
): Bytes<32> {
  return p256_device_challenge<Bytes<192>>(
    pad(64, "midnight:account:auth:r1:v1:append_inbox"), self_addr, pk, entry, nonce_value);
}

export pure circuit challenge_rotate_enc_key_with_p256(
