// ---------------------------------------------------------------------------
// Arm `sol_ed25519`: a Solana wallet as a device and as a grantee, included by
// account.compact. All custody, grant-scope and recovery mutations use the
// existing shared chips.
//
// SCHEME. RFC 8032 PureEdDSA over edwards25519 (Ed25519), the scheme of
// every Solana wallet. A wallet signs the approval text in one of two
// formats (modules/SolanaFormats), each a fixed 50-byte head followed by the
// same text: raw, what `signMessage` signs (Phantom and other software
// wallets), the head being a line that names the format; or off-chain
// message v1, what hardware wallets (Ledger, Trezor) and
// `signOffchainMessage` sign, the head being the Solana off-chain envelope
// that names the signing key. The authorisation's flag `offchain` selects
// the format. It is a private input and never disclosed, so one circuit
// serves both formats and the chain does not learn which kind of wallet
// signed; a device is its key, whatever the format it signs in (IDENTITY
// below). Verification is the Ed25519 core's `ed25519_verify<T>`
// (modules/Ed25519Core: the standard library's `ed25519Verify<#n>` with R's
// and A's encodings taken from checked inputs instead of byte explosions,
// and R = O refused, which the standard library accepts), over head || text.
//
// IDENTITY. The device is the wallet's public key A. The circuit takes A as a
// `Curve25519Point`, whose type admits only points of the prime-order
// subgroup (ZKIR `FromCoordinates` is unsatisfiable outside it, and the
// runtime refuses such points at the type boundary), together with the
// 32-byte RFC 8032 encoding the wallet exports (section 5.1.2: y
// little-endian, the low bit of x in bit 255) and the x-coordinate's 32 bytes
// little-endian, both checked in-circuit against the point. Entries, boot
// commitments and grant ids bind those 32 bytes, never the point's internal
// form, so the identity a person compares with the wallet is exactly the one
// hashed.
//
// BLIND. The 32 bytes are public (they are the Solana address),
// so every entry and grant id also binds the account's blind, a per-account
// secret the client re-derives from the wallet's signature over a readable,
// non-authorising request message (src/wallet/blind.ts):
//   blind    = SHA-256(pad32("midnight:account:blind:sol:v1") || signature(64))
//   entry    = SHA-256(pad32("midnight:account:device:sol:v1") || account
//                      || key(32) || blind(32) || le4(epoch) || le8(counter))
//   boot     = SHA-256(pad32("midnight:account:boot:sol:v1") || salt
//                      || key(32) || blind(32))
//   grant id = SHA-256(pad32("midnight:account:grant:id:sol:v1") || account
//                      || key(32) || blind(32) || origin_hash || le1(slot))
// These are the shared module's ed25519-class recipes
// (modules/WalletArmDescriptors), so a device of any readable arm derives
// exactly the same entry for a `sol_ed25519` target from its point.
//
// KEY ADMISSIBILITY (SOL-ED25519.md, section 1).
//   - canonical y < p, on the curve: the client decodes the wallet's 32 bytes
//     strictly before they become a point; the circuit compares the bytes it
//     is given with the canonical bytes of the point's coordinates, so only
//     the canonical encoding passes;
//   - prime-order subgroup (small-order and mixed-order keys): the point type
//     (runtime type check; ZKIR FromCoordinates at the prover);
//   - A != O: the descriptor module's ed25519 class asserts it on every
//     derivation (the identity is the only prime-order point whose
//     x-coordinate is zero); the Ed25519 core's `ed25519_verify` asserts the
//     same on every verification.
// ---------------------------------------------------------------------------

import "modules/Ed25519Core";
import "modules/SolanaFormats";
import "modules/WalletArmDescriptors";
import "modules/WalletArmRendering";

// ── The 32-byte key and the derivations (the descriptor module's ed25519
//    class) ──────────────────────────────────────────────────────────────
//
// The key's 32-byte RFC 8032 encoding is the Ed25519 core's one shared
// function, encode_public_key_ed25519 (y little-endian, x's parity in bit
// 255; for a point of the prime-order subgroup the one canonical encoding a
// strict decoder accepts). It takes the point with the encoding's bytes
// (`pk_bytes`) and the x-coordinate's bytes little-endian (`pk_x`) as inputs
// and checks both against the point, so no byte is taken out of a point
// in-circuit. Every derivation of this arm, the seam's included, goes
// through the descriptor module's ed25519 class, which takes those three
// inputs, asserts A != O, checks the encoding with the core's checked
// encoding, and returns the key with the derived value: enrolment, removal,
// grants and signing use one encoding of one key.
// Exported for clients, with the core's derivation of a key from an RFC 8032
// seed (compute_public_key_ed25519), which software signers and tests use.
export { encode_public_key_ed25519, compute_public_key_ed25519 };

export pure circuit derive_boot_commitment_with_sol_ed25519(
  salt:     Bytes<32>,
  pk:       Curve25519Point,
  pk_bytes: Vector<32, Uint<8>>,
  pk_x:     Vector<32, Uint<8>>,
  blind:    Bytes<32>,
): Bytes<32> {
  return derive_descriptor_boot_ed25519(boot_tag_sol_ed25519(), salt, pk, pk_bytes, pk_x, blind)[1];
}

export pure circuit derive_device_entry_with_sol_ed25519(
  self_addr: ContractAddress,
  pk:        Curve25519Point,
  pk_bytes:  Vector<32, Uint<8>>,
  pk_x:      Vector<32, Uint<8>>,
  blind:     Bytes<32>,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return derive_descriptor_entry_ed25519(device_tag_sol_ed25519(), self_addr, pk, pk_bytes, pk_x, blind, epoch, counter)[1];
}

export pure circuit derive_grant_id_with_sol_ed25519(
  self_addr:   ContractAddress,
  pk:          Curve25519Point,
  pk_bytes:    Vector<32, Uint<8>>,
  pk_x:        Vector<32, Uint<8>>,
  blind:       Bytes<32>,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): Bytes<32> {
  return derive_descriptor_grant_id_ed25519(grant_id_tag_sol_ed25519(), self_addr, pk, pk_bytes, pk_x, blind, origin_hash, slot)[1];
}

// The blind from the wallet's raw 64-byte signature over the request message
// (src/wallet/blind.ts). Computed by the client, before an account exists;
// exported so that every implementation reproduces it with the contract's
// own toolchain. No circuit accepts the request message as an authorisation.
export pure circuit derive_blind_with_sol_ed25519(signature: Bytes<64>): Bytes<32> {
  return derive_blind(blind_tag_sol_ed25519(), signature);
}

// ── Bootstrap ───────────────────────────────────────────────────────────────

// Permissionless, as every arm's activation: the boot commitment binds the
// key and the blind, so only the committed device can be activated, and the
// caller learns nothing it did not already hold.
export circuit activate_initial_device_with_sol_ed25519(
  pk:       Curve25519Point,
  pk_bytes: Vector<32, Uint<8>>,
  pk_x:     Vector<32, Uint<8>>,
  salt:     Bytes<32>,
  blind:    Bytes<32>,
): [] {
  assert(!booted, "already activated");
  assert(derive_boot_commitment_with_sol_ed25519(salt, pk, pk_bytes, pk_x, blind) == boot, "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_sol_ed25519(
    kernel.self(), pk, pk_bytes, pk_x, blind, device_epoch, 0 as Uint<64>
  ));
}

// ── The device seam ─────────────────────────────────────────────────────────
//
// The authorising material of a device-gated call. Internal (as upstream's
// P256Auth): the generated JavaScript takes it as one object argument.
// `pk_bytes` and `pk_x` are the key's 32-byte RFC 8032 encoding and its
// x-coordinate little-endian; `r_bytes` and `r_x` the same for R (for an
// accepted signature, `r_bytes` is its first 32 bytes). Each pair is checked
// against its point by the Ed25519 core's checked encoding, so no byte is
// taken out of a point in-circuit. `offchain` names the format the signature
// is in (false: raw `signMessage`; true: off-chain message v1); it selects
// the signed head and is never disclosed.
struct SolEd25519Auth {
  pk:          Curve25519Point;
  pk_bytes:    Vector<32, Uint<8>>;
  pk_x:        Vector<32, Uint<8>>;
  blind:       Bytes<32>;
  use_counter: Uint<64>;
  offchain:    Boolean;
  sig:         Ed25519Signature;
  r_bytes:     Vector<32, Uint<8>>;
  r_x:         Vector<32, Uint<8>>;
}

// The seam owns everything that identifies the signer and the call's
// freshness: it derives the 32-byte key (and the current and next entries,
// from one encoding: the module's derive_signer_entries_ed25519 under this
// arm's device tag, which asserts A != O) from the point the signature is
// verified under, and renders the message's common frame itself — the
// first line, the account (kernel.self()), the signing key, and the
// auth_nonce line — around the title and body the gated circuit supplies. No
// gated circuit passes a key, an account, a nonce or a frame of its own.
//
// Then, in upstream p256's order: membership of the device's current
// single-use entry (bound to that key and the account's blind),
// verification by the Ed25519 core's ed25519_verify over the text in the
// format `auth.offchain` selects (modules/SolanaFormats: cofactorless
// [s]B == R + [k]A with k = SHA-512(R || A || head || text) mod L, A's
// encoding the key derived above, which is also the off-chain envelope's
// signer; it refuses A = O and R = O; s < L and the prime-order subgroup for
// A and R hold by type), the entry rolled to its successor,
// auth_nonce advanced, round bumped. Any failed assert aborts the
// whole call. Returns the caller's post-roll entry (remove_device's S13
// guard).
circuit require_authorised_with_sol_ed25519<#t, #b, #n>(
  title: Vector<t, Uint<8>>,
  body:  Vector<b, Uint<8>>,
  show:  SolShow,
  frame: SolFrame,
  auth:  SolEd25519Auth,
): Bytes<32> {
  const [key, current, successor] = derive_signer_entries_ed25519(device_tag_sol_ed25519(), kernel.self(), auth.pk, auth.pk_bytes,
    auth.pk_x, auth.blind, device_epoch, auth.use_counter);
  const text = sol_device_message<t, b, n>(kernel.self(), auth.pk_bytes, auth_nonce, title, body, show, frame);
  const entry = disclose(current);
  assert(devices.member(entry), "unknown device entry");
  const message = solana_signed_message<n>(auth.offchain, key, text);
  assert(ed25519_verify<SolanaSignedMessage<n>>(message, auth.sig, auth.pk, key, auth.r_bytes, auth.r_x), "invalid signature");
  devices.remove(entry);
  const next = disclose(successor);
  devices.insert(next);
  auth_nonce = (auth_nonce + 1) as Uint<64>;
  bump_round();
  return next;
}

// ── Gated circuits ──────────────────────────────────────────────────────────
//
// Arguments: the operation's operands, the message's display inputs (the
// operation's own, then `show`, `frame` and `hex`), then the authorisation.
// Each passes the seam only its circuit-fixed title and the body it renders
// from its operands.

export circuit rotate_enc_key_with_sol_ed25519(
  new_key: Bytes<32>,
  show:    SolShow,
  frame:   SolFrame,
  hex:     Vector<64, Uint<0..16>>,
  auth:    SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<37, 184, 491>(sol_title_rotate_enc_key(), sol_body_rotate_enc_key(new_key, hex), show, frame, auth);
  do_rotate_enc_key(new_key);
}

// ── Custody (MIP-0012) ──────────────────────────────────────────────────────
//
// Deposits are upstream's permissionless deposit_unshielded and
// deposit_shielded. Each export below renders its message from exactly the
// values it executes on (the operands, and for a shielded spend the coin the
// held_coin witness returned) and hands the seam only its title and body.

// The change-coin backfill (MIP-0012 §6.2): the approval shows the 192-byte
// InboxEntry v1 ciphertext in full, six lines of 64 hex digits.
export circuit append_inbox_with_sol_ed25519(
  entry: Bytes<192>,
  show:  SolShow,
  frame: SolFrame,
  hex:   Vector<384, Uint<0..16>>,
  auth:  SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<33, 510, 813>(sol_title_append_inbox(), sol_body_append_inbox(entry, hex), show, frame, auth);
  do_append_inbox(entry);
}

// Unshielded (MIP-0012 §5): the approval shows the token colour, the amount
// in base units with the site's label for it (marked as the site's claim),
// and the recipient's 32-byte user address; the mirror check and the send
// are the shared chip's.
export circuit withdraw_unshielded_with_sol_ed25519(
  color:     Bytes<32>,
  amount:    Uint<128>,
  recipient: UserAddress,
  a:         SolAmountShow,
  show:      SolShow,
  frame:     SolFrame,
  hex:       Vector<128, Uint<0..16>>,
  auth:      SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<38, 292, 600>(sol_title_withdraw_unshielded(),
    sol_body_withdraw_unshielded(color, amount, recipient, a, hex), show, frame, auth);
  do_withdraw_unshielded(color, amount, recipient);
}

// Shielded (MIP-0012 §6). The coin enters through the held_coin witness
// (never from ledger state), and the message is rendered from the coin the
// witness actually returned: it shows every value of it the spend consumes
// (the colour, as the Token line, the value, the nonce and the Merkle index)
// and the change that returns to this account (value - amount; the amount
// is bounded by the coin's value where the change is rendered). A valid
// signature over one coin therefore never spends another (AUTH-10).
//
// The colour is shown once, as `color`, so the export ASSERTS that the spent
// coin is of that colour: without it a
// dishonest prover could pair a valid signature over a coin of colour A with
// a witness coin of colour B carrying the same nonce, value and index.
export circuit withdraw_shielded_with_sol_ed25519(
  recipient: ZswapCoinPublicKey,
  color:     Bytes<32>,
  amount:    Uint<128>,
  a:         SolAmountShow,
  c:         SolCoinShow,
  show:      SolShow,
  frame:     SolFrame,
  hex:       Vector<192, Uint<0..16>>,
  auth:      SolEd25519Auth,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  require_authorised_with_sol_ed25519<36, 535, 841>(sol_title_withdraw_shielded(),
    sol_body_withdraw_shielded(recipient, color, amount, coin, a, c, hex), show, frame, auth);
  return do_withdraw_shielded(recipient, amount, coin);
}

// The contract-recipient spend: the direct-transfer mode of MIP-0012 §6.6
// (the output MUST be claimed by the receiving contract's deposit path in the
// same client-composed transaction; both addresses are public by design).
// The message shows the recipient contract's 32-byte address; the coin, the
// colour assert and the change are as above. Returns [sent, change].
export circuit withdraw_shielded_to_contract_with_sol_ed25519(
  recipient: ContractAddress,
  color:     Bytes<32>,
  amount:    Uint<128>,
  a:         SolAmountShow,
  c:         SolCoinShow,
  show:      SolShow,
  frame:     SolFrame,
  hex:       Vector<192, Uint<0..16>>,
  auth:      SolEd25519Auth,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  require_authorised_with_sol_ed25519<50, 531, 851>(sol_title_withdraw_shielded_to_contract(),
    sol_body_withdraw_shielded_to_contract(recipient, color, amount, coin, a, c, hex), show, frame, auth);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

// ── Device lifecycle (MIP-0013 §6) ──────────────────────────────────────────
//
// The other key is a readable DESCRIPTOR: the registered device tag of the
// target's kind and its key payload (an EVM target by its address and privacy
// salt, a Solana target by its 32-byte key and privacy salt, a k256 target by
// x, y and envelope, a passkey by x, y, its exact origin and the RP hash, a
// JubJub target by its point). The message shows exactly those values
// (coordinates in COORDINATE_DISPLAY_ORDER), and the circuit derives the
// target's entry from them with the recipe of the kind's key class
// (sol_kinds(); modules/WalletArmDescriptors). An unregistered tag is
// refused, so a descriptor never enrols an entry that no arm recognises by
// its tag.

// add_device derives at the CURRENT device_epoch and counter 0, never at a
// caller-chosen epoch or counter: this arm cannot plant an entry at
// device_epoch + 1 (README erratum 7), whatever the descriptor says.
export circuit add_device_with_sol_ed25519(
  target:    SolTarget,
  target_pk: SolKey,
  ts:        SolTargetShow,
  show:   SolShow,
  frame:  SolFrame,
  hex:    Vector<232, Uint<0..16>>,
  auth:   SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<24, 391, 685>(sol_title_add_device(), sol_body_add_device(target, target_pk.pk_bytes, ts, hex), show, frame, auth);
  do_add_device(sol_device_entry(target, target_pk, kernel.self(), device_epoch, 0 as Uint<64>));
}

// Two forms in one circuit, selected by `literal`:
//   - the target's descriptor with its use counter and epoch (removal only
//     reduces authority, so an explicit epoch is allowed: a device can evict
//     an entry an upstream arm's raw add_device planted at device_epoch + 1);
//     `entry` is then zero;
//   - the revocation-only literal entry, for an entry the wallet cannot
//     describe, shown in full under the fixed line "Removes a device this
//     wallet cannot identify"; the descriptor, counter and epoch are then
//     zero.
// The unused form's values are not shown, so each must be zero, and the
// literal form's display inputs must be those of an empty target (one
// encoding per call). Either way the caller's own post-roll entry can never be
// removed (AUTH-5, S13: do_remove_device's guard, the entry derived here as
// upstream's p256 arm derives it), nor the last device.
export circuit remove_device_with_sol_ed25519(
  literal:   Boolean,
  target:    SolTarget,
  target_pk: SolKey,
  counter:   Uint<64>,
  epoch:   Uint<32>,
  entry:   Bytes<32>,
  ts:      SolTargetShow,
  show:    SolShow,
  frame:   SolFrame,
  hex:     Vector<296, Uint<0..16>>,
  auth:    SolEd25519Auth,
): [] {
  const caller_entry = require_authorised_with_sol_ed25519<27, 464, 761>(sol_title_remove_device(),
    sol_body_remove_device(literal, target, target_pk.pk_bytes, counter, epoch, entry, ts, hex), show, frame, auth);
  const self_addr = kernel.self();
  if (literal) {
    assert(target.tag == pad(32, "") && target.address == pad(20, "") && target.a == pad(32, "") && target.b == pad(32, "")
             && target.c == pad(32, "") && target.origin == pad(21, "") && target.envelope == 0 && counter == 0 && epoch == 0
             && (curve25519PointX(target_pk.pk) as Bytes<32>) == pad(32, "")
             && Bytes[...target_pk.pk_bytes] == pad(32, "") && Bytes[...target_pk.pk_x] == pad(32, ""),
           "remove_device: a literal removal carries no descriptor");
  } else {
    assert(entry == pad(32, ""), "remove_device: a descriptor removal carries no literal entry");
  }
  // One ledger operation for both forms (a branch around it would disclose
  // the form); the descriptor's derivation and its checks apply only to the
  // descriptor form.
  do_remove_device(literal ? entry : sol_device_entry(target, target_pk, self_addr, epoch, counter), caller_entry);
}

// ── Scoped grants: the device role (the scoped-grants MIP) ──────────────────
//
// The device issues, revokes and revokes all grants through the device seam
// (over auth_nonce). The grantee is shown by its readable descriptor: its
// kind's key (an ed25519-class grantee as a point), the site label (or, for
// a k256 or JubJub grantee, the labelled origin hash; for a passkey, its
// exact origin) and the slot; the circuit derives the grant id from exactly
// those values with the grant-id recipe of the kind's key class
// (sol_kinds()). Every scope field is shown, the caller pin included (#176). The
// issue rules themselves are upstream's shared chip's.
//
// The delegate's read key is shown itself; the record stores its hash (the
// MIP's read_pk_hash), and zero when `read` is off, in which case the key
// must be zero too (nothing is stored that the wallet did not show). The passkey RP hash belongs to a passkey grantee and must be
// zero for every other grantee, so that no other hash-like value is shown.
// An absent caller pin must carry a zero address (upstream's caller
// commitment refuses any other encoding).
//
// The grant's scope salt is not an argument: the circuit derives it from
// the issuing device's blind (bound by the device entry the seam checks),
// the account and the auth_nonce the device signed, under the arm's salt
// tag (derive_grant_scope_salt). No proof builder can choose a public or a
// reused salt, so the grant's commitments stay hiding and each issuance has
// its own salt; the issuing client computes the same value and hands it to
// the grantee, which opens the commitments with it when it spends.
export circuit issue_grant_with_sol_ed25519(
  grantee:                          SolGrantee,
  grantee_pk:                       SolKey,
  op_withdraw_unshielded:           Boolean,
  op_withdraw_shielded:             Boolean,
  op_withdraw_shielded_to_contract: Boolean,
  read:                             Boolean,
  color:                            Bytes<32>,
  recipient_kind:                   Uint<8>,
  recipient:                        Bytes<32>,
  max_coin_value:                   Uint<128>,
  per_call_cap:                     Uint<128>,
  cap:                              Uint<128>,
  expires_at:                       Uint<64>,
  rp_id_hash:                       Bytes<32>,
  read_pk:                          Bytes<32>,
  window_len:                       Uint<64>,
  window_cap:                       Uint<128>,
  caller:                           Maybe<ContractAddress>,
  gs:                               SolGranteeShow,
  ss:                               SolScopeShow,
  show:                             SolShow,
  frame:                            SolFrame,
  hex:                              Vector<552, Uint<0..16>>,
  auth:                             SolEd25519Auth,
): [] {
  assert(read || read_pk == pad(32, ""), "sol_ed25519: a read key without read");
  assert(read_pk != pad(32, "") || !read, "sol_ed25519: read without a read key");
  const c = sol_grantee_kind(grantee.tag).key_class;
  assert(c == SolClass.passkey || rp_id_hash == pad(32, ""), "sol_ed25519: an RP hash belongs to a passkey grantee");
  // The RP hash is non-zero exactly when the grantee is a passkey AND the
  // scope can spend: upstream checks a grant's RP pin only
  // on the passkey spend path, so a read-only grant carries none and shows
  // "not applicable", and a spending passkey grant shows its real hash.
  const spends = op_withdraw_unshielded || op_withdraw_shielded || op_withdraw_shielded_to_contract;
  assert(c != SolClass.passkey || !spends || rp_id_hash != pad(32, ""), "sol_ed25519: a passkey grantee's RP hash is zero");
  assert(spends || rp_id_hash == pad(32, ""), "sol_ed25519: a read-only grant carries no RP hash");
  // Any recipient (kind 0) carries no recipient: the wallet
  // never shows a recipient that nothing enforces.
  assert(recipient_kind != 0 || recipient == pad(32, ""), "sol_ed25519: a recipient without a recipient kind");
  // before the seam advances auth_nonce: the value the device signed
  const self_addr = kernel.self();
  const scope_salt = derive_grant_scope_salt(salt_tag_sol_ed25519(), auth.blind, self_addr, auth_nonce);
  require_authorised_with_sol_ed25519<32, 1388, 1690>(sol_title_issue_grant(),
    sol_body_issue_grant(grantee, grantee_pk.pk_bytes, op_withdraw_unshielded, op_withdraw_shielded, op_withdraw_shielded_to_contract, read, color,
      recipient_kind, recipient, max_coin_value, per_call_cap, cap, expires_at, rp_id_hash, read_pk, window_len, window_cap,
      caller, gs, ss, hex), show, frame, auth);
  do_issue_grant(sol_grantee_id(grantee, grantee_pk, c, self_addr, sol_grantee_origin_hash(grantee, c)),
    op_withdraw_unshielded, op_withdraw_shielded, op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient,
    max_coin_value, per_call_cap, cap, expires_at, rp_id_hash, read ? persistentHash<Bytes<32>>(read_pk) : pad(32, ""),
    window_len, window_cap, caller, scope_salt);
}

// Revocation shows the grantee's descriptor; the grant id is re-derived.
export circuit revoke_grant_with_sol_ed25519(
  grantee:    SolGrantee,
  grantee_pk: SolKey,
  gs:         SolGranteeShow,
  show:       SolShow,
  frame:      SolFrame,
  hex:        Vector<232, Uint<0..16>>,
  auth:       SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<33, 427, 730>(sol_title_revoke_grant(), sol_body_revoke_grant(grantee, grantee_pk.pk_bytes, gs, hex), show, frame, auth);
  const c = sol_grantee_kind(grantee.tag).key_class;
  const self_addr = kernel.self();
  do_revoke_grant(sol_grantee_id(grantee, grantee_pk, c, self_addr, sol_grantee_origin_hash(grantee, c)));
}

export circuit revoke_all_grants_with_sol_ed25519(
  show:  SolShow,
  frame: SolFrame,
  auth:  SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<36, 63, 369>(sol_title_revoke_all_grants(), sol_body_revoke_all_grants(), show, frame, auth);
  do_revoke_all_grants();
}

// ── Recovery: the device role (recovery MIP §5, §6 step 5) ──────────────────
//
// The artefact-publishing session and the veto, through the device seam
// (over auth_nonce); the recovery gate itself (recover_submit,
// recover_finalise) is upstream's, arm-independent and unchanged. The
// session's approval shows every operand in full: the new recovery
// key's JubJub coordinates and the four backup vector values as 64 hex
// digits each, little-endian (upstream's Field and JubJub byte order), the session identifier, the vector length in decimal, and the
// 64-byte key wrap in two lines; under the circuit-fixed consequence line
// "sets this account's recovery key". The chip's own asserts (no
// pending recovery, the length and the zero slots, a fresh non-zero session
// identifier, a fresh live recovery key) are upstream's
// do_publish_recovery_session. Finalisation clears every device entry
// (upstream #183), sol entries included.
export circuit publish_recovery_session_with_sol_ed25519(
  new_recovery_pk: JubjubPoint,
  session_nonce:   Bytes<32>,
  phi_1:           Field,
  phi_2:           Field,
  phi_3:           Field,
  phi_4:           Field,
  phi_len:         Uint<8>,
  wrap:            Bytes<64>,
  phi_len_digits:  Vector<3, Uint<8>>,
  show:            SolShow,
  frame:           SolFrame,
  hex:             Vector<576, Uint<0..16>>,
  auth:            SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<38, 922, 1230>(sol_title_publish_recovery_session(),
    sol_body_publish_recovery_session(new_recovery_pk, session_nonce, phi_1, phi_2, phi_3, phi_4, phi_len, wrap, phi_len_digits, hex),
    show, frame, auth);
  do_publish_recovery_session(new_recovery_pk, session_nonce, phi_1, phi_2, phi_3, phi_4, phi_len, wrap);
}

// The veto (recovery MIP §6 step 5): any live device clears a pending
// recovery inside the window; the approval carries the frame and the
// circuit-fixed consequence line only (the operation has no operand).
export circuit recover_cancel_with_sol_ed25519(
  show:  SolShow,
  frame: SolFrame,
  auth:  SolEd25519Auth,
): [] {
  require_authorised_with_sol_ed25519<37, 64, 371>(sol_title_recover_cancel(), sol_body_recover_cancel(), show, frame, auth);
  do_recover_cancel();
}

// ── The grant seam (grantee role) ───────────────────────────────────────────
//
// A Solana key as a GRANTEE: its grant id is
//   H(pad32("midnight:account:grant:id:sol:v1") || account || key(32)
//     || blind(32) || origin_hash || le1(slot)),
// origin_hash = H(pad32("midnight:account:grant:origin:v1") || label(32)) of
// the 32-byte site label. The grantee signs the grantee-role message: the
// common frame (account, its own key, "Role: grantee of a scoped grant"),
// the operation, then the grant's label, slot, issued-at nonce and use
// nonce, never auth_nonce (GR-5): a grant call reads and advances
// only its record's nonce and never touches a device entry.
//
// As the device seam does, this seam owns the
// frame: it derives the key bytes from the point the signature is verified
// under, the grant id from that key, the blind and the label and slot the
// message shows, and takes issued_at and the nonce from the record itself.
// An export passes only its title and body, its operation (1 unshielded, 2
// shielded, 3 shielded to a contract), and the values the scope checks. The
// MIP's steps in order: identity (the record by id), liveness (active,
// epoch, generation, expiry), the spend scope (upstream's check_spend_scope),
// then the signature over the text in the format `auth.offchain` selects
// (modules/SolanaFormats; the Ed25519 core's ed25519_verify, which also
// refuses R = O), the record written back with its nonce advanced and the new
// spent commitment, and round bumped. As for a device, `offchain` is private
// and never disclosed.
struct SolEd25519GrantAuth {
  pk:       Curve25519Point;
  pk_bytes: Vector<32, Uint<8>>;
  pk_x:     Vector<32, Uint<8>>;
  blind:    Bytes<32>;
  label:    Bytes<32>;
  offchain: Boolean;
  sig:      Ed25519Signature;
  r_bytes:  Vector<32, Uint<8>>;
  r_x:      Vector<32, Uint<8>>;
}

circuit require_grant_with_sol_ed25519<#t, #b, #n>(
  title:            Vector<t, Uint<8>>,
  body:             Vector<b, Uint<8>>,
  show:             SolShow,
  g:                SolGrantShow,
  frame:            SolFrame,
  auth:             SolEd25519GrantAuth,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  op:               Uint<8>,
  obj_color:        Bytes<32>,
  amount:           Uint<128>,
  recipient_bytes:  Bytes<32>,
): [] {
  const self_addr = kernel.self();
  const [key, gid] = derive_descriptor_grant_id_ed25519(grant_id_tag_sol_ed25519(), self_addr, auth.pk, auth.pk_bytes, auth.pk_x, auth.blind,
    derive_grant_origin_hash_label(auth.label), slot);
  const id = disclose(gid);
  assert(grants.member(id), "unknown grant");
  const gr = grants.lookup(id);
  assert(gr.active, "grant revoked");
  assert(gr.epoch == device_epoch, "grant epoch stale");
  assert(gr.gen == grant_generation, "grant generation stale");
  assert(gr.scope.expires_at == (0 as Uint<64>) || kernel.blockTimeLessThan(gr.scope.expires_at), "grant expired");
  const admitted = op == 1 ? gr.scope.op_withdraw_unshielded
                 : op == 2 ? gr.scope.op_withdraw_shielded
                 : gr.scope.op_withdraw_shielded_to_contract;
  const new_spent = check_spend_scope(gr, admitted, scope_salt, obj_color, recipient_kind, pinned_recipient,
    max_coin_value, amount, spent_prev, op, recipient_bytes);
  const text = sol_grantee_message<t, b, n>(self_addr, auth.pk_bytes, auth.label, slot, gr.issued_at, gr.nonce, title, body, show, g, frame);
  const message = solana_signed_message<n>(auth.offchain, key, text);
  assert(ed25519_verify<SolanaSignedMessage<n>>(message, auth.sig, auth.pk, key, auth.r_bytes, auth.r_x), "invalid grant signature");
  grants.insert(id, GrantRecord {
    epoch:        gr.epoch,
    gen:          gr.gen,
    issued_at:    gr.issued_at,
    nonce:        ((gr.nonce + (1 as Uint<64>)) as Uint<64>),
    spent_commit: disclose(derive_grant_spent_commit(scope_salt, new_spent)),
    window_start: gr.window_start,
    window_spent: gr.window_spent,
    active:       gr.active,
    scope:        gr.scope
  });
  bump_round();
}

// ── Grant twins (grantee role) ──────────────────────────────────────────────
//
// Operation arguments first, then the grant opening in the order this arm's
// client passes it (signer.ts grantAuthArgs): the slot, scope_salt, the
// recipient kind and pin, the max coin value, the cumulative spend so far;
// then the message's display inputs and the grantee's authorisation (whose
// label is the grant's site label).

export circuit withdraw_unshielded_with_grant_sol_ed25519(
  color:            Bytes<32>,
  amount:           Uint<128>,
  recipient:        UserAddress,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  a:                SolAmountShow,
  show:             SolShow,
  g:                SolGrantShow,
  frame:            SolFrame,
  hex:              Vector<128, Uint<0..16>>,
  auth:             SolEd25519GrantAuth,
): [] {
  require_grant_with_sol_ed25519<52, 292, 726>(sol_title_withdraw_unshielded_with_grant(),
    sol_body_withdraw_unshielded_with_grant(color, amount, recipient, a, hex), show, g, frame, auth,
    slot, scope_salt, recipient_kind, pinned_recipient, max_coin_value, spent_prev, 1, color, amount, recipient.bytes);
  do_withdraw_unshielded(color, amount, recipient);
}

// The shielded twins: the spent coin (from the held_coin witness) is shown by
// its value, nonce and Merkle index under the approved colour (asserted),
// with the change; the change entry the grantee sealed to the live
// enc_key and that key are shown too, and the change entry is appended when
// the send produces change (INV-4 under a grant).
export circuit withdraw_shielded_with_grant_sol_ed25519(
  recipient:        ZswapCoinPublicKey,
  color:            Bytes<32>,
  amount:           Uint<128>,
  change_entry:     Bytes<192>,
  enc_pk:           Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  a:                SolAmountShow,
  c:                SolCoinShow,
  show:             SolShow,
  g:                SolGrantShow,
  frame:            SolFrame,
  hex:              Vector<640, Uint<0..16>>,
  auth:             SolEd25519GrantAuth,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  check_shielded_grant_bounds(coin, max_coin_value, enc_pk);
  require_grant_with_sol_ed25519<50, 1134, 1566>(sol_title_withdraw_shielded_with_grant(),
    sol_body_withdraw_shielded_with_grant(recipient, color, amount, change_entry, enc_pk, coin, a, c, hex), show, g, frame, auth,
    slot, scope_salt, recipient_kind, pinned_recipient, max_coin_value, spent_prev, 2, coin.color, amount, recipient.bytes);
  const result = do_withdraw_shielded(recipient, amount, coin);
  if (disclose(result.is_some)) {
    do_append_inbox(change_entry);
  }
  return result;
}

export circuit withdraw_shielded_to_contract_with_grant_sol_ed25519(
  recipient:        ContractAddress,
  color:            Bytes<32>,
  amount:           Uint<128>,
  change_entry:     Bytes<192>,
  enc_pk:           Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  a:                SolAmountShow,
  c:                SolCoinShow,
  show:             SolShow,
  g:                SolGrantShow,
  frame:            SolFrame,
  hex:              Vector<640, Uint<0..16>>,
  auth:             SolEd25519GrantAuth,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  check_shielded_grant_bounds(coin, max_coin_value, enc_pk);
  require_grant_with_sol_ed25519<64, 1130, 1576>(sol_title_withdraw_shielded_to_contract_with_grant(),
    sol_body_withdraw_shielded_to_contract_with_grant(recipient, color, amount, change_entry, enc_pk, coin, a, c, hex), show, g, frame, auth,
    slot, scope_salt, recipient_kind, pinned_recipient, max_coin_value, spent_prev, 3, coin.color, amount, recipient.bytes);
  const [sent, change] = do_withdraw_shielded_to_contract(recipient, amount, coin);
  if (disclose(change.is_some)) {
    do_append_inbox(change_entry);
  }
  return [sent, change];
}

// ── Signed messages, format sol v1 ──────────────────────────────────────────
//
// Every gated circuit renders its approval text from the values it executes
// on, and verifies the wallet's signature over exactly that text after the
// head of the authorisation's format (modules/SolanaFormats), so the text is
// what the wallet shows: a raw `signMessage` wallet shows the head's line,
// then the text; an off-chain wallet shows the text of its envelope. The
// text's grammar:
//
//   Midnight Passport approval (sol v1)       circuit-fixed first line
//   Operation: <title>                        fixed per circuit
//   Site: <label>                             the site's words, marked as such
//   Role: device of this account              or: grantee of a scoped grant
//   Account: <64 hex>                         the account's contract address
//   Signing key: <base58, 44>                 the signer's Ed25519 key as
//                                             Solana wallets show it
//   <operation lines>                         every operand and consumed
//                                             witness value, in full
//   Consequence: <...>                        fixed, on authority-granting
//                                             operations
//   Device nonce: <decimal>                   device role: auth_nonce
//   Grant label/slot/issued at/use nonce      grantee role: the grant's
//                                             identity and freshness
//
// Rules: printable ASCII and LF only; every line starts with circuit-fixed
// text; nothing the site chooses can contain a line break or start a line;
// values are shown in full (hex: two lowercase digits per byte, in full;
// decimals: every digit, left-aligned and space-padded to the type's width;
// a Solana key: its base58 text, left-aligned and space-padded to 44 bytes;
// a grant's expiry also as a UTC date, and a zero window as words; so each
// layout has one fixed length); no digest, fingerprint or truncation. The two site-chosen texts are the label after "Site: " and, on
// a moved amount, the decimal point and symbol after "This site labels it: ";
// both are checked for shape, and neither can move value. The only hash-like
// values ever shown are these four, each under its fixed label: a
// k256/jubjub grantee's origin hash ("Grantee site label (hash)"), a
// passkey's RP hash ("Passkey RP (hash)"), a target's or a grantee's blind
// ("Device privacy salt", "Grantee privacy salt"), and the literal entry of a
// revocation-only removal. Enumerated values (a recipient kind, a k256
// envelope) are shown as the rendering module's fixed labels.
//
// DISPLAY INPUTS. Compact has no division and turning bytes into characters
// is expensive in-circuit, so the caller supplies every text the circuit
// cannot cheaply derive: decimal digits, hex nibbles, base58 digits with
// their read-back hints, a date's text with its year split, the label and
// origin characters. Each is CHECKED against the value it describes (digits
// read back to the value; nibbles and characters assemble to the value's
// bytes; base58 digits and dates by the base rendering module), so for each
// value exactly one input is valid and none adds freedom.
//
// No raw message (the raw head, then the text) can be read as a Solana
// transaction or off-chain message: it starts with "Midn" (77 105 100 110),
// as a legacy message header that claims 110 account keys, i.e. at least
// 3 + 1 + 110*32 + 32 + 1 = 3,557 bytes, and every raw message here is
// shorter, at most 50 + 1,690 = 1,740 bytes (and such a header never
// sanitizes: 105 read-only signers of 77); the first byte is below 0x80 (no
// versioned message) and is not 0xff (no off-chain envelope); as a signed
// transaction it would carry 77 signatures. An off-chain message is the
// off-chain envelope by design: it starts with the signing domain
// 0xff "solana offchain", which parses as no Solana message or transaction
// (as a message, a versioned message of version 127, which does not exist;
// as a transaction, a count of 14,847 signatures, far more bytes than any
// message here). The length table is in SOL-ED25519.md.

// Every message: the site's label (32 characters, zero-padded; visible words
// separated by single spaces) and the decimal digits of the freshness nonce
// (auth_nonce for a device, the grant's nonce for a grantee).
export struct SolShow {
  site:  Vector<32, Uint<8>>;
  nonce: Vector<20, Uint<8>>;
}

// A 32-byte key's base58 text as Solana wallets show it: the base rendering
// module's display inputs (each character's base58 digit, 58 for padding,
// and the read-back hints), checked by base58_text_32 against the key's
// bytes.
export struct SolBase58 {
  digits: Vector<44, Uint<8>>;
  carry:  Uint<120>;
  low:    Uint<128>;
  top:    Uint<16>;
}

// The common frame's display inputs: the account's hex nibbles and the
// signing key's base58 text.
export struct SolFrame {
  account: Vector<64, Uint<0..16>>;
  key:     SolBase58;
}

// A grantee's identity and freshness: the characters of its grant label
// (checked against the label bytes the grant id binds), the slot and
// issued_at in decimal.
export struct SolGrantShow {
  label:  Vector<32, Uint<8>>;
  slot:   Vector<3, Uint<8>>;
  issued: Vector<20, Uint<8>>;
}

// A moved amount: its base units in decimal, and the site's label for it:
// "<the same digits with the site's decimal point> <symbol>".
export struct SolAmountShow {
  units: Vector<39, Uint<8>>;
  claim: Vector<49, Uint<8>>;
}

// A spent shielded coin: its value, Merkle index and the change, in decimal.
export struct SolCoinShow {
  value:  Vector<39, Uint<8>>;
  index:  Vector<20, Uint<8>>;
  change: Vector<39, Uint<8>>;
}

// A readable target (add_device, remove_device): the registered device tag
// of its kind and the key payload of the kind's key class (SolClass, which
// lists the fields each class uses). An ed25519-class target is also a
// POINT with its checked byte inputs (SolKey), passed beside the struct to
// the gated circuits: `a` must be its 32-byte encoding, checked in-circuit
// with A != O by the same function the seam uses for the signing key, so the
// key enrolled is a key that can sign; any other class passes the identity
// with zero bytes. Fields a class does not use must be zero, so each target
// has one encoding.
export struct SolTarget {
  tag:      Bytes<32>;
  address:  Bytes<20>;
  a:        Bytes<32>;
  b:        Bytes<32>;
  c:        Bytes<32>;
  origin:   Bytes<21>;
  envelope: Uint<8>;
}

// An ed25519-class target's or grantee's key as the gated circuits take it:
// the point, the key's 32-byte RFC 8032 encoding and its x-coordinate
// little-endian, both byte vectors checked against the point by the Ed25519
// core's checked encoding. Any other class passes the identity and zero
// bytes. Internal, as SolEd25519Auth: the generated JavaScript takes it as one
// object argument.
struct SolKey {
  pk:       Curve25519Point;
  pk_bytes: Vector<32, Uint<8>>;
  pk_x:     Vector<32, Uint<8>>;
}

// A target's display inputs: the digits of the removal's use counter and
// epoch, the characters of a passkey origin, and the base58 digits and
// read-back hints of an ed25519-class target's key (those of 32 zero bytes
// for every other class). (A k256 envelope is shown as a circuit-fixed label.)
export struct SolTargetShow {
  counter:  Vector<20, Uint<8>>;
  epoch:    Vector<10, Uint<8>>;
  origin:   Vector<21, Uint<8>>;
  key:      SolBase58;
}

// A grantee (issue_grant, revoke_grant): the grant-id recipe of its kind's
// key class binds (key, origin_hash, slot); an ed25519-class grantee is also
// a point, as a target is, and a passkey grantee binds its key only (its RP
// is a scope field). origin_hash: a readable grantee's 32-byte label (shown
// as text), a passkey's 21-byte origin (shown as text), or, for k256 and
// JubJub grantees, the labelled hash itself.
export struct SolGrantee {
  tag:         Bytes<32>;
  address:     Bytes<20>;
  a:           Bytes<32>;
  b:           Bytes<32>;
  envelope:    Uint<8>;
  label:       Bytes<32>;
  origin:      Bytes<21>;
  origin_hash: Bytes<32>;
  slot:        Uint<8>;
}

// A grantee's display inputs: the digits of its slot, the characters of its
// label and of a passkey origin, and the base58 digits and read-back hints of
// an ed25519-class grantee's key (those of 32 zero bytes for every other
// class).
export struct SolGranteeShow {
  slot:     Vector<3, Uint<8>>;
  label:    Vector<32, Uint<8>>;
  origin:   Vector<21, Uint<8>>;
  key:      SolBase58;
}

// A grant scope's display inputs (issue_grant): the digits of its amounts,
// caps and expiry, the expiry's UTC text with its checked year split, and the
// digits of the window length and cap.
export struct SolScopeShow {
  max_coin:      Vector<39, Uint<8>>;
  per_call:      Vector<39, Uint<8>>;
  cap:           Vector<39, Uint<8>>;
  expires:       Vector<20, Uint<8>>;
  expires_utc:   Vector<29, Uint<8>>;
  expires_split: Vector<4, Uint<8>>;
  window:        Vector<20, Uint<8>>;
  window_cap:    Vector<39, Uint<8>>;
}

// ── Pieces ──────────────────────────────────────────────────────────────────

// A zero-padded label's characters, shown with the zero bytes as spaces: one
// or more words of visible characters (0x21..0x7e) separated by single
// spaces, then zero bytes only; it starts with a visible character and never
// ends with a space, so the display is one-to-one (the shared module's
// label_text, over characters instead of Bytes).
circuit sol_label_chars(v: Vector<32, Uint<8>>): Vector<32, Uint<8>> {
  const r = fold((s: [Boolean, Boolean, Boolean], c: Uint<8>): [Boolean, Boolean, Boolean] => {
    const zero = c == 0;
    const space = c == 32;
    const shown = c >= 33 && c <= 126;
    const fits = s[1] ? zero : zero ? !s[0] : shown || (space && !s[0]);
    return [space, s[1] || zero, s[2] && fits];
  }, [true, false, true], v);
  assert(r[2] && !r[0], "display: not a zero-padded label");
  return map((c: Uint<8>): Uint<8> => (c == 0 ? 32 : c) as Uint<8>, v);
}

// "Midnight Passport approval (sol v1)" and LF.
circuit sol_first_line(): Vector<36, Uint<8>> {
  return [...pad(35, "Midnight Passport approval (sol v1)"), 10];
}

// n spaces.
circuit sol_spaces<#n>(): Vector<n, Uint<8>> {
  return map((c: Uint<8>): Uint<8> => (c + 32) as Uint<8>, default<Vector<n, Uint<8>>>);
}

// "yes" or "no " (3 bytes).
circuit sol_yes_no(b: Boolean): Vector<3, Uint<8>> {
  return map((y: Uint<8>, n: Uint<8>): Uint<8> => (b ? y : (n == 0 ? 32 : n)) as Uint<8>,
             pad(3, "yes") as Vector<3, Uint<8>>, pad(3, "no") as Vector<3, Uint<8>>);
}

// Characters checked against bytes (a passkey origin, a grant label).
circuit sol_chars21(b: Bytes<21>, v: Vector<21, Uint<8>>): Vector<21, Uint<8>> {
  assert(Bytes[...v] == b, "display: characters do not match the value");
  return v;
}
circuit sol_chars32(b: Bytes<32>, v: Vector<32, Uint<8>>): Vector<32, Uint<8>> {
  assert(Bytes[...v] == b, "display: characters do not match the value");
  return v;
}

// ── Enrolment kinds: the keys this arm enrols and grants to ─────────────────
//
// add_device and remove_device take a TARGET device, and issue_grant and
// revoke_grant a GRANTEE, as a readable descriptor whose tag names its KIND.
// sol_kinds() lists the kinds, one entry each: the kind's device tag, its
// grant-id tag and the class of its key. The class selects the descriptor
// fields the kind uses and the derivation circuit of
// modules/WalletArmDescriptors that derives its entry or grant id; the tag is
// shown as its own text. A tag that no entry lists is refused. Each kind also
// has its key lines, one row per kind in sol_kinds() order: in the device
// block (sol_device_block) and in the grantee block (sol_grantee_block).
//
// A kind of an existing class is added as its entry in sol_kinds(), its row
// in each of the two blocks and the count in SolKinds, which types every
// per-kind list, so a block without the new kind's row does not compile. The
// descriptor module admits a readable kind's tags once its arm is registered
// there (readable_arms()). The client lists the same kinds in the same order
// (SOL_KINDS, src/wallet/sol-ed25519-message.ts).

// The class of a kind's key: the descriptor fields it uses (every other
// field is zero) and how its entry and grant id are derived.
//   w52      a readable arm's 20-byte identity (`evm_k256`: the Ethereum
//            address) with the account's blind: address, a = blind
//   w64      a JubJub point: a = x_le, b = y_le
//   ed25519  a readable arm's Ed25519 key, by its point (SolKey) and its
//            32-byte encoding, with the account's blind: a = key, b = blind
//   w65      a secp256k1 key and its signing envelope: a = x_le, b = y_le,
//            envelope
//   passkey  a P-256 passkey: a = x_le, b = y_le; as a device also its
//            WebAuthn policy (c = rp_id_hash, origin: the w117 recipe); as a
//            grantee its key only (the w64 grant-id recipe), its origin_hash
//            derived from its exact origin (its RP hash is a scope field)
enum SolClass { w52, w64, ed25519, w65, passkey }

struct SolKind {
  device:    Bytes<32>;
  grant_id:  Bytes<32>;
  key_class: SolClass;
}

// The number of kinds: the length of sol_kinds() and of every per-kind list.
type SolKinds<T> = Vector<5, T>;

circuit sol_kinds(): SolKinds<SolKind> {
  return [
    SolKind { device: device_tag_evm_k256(),    grant_id: grant_id_tag_evm_k256(),    key_class: SolClass.w52 },
    SolKind { device: device_tag_jubjub(),      grant_id: grant_id_tag_jubjub(),      key_class: SolClass.w64 },
    SolKind { device: device_tag_sol_ed25519(), grant_id: grant_id_tag_sol_ed25519(), key_class: SolClass.ed25519 },
    SolKind { device: device_tag_k256(),        grant_id: grant_id_tag_k256(),        key_class: SolClass.w65 },
    SolKind { device: device_tag_p256(),        grant_id: grant_id_tag_p256(),        key_class: SolClass.passkey },
  ];
}

// The kind a tag names: one flag per entry of sol_kinds(), at most one of
// them set (the tags are distinct), and that kind's key class.
struct SolKindOf {
  hit:       SolKinds<Boolean>;
  key_class: SolClass;
}

// The flags of a target's (device) or a grantee's (grant id) tag, unchecked:
// none is set for a tag that no kind lists.
circuit sol_device_hits(tag: Bytes<32>): SolKinds<Boolean> {
  return map((k: SolKind): Boolean => tag == k.device, sol_kinds());
}
circuit sol_grantee_hits(tag: Bytes<32>): SolKinds<Boolean> {
  return map((k: SolKind): Boolean => tag == k.grant_id, sol_kinds());
}

circuit sol_any(hit: SolKinds<Boolean>): Boolean {
  return fold((any: Boolean, h: Boolean): Boolean => any || h, false, hit);
}

// The key class of the kind whose flag is set (the first kind's when none
// is, which the kind circuits below refuse).
circuit sol_kind_class(hit: SolKinds<Boolean>): SolClass {
  return fold((c: SolClass, h: Boolean, k: SolKind): SolClass => h ? k.key_class : c, sol_kinds()[0].key_class, hit, sol_kinds());
}

// The kind of a target's or a grantee's tag; an unregistered tag is refused.
circuit sol_device_kind(tag: Bytes<32>): SolKindOf {
  const hit = sol_device_hits(tag);
  assert(sol_any(hit), "descriptor: not a registered device tag");
  return SolKindOf { hit: hit, key_class: sol_kind_class(hit) };
}
circuit sol_grantee_kind(tag: Bytes<32>): SolKindOf {
  const hit = sol_grantee_hits(tag);
  assert(sol_any(hit), "descriptor: not a registered grant-id tag");
  return SolKindOf { hit: hit, key_class: sol_kind_class(hit) };
}

// The row of the kind whose flag is set, from one row per kind in
// sol_kinds() order. The choice starts from the first row (a choice between
// two equal rows costs nothing), so it costs one selection per byte for
// each further kind.
circuit sol_kind_row<#w>(hit: SolKinds<Boolean>, rows: SolKinds<Vector<w, Uint<8>>>): Vector<w, Uint<8>> {
  return fold((s: Vector<w, Uint<8>>, h: Boolean, r: Vector<w, Uint<8>>): Vector<w, Uint<8>> => h ? r : s, rows[0], hit, rows);
}

// Whether a class is a readable arm's: an identity with the account's
// blind, shown as a grantee with the grant's site label.
circuit sol_readable(c: SolClass): Boolean {
  return c == SolClass.w52 || c == SolClass.ed25519;
}

// The fields a class does not use must be zero (one encoding per target).
circuit sol_require_canonical_device(t: SolTarget, c: SolClass): [] {
  assert(c == SolClass.w52 || t.address == pad(20, ""), "descriptor: unused address must be zero");
  assert(c != SolClass.w52 || t.b == pad(32, ""), "descriptor: unused second field must be zero");
  assert(c == SolClass.passkey || t.c == pad(32, ""), "descriptor: unused rp hash must be zero");
  assert(c == SolClass.passkey || t.origin == pad(21, ""), "descriptor: unused origin must be zero");
  assert(c == SolClass.w65 || t.envelope == 0, "descriptor: unused envelope must be zero");
}

// A class other than ed25519 has no key point: it passes the identity and
// zero bytes (one encoding per target or grantee).
circuit sol_require_unused_key(k: SolKey, c: SolClass): [] {
  assert(c == SolClass.ed25519 || (curve25519PointX(k.pk) as Bytes<32>) == pad(32, ""), "descriptor: unused point must be the identity");
  assert(c == SolClass.ed25519 || (Bytes[...k.pk_bytes] == pad(32, "") && Bytes[...k.pk_x] == pad(32, "")),
         "descriptor: unused key bytes must be zero");
}

// The entry of a target device at (epoch, counter), by its kind's class.
// An ed25519-class target is its point with its checked bytes (`k`): the
// module's ed25519 class checks the bytes, derives the entry (A != O) and
// returns the key it encoded, which must be the key the message shows
// (`t.a`). Any other class carries the identity as its unused point (x = 0)
// and zero bytes.
circuit sol_device_entry(t: SolTarget, k: SolKey, self_addr: ContractAddress, epoch: Uint<32>, counter: Uint<64>): Bytes<32> {
  const c = sol_device_kind(t.tag).key_class;
  sol_require_canonical_device(t, c);
  sol_require_unused_key(k, c);
  // A passkey's own RP hash is never zero: the passkey device
  // block shows it in hex, and no zero value enrols or removes a passkey.
  assert(c != SolClass.passkey || t.c != pad(32, ""), "descriptor: a passkey's RP hash is zero");
  if (c == SolClass.w52) {
    return derive_descriptor_entry_w52(t.tag, self_addr, t.address, t.a, epoch, counter);
  }
  if (c == SolClass.w64) {
    return derive_descriptor_entry_w64(t.tag, self_addr, t.a, t.b, epoch, counter);
  }
  if (c == SolClass.ed25519) {
    const [key, entry] = derive_descriptor_entry_ed25519(t.tag, self_addr, k.pk, k.pk_bytes, k.pk_x, t.b, epoch, counter);
    assert(key == t.a, "descriptor: the Ed25519 key is not the point's encoding");
    return entry;
  }
  if (c == SolClass.w65) {
    return derive_descriptor_entry_w65(t.tag, self_addr, t.a, t.b, t.envelope, epoch, counter);
  }
  return derive_descriptor_entry_w117(t.tag, self_addr, t.a, t.b, t.c, t.origin, epoch, counter);
}

// The grantee's origin_hash by its kind's class, the unused fields zero.
circuit sol_grantee_origin_hash(t: SolGrantee, c: SolClass): Bytes<32> {
  assert(c == SolClass.w52 || t.address == pad(20, ""), "descriptor: unused address must be zero");
  assert(c != SolClass.w52 || t.b == pad(32, ""), "descriptor: unused second field must be zero");
  assert(c == SolClass.w65 || t.envelope == 0, "descriptor: unused envelope must be zero");
  const readable = sol_readable(c);
  assert(readable || t.label == pad(32, ""), "descriptor: unused label must be zero");
  assert(c == SolClass.passkey || t.origin == pad(21, ""), "descriptor: unused origin must be zero");
  if (readable) {
    assert(t.origin_hash == pad(32, ""), "descriptor: a readable grantee's origin hash is derived");
    return derive_grant_origin_hash_label(t.label);
  }
  if (c == SolClass.passkey) {
    assert(t.origin_hash == pad(32, ""), "descriptor: a passkey grantee's origin hash is derived");
    return derive_grant_origin_hash_origin(t.origin);
  }
  return t.origin_hash;
}

// An ed25519-class grantee is its point with its checked bytes, as such a
// target is (see sol_device_entry).
circuit sol_grantee_id(t: SolGrantee, k: SolKey, c: SolClass, self_addr: ContractAddress, origin_hash: Bytes<32>): Bytes<32> {
  sol_require_unused_key(k, c);
  if (c == SolClass.ed25519) {
    const [key, id] = derive_descriptor_grant_id_ed25519(t.tag, self_addr, k.pk, k.pk_bytes, k.pk_x, t.b, origin_hash, t.slot);
    assert(key == t.a, "descriptor: the Ed25519 key is not the point's encoding");
    return id;
  }
  if (c == SolClass.w52) {
    return derive_descriptor_grant_id_w52(t.tag, self_addr, t.address, t.a, origin_hash, t.slot);
  }
  if (c == SolClass.w65) {
    return derive_descriptor_grant_id_w65(t.tag, self_addr, t.a, t.b, t.envelope, origin_hash, t.slot);
  }
  return derive_descriptor_grant_id_w64(t.tag, self_addr, t.a, t.b, origin_hash, t.slot);
}


// ── Hex digits from checked nibble display inputs ───────────────────────────
//
// Turning a Bytes value into bytes costs about 140 rows per byte in-circuit
// (a chain of 8-bit divisions); assembling bytes costs a few rows per byte.
// So the caller passes, for every value a message shows in hex, its nibbles
// (high, then low, per byte, in the value's stored byte order): the circuit
// assembles the bytes from them and asserts they equal the value, then makes
// each digit with one comparison. Exactly one nibble vector assembles to a
// value, so the input adds no freedom; the decimal digits work the same way.

circuit sol_nib_digit(n: Uint<0..16>): Uint<8> {
  return (n < 10 ? (n as Uint<8>) + 48 : (n as Uint<8>) + 87) as Uint<8>;
}

circuit sol_nib_byte(hi: Uint<0..16>, lo: Uint<0..16>): Uint<8> {
  return ((hi as Uint<8>) * 16 + (lo as Uint<8>)) as Uint<8>;
}

circuit sol_hex20(b: Bytes<20>, n: Vector<40, Uint<0..16>>): Vector<40, Uint<8>> {
  assert(Bytes[sol_nib_byte(n[0], n[1]), sol_nib_byte(n[2], n[3]), sol_nib_byte(n[4], n[5]), sol_nib_byte(n[6], n[7]), sol_nib_byte(n[8], n[9]), sol_nib_byte(n[10], n[11]), sol_nib_byte(n[12], n[13]), sol_nib_byte(n[14], n[15]), sol_nib_byte(n[16], n[17]), sol_nib_byte(n[18], n[19]), sol_nib_byte(n[20], n[21]), sol_nib_byte(n[22], n[23]), sol_nib_byte(n[24], n[25]), sol_nib_byte(n[26], n[27]), sol_nib_byte(n[28], n[29]), sol_nib_byte(n[30], n[31]), sol_nib_byte(n[32], n[33]), sol_nib_byte(n[34], n[35]), sol_nib_byte(n[36], n[37]), sol_nib_byte(n[38], n[39])] == b, "display: hex digits do not match the value");
  return map(sol_nib_digit, n);
}

circuit sol_hex32(b: Bytes<32>, n: Vector<64, Uint<0..16>>): Vector<64, Uint<8>> {
  assert(Bytes[sol_nib_byte(n[0], n[1]), sol_nib_byte(n[2], n[3]), sol_nib_byte(n[4], n[5]), sol_nib_byte(n[6], n[7]), sol_nib_byte(n[8], n[9]), sol_nib_byte(n[10], n[11]), sol_nib_byte(n[12], n[13]), sol_nib_byte(n[14], n[15]), sol_nib_byte(n[16], n[17]), sol_nib_byte(n[18], n[19]), sol_nib_byte(n[20], n[21]), sol_nib_byte(n[22], n[23]), sol_nib_byte(n[24], n[25]), sol_nib_byte(n[26], n[27]), sol_nib_byte(n[28], n[29]), sol_nib_byte(n[30], n[31]), sol_nib_byte(n[32], n[33]), sol_nib_byte(n[34], n[35]), sol_nib_byte(n[36], n[37]), sol_nib_byte(n[38], n[39]), sol_nib_byte(n[40], n[41]), sol_nib_byte(n[42], n[43]), sol_nib_byte(n[44], n[45]), sol_nib_byte(n[46], n[47]), sol_nib_byte(n[48], n[49]), sol_nib_byte(n[50], n[51]), sol_nib_byte(n[52], n[53]), sol_nib_byte(n[54], n[55]), sol_nib_byte(n[56], n[57]), sol_nib_byte(n[58], n[59]), sol_nib_byte(n[60], n[61]), sol_nib_byte(n[62], n[63])] == b, "display: hex digits do not match the value");
  return map(sol_nib_digit, n);
}

circuit sol_hex64(b: Bytes<64>, n: Vector<128, Uint<0..16>>): Vector<128, Uint<8>> {
  assert(Bytes[sol_nib_byte(n[0], n[1]), sol_nib_byte(n[2], n[3]), sol_nib_byte(n[4], n[5]), sol_nib_byte(n[6], n[7]), sol_nib_byte(n[8], n[9]), sol_nib_byte(n[10], n[11]), sol_nib_byte(n[12], n[13]), sol_nib_byte(n[14], n[15]), sol_nib_byte(n[16], n[17]), sol_nib_byte(n[18], n[19]), sol_nib_byte(n[20], n[21]), sol_nib_byte(n[22], n[23]), sol_nib_byte(n[24], n[25]), sol_nib_byte(n[26], n[27]), sol_nib_byte(n[28], n[29]), sol_nib_byte(n[30], n[31]), sol_nib_byte(n[32], n[33]), sol_nib_byte(n[34], n[35]), sol_nib_byte(n[36], n[37]), sol_nib_byte(n[38], n[39]), sol_nib_byte(n[40], n[41]), sol_nib_byte(n[42], n[43]), sol_nib_byte(n[44], n[45]), sol_nib_byte(n[46], n[47]), sol_nib_byte(n[48], n[49]), sol_nib_byte(n[50], n[51]), sol_nib_byte(n[52], n[53]), sol_nib_byte(n[54], n[55]), sol_nib_byte(n[56], n[57]), sol_nib_byte(n[58], n[59]), sol_nib_byte(n[60], n[61]), sol_nib_byte(n[62], n[63]), sol_nib_byte(n[64], n[65]), sol_nib_byte(n[66], n[67]), sol_nib_byte(n[68], n[69]), sol_nib_byte(n[70], n[71]), sol_nib_byte(n[72], n[73]), sol_nib_byte(n[74], n[75]), sol_nib_byte(n[76], n[77]), sol_nib_byte(n[78], n[79]), sol_nib_byte(n[80], n[81]), sol_nib_byte(n[82], n[83]), sol_nib_byte(n[84], n[85]), sol_nib_byte(n[86], n[87]), sol_nib_byte(n[88], n[89]), sol_nib_byte(n[90], n[91]), sol_nib_byte(n[92], n[93]), sol_nib_byte(n[94], n[95]), sol_nib_byte(n[96], n[97]), sol_nib_byte(n[98], n[99]), sol_nib_byte(n[100], n[101]), sol_nib_byte(n[102], n[103]), sol_nib_byte(n[104], n[105]), sol_nib_byte(n[106], n[107]), sol_nib_byte(n[108], n[109]), sol_nib_byte(n[110], n[111]), sol_nib_byte(n[112], n[113]), sol_nib_byte(n[114], n[115]), sol_nib_byte(n[116], n[117]), sol_nib_byte(n[118], n[119]), sol_nib_byte(n[120], n[121]), sol_nib_byte(n[122], n[123]), sol_nib_byte(n[124], n[125]), sol_nib_byte(n[126], n[127])] == b, "display: hex digits do not match the value");
  return map(sol_nib_digit, n);
}

circuit sol_hex192(b: Bytes<192>, n: Vector<384, Uint<0..16>>): Vector<384, Uint<8>> {
  assert(Bytes[sol_nib_byte(n[0], n[1]), sol_nib_byte(n[2], n[3]), sol_nib_byte(n[4], n[5]), sol_nib_byte(n[6], n[7]), sol_nib_byte(n[8], n[9]), sol_nib_byte(n[10], n[11]), sol_nib_byte(n[12], n[13]), sol_nib_byte(n[14], n[15]), sol_nib_byte(n[16], n[17]), sol_nib_byte(n[18], n[19]), sol_nib_byte(n[20], n[21]), sol_nib_byte(n[22], n[23]), sol_nib_byte(n[24], n[25]), sol_nib_byte(n[26], n[27]), sol_nib_byte(n[28], n[29]), sol_nib_byte(n[30], n[31]), sol_nib_byte(n[32], n[33]), sol_nib_byte(n[34], n[35]), sol_nib_byte(n[36], n[37]), sol_nib_byte(n[38], n[39]), sol_nib_byte(n[40], n[41]), sol_nib_byte(n[42], n[43]), sol_nib_byte(n[44], n[45]), sol_nib_byte(n[46], n[47]), sol_nib_byte(n[48], n[49]), sol_nib_byte(n[50], n[51]), sol_nib_byte(n[52], n[53]), sol_nib_byte(n[54], n[55]), sol_nib_byte(n[56], n[57]), sol_nib_byte(n[58], n[59]), sol_nib_byte(n[60], n[61]), sol_nib_byte(n[62], n[63]), sol_nib_byte(n[64], n[65]), sol_nib_byte(n[66], n[67]), sol_nib_byte(n[68], n[69]), sol_nib_byte(n[70], n[71]), sol_nib_byte(n[72], n[73]), sol_nib_byte(n[74], n[75]), sol_nib_byte(n[76], n[77]), sol_nib_byte(n[78], n[79]), sol_nib_byte(n[80], n[81]), sol_nib_byte(n[82], n[83]), sol_nib_byte(n[84], n[85]), sol_nib_byte(n[86], n[87]), sol_nib_byte(n[88], n[89]), sol_nib_byte(n[90], n[91]), sol_nib_byte(n[92], n[93]), sol_nib_byte(n[94], n[95]), sol_nib_byte(n[96], n[97]), sol_nib_byte(n[98], n[99]), sol_nib_byte(n[100], n[101]), sol_nib_byte(n[102], n[103]), sol_nib_byte(n[104], n[105]), sol_nib_byte(n[106], n[107]), sol_nib_byte(n[108], n[109]), sol_nib_byte(n[110], n[111]), sol_nib_byte(n[112], n[113]), sol_nib_byte(n[114], n[115]), sol_nib_byte(n[116], n[117]), sol_nib_byte(n[118], n[119]), sol_nib_byte(n[120], n[121]), sol_nib_byte(n[122], n[123]), sol_nib_byte(n[124], n[125]), sol_nib_byte(n[126], n[127]), sol_nib_byte(n[128], n[129]), sol_nib_byte(n[130], n[131]), sol_nib_byte(n[132], n[133]), sol_nib_byte(n[134], n[135]), sol_nib_byte(n[136], n[137]), sol_nib_byte(n[138], n[13