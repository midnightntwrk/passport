// EVM / EIP-712 arm (`evm_k256`), included by account.compact. All custody,
// grant-scope and recovery mutations use the existing shared chips; this file
// adds the arm's identity, its derivations, its activation, its readable
// EIP-712 approvals and its seams.
//
// THE DEVICE IS ITS ETHEREUM ADDRESS, BLINDED. An ordinary Ethereum account
// (MetaMask, or any EIP-712 wallet) is the device. Its identity is the 20-byte
// Ethereum address of its key (keccak256 of the key's big-endian coordinates,
// low 20 bytes), the value the wallet shows, and every
// derivation binds it together with the account's BLIND, a 32-byte secret the
// client re-derives from a deterministic wallet signature over a readable,
// non-authorising request message (signed with `personal_sign`, so it can
// never be an EIP-712 authorisation):
//
//   entry    = H(pad32("midnight:account:device:evm:v1") || account
//                || address(20) || blind(32) || le4(epoch) || le8(counter))
//   boot     = H(pad32("midnight:account:boot:evm:v1") || salt
//                || address(20) || blind(32))
//   grant id = H(pad32("midnight:account:grant:id:evm:v1") || account
//                || address(20) || blind(32) || origin_hash || slot)
//
// (H = persistentHash = SHA-256 of the plain concatenation.) The recipes live
// in the shared descriptor module (modules/WalletArmDescriptors, width class
// 52), so that every readable arm derives an `evm_k256` target's entry
// exactly as this arm does. Without the blind, anyone could test a public
// address against every account's entries; with it, the ledger holds nothing
// a known address can be tested against. The blind is a private input of
// every proof and is never disclosed.
//
// THE ADDRESS IS ALWAYS DERIVED FROM THE PRESENTED POINT. Every path that
// admits a key (activation, the device seam and the grant seam) takes the
// secp256k1 point and derives the address itself (`evm_address`), and the
// point passes K256Core's key rule, which refuses the point at infinity by
// its COORDINATES, so that both encodings of the identity ({0, 0, identity}
// and {0, 0, not identity}) are refused, as upstream's
// `require_live_k256_key` does: activation calls the rule itself, and the
// seams through the verification (`k256_ecdsa_verify`). A caller can
// therefore never present an address it did not prove a key for.
//
// Tags: the arm hashes four tags, all registered in the descriptor module
// (`midnight:account:{device,boot,grant:id,blind}:evm:v1`).

import "modules/Ed25519Core";
import "modules/K256Core";
import "modules/EvmIdentity";
import "modules/WalletArmDescriptors";
import "modules/EvmK256";
import "modules/Eip712V1";

// The descriptor module's derivations, tags and registry of readable arms,
// re-exported as pure circuits of the account contract: a client derives any
// readable descriptor's entry, boot commitment, grant id, or grant scope salt
// through the account's own compiled module, and reads every registered
// readable arm's class and tags from readable_arms().
// Pure: no proving key, no deploy cost.
export {
  ReadableClass, ReadableArm, readable_arms,
  is_registered_device_tag, is_registered_boot_tag, is_registered_grant_id_tag,
  is_registered_blind_tag, is_registered_salt_tag,
  device_tag_jubjub, device_tag_k256, device_tag_p256,
  device_tag_evm_k256, device_tag_sol_ed25519,
  boot_tag_evm_k256, boot_tag_sol_ed25519,
  grant_id_tag_jubjub, grant_id_tag_k256, grant_id_tag_p256,
  grant_id_tag_evm_k256, grant_id_tag_sol_ed25519,
  blind_tag_evm_k256, blind_tag_sol_ed25519, grant_origin_tag,
  salt_tag_evm_k256, salt_tag_sol_ed25519,
  derive_descriptor_entry_w52, derive_descriptor_entry_w64,
  derive_descriptor_entry_w65, derive_descriptor_entry_w117,
  derive_descriptor_boot_w52,
  derive_descriptor_grant_id_w52, derive_descriptor_grant_id_w64,
  derive_descriptor_grant_id_w65,
  derive_descriptor_entry_ed25519, derive_descriptor_boot_ed25519, derive_descriptor_grant_id_ed25519,
  encode_public_key_ed25519,
  derive_grant_origin_hash_label, derive_grant_origin_hash_origin,
  derive_blind, derive_grant_scope_salt,
};

// The signing format (modules/Eip712V1): the fixed domain's type hash, name
// and version hashes, verifying contract and separator, and the digest,
// re-exported as pure oracles.
export {
  eip712_v1_domain_type_hash, eip712_v1_name_hash, eip712_v1_version_hash,
  eip712_v1_verifying_contract, eip712_v1_domain_separator, eip712_v1_digest,
};

// The arm's EIP-712 codec (modules/EvmK256, byte contract EVM-K256.md):
// the enrolment kinds, the descriptor hashes and derivations, and the struct
// hash of every operation, re-exported as pure oracles.
export {
  EvmK256Descriptor, EvmK256GranteeDescriptor,
  EvmK256Base58Hint, EvmK256DescriptorHint, EvmK256GranteeHint, EvmK256AmountHint, EvmK256CoinHint,
  EvmK256RemoveHint, EvmK256IssueHint,
  EvmK256Payload, EvmK256Kind, evm_k256_kinds, evm_k256_device_kind, evm_k256_grantee_kind,
  evm_k256_site_label_hash,
  evm_k256_device_descriptor_hash, evm_k256_descriptor_entry,
  evm_k256_ed25519_device_target, evm_k256_ed25519_grantee_target,
  evm_k256_grantee_origin_hash, evm_k256_grantee_grant_id, evm_k256_grantee_descriptor_hash,
  evm_k256_struct_withdraw_unshielded, evm_k256_struct_withdraw_shielded,
  evm_k256_struct_withdraw_shielded_to_contract, evm_k256_struct_append_inbox,
  evm_k256_struct_rotate_enc_key, evm_k256_struct_add_device, evm_k256_struct_remove_device,
  evm_k256_struct_remove_unknown_device, evm_k256_struct_issue_grant, evm_k256_struct_revoke_grant,
  evm_k256_struct_revoke_all_grants, evm_k256_struct_publish_recovery_session,
  evm_k256_struct_cancel_recovery, evm_k256_struct_withdraw_unshielded_as_grantee,
  evm_k256_struct_withdraw_shielded_as_grantee, evm_k256_struct_withdraw_shielded_to_contract_as_grantee,
};

// ── Keys ────────────────────────────────────────────────────────────────────

// Scalar-to-point on secp256k1, for software signers and degenerate-key
// vectors (MetaMask keys never reach a client as scalars: the client recovers
// the point from a wallet signature). The same curve as the k256 arm.
export pure circuit compute_public_point_with_evm_k256(scalar: Secp256k1Scalar): Secp256k1Point {
  return ecMulGenerator(scalar);
}

// The device's address (modules/EvmIdentity: the low 20 bytes of keccak256
// of the key's big-endian x || y; the point at infinity has none),
// re-exported as a pure circuit of the account contract, so that clients
// and tests obtain the address through the contract's own code.
export { evm_address };

// ── Derivations (width class 52 of the descriptor module) ──────────────────

export pure circuit derive_boot_commitment_with_evm_k256(
  salt:    Bytes<32>,
  address: Bytes<20>,
  blind:   Bytes<32>,
): Bytes<32> {
  return derive_descriptor_boot_w52(boot_tag_evm_k256(), salt, address, blind);
}

export pure circuit derive_device_entry_with_evm_k256(
  self_addr: ContractAddress,
  address:   Bytes<20>,
  blind:     Bytes<32>,
  epoch:     Uint<32>,
  counter:   Uint<64>,
): Bytes<32> {
  return derive_descriptor_entry_w52(device_tag_evm_k256(), self_addr, address, blind, epoch, counter);
}

export pure circuit derive_grant_id_with_evm_k256(
  self_addr:   ContractAddress,
  address:     Bytes<20>,
  blind:       Bytes<32>,
  origin_hash: Bytes<32>,
  slot:        Uint<8>,
): Bytes<32> {
  return derive_descriptor_grant_id_w52(grant_id_tag_evm_k256(), self_addr, address, blind, origin_hash, slot);
}

// ── Bootstrap ───────────────────────────────────────────────────────────────

// Permissionless, as on every arm: only the committed key can activate, so
// the circuit cannot be front-run to register a foreign key. The caller
// presents the device's POINT (recovered by the client from the blind-request
// signature), the boot salt, and the blind; the address is derived here.
export circuit activate_initial_device_with_evm_k256(
  pk:    Secp256k1Point,
  salt:  Bytes<32>,
  blind: Bytes<32>,
  hint:  EvmAddressHint,
): [] {
  assert(!booted, "already activated");
  k256_require_live_key(pk);
  const address = evm_address(pk, hint);
  assert(derive_boot_commitment_with_evm_k256(salt, address, blind) == boot,
         "boot commitment mismatch");
  do_activate_initial_device(derive_device_entry_with_evm_k256(
    kernel.self(), address, blind, device_epoch, 0 as Uint<64>
  ));
}

// ── The authorisation seam (device role) ────────────────────────────────────
//
// The authorising material of every device-gated circuit, its trailing
// argument (kept internal, as P256Auth is). `pk` is the device's point;
// `use_counter` and `blind` are the ledger-pinned openings of the device's
// rolling entry: the membership assert checks them, and they are never shown.
struct EvmK256Auth {
  pk:          Secp256k1Point;
  use_counter: Uint<64>;
  blind:       Bytes<32>;
  sig:         Secp256k1EcdsaSignature;
  hint:        EvmK256SeamHint;
}

// The checked byte hints of the device seam (see EvmAddressHint and the
// module's "Checked byte hints"): the key's; `digest`, the bytes of the
// EIP-712 digest; and `nonce`, auth_nonce little-endian.
struct EvmK256SeamHint {
  key:    EvmAddressHint;
  digest: Vector<32, Uint<8>>;
  nonce:  Vector<8, Uint<8>>;
}

// The device seam, in upstream p256's order (MIP-0013 §4): membership of the
// single-use entry at the active epoch, verification, the entry rolled to its
// successor, auth_nonce advanced, round bumped; any failure aborts the whole
// call.
//
// The seam owns the frame. An export passes only its operation's type hash
// and tail (from the module's `evm_k256_parts_*`, which the exported oracles
// use too). Each entry shape is one self-contained body:
// require_authorised_with_evm_k256 (one message type),
// require_authorised_with_evm_k256_either (remove_device's two forms, the
// second type when `second`) and require_authorised_with_evm_k256_bare (a
// type with no members of its own). Each body derives the address from
// auth.pk, builds the frame from kernel.self(), that address and
// auth_nonce (read before this call advances it), builds the struct hash,
// checks the entry, verifies the signature and rolls the entry. No circuit
// that checks or rolls a device entry takes an address, an account, a nonce
// or a struct hash from its caller, so an entry is matched, and a signature
// verified, only for the address of the key that signed.
//
// The verification (k256_ecdsa_verify) holds the acceptance rules: it
// refuses the point at infinity as the key and r = 0 or s = 0, and accepts
// both S forms (FIPS 186-5): the rolling entry, consumed by this call, makes
// a malleated twin single-use, as on the k256 arm.
//
// Each body returns the caller's post-roll entry (remove_device's S13 guard).
circuit require_authorised_with_evm_k256<T>(auth: EvmK256Auth, type_hash: Bytes<32>, tail: T): Bytes<32> {
  const address = evm_address(auth.pk, auth.hint.key);
  const struct_hash = evm_k256_device_struct<T>(type_hash, kernel.self().bytes, address, auth_nonce, auth.hint.nonce, tail);
  const entry = disclose(derive_device_entry_with_evm_k256(
    kernel.self(), address, auth.blind, device_epoch, auth.use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  assert(k256_ecdsa_verify(eip712_v1_digest(struct_hash), auth.hint.digest, auth.sig, auth.pk),
         "invalid signature");
  devices.remove(entry);
  const next = disclose(derive_device_entry_with_evm_k256(
    kernel.self(), address, auth.blind, device_epoch, (auth.use_counter + 1) as Uint<64>
  ));
  devices.insert(next);
  auth_nonce = (auth_nonce + 1) as Uint<64>;
  bump_round();
  return next;
}

circuit require_authorised_with_evm_k256_either<T, U>(
  auth: EvmK256Auth, second: Boolean, type_1: Bytes<32>, tail_1: T, type_2: Bytes<32>, tail_2: U
): Bytes<32> {
  const address = evm_address(auth.pk, auth.hint.key);
  const h1 = evm_k256_device_struct<T>(type_1, kernel.self().bytes, address, auth_nonce, auth.hint.nonce, tail_1);
  const h2 = evm_k256_device_struct<U>(type_2, kernel.self().bytes, address, auth_nonce, auth.hint.nonce, tail_2);
  const struct_hash = second ? h2 : h1;
  const entry = disclose(derive_device_entry_with_evm_k256(
    kernel.self(), address, auth.blind, device_epoch, auth.use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  assert(k256_ecdsa_verify(eip712_v1_digest(struct_hash), auth.hint.digest, auth.sig, auth.pk),
         "invalid signature");
  devices.remove(entry);
  const next = disclose(derive_device_entry_with_evm_k256(
    kernel.self(), address, auth.blind, device_epoch, (auth.use_counter + 1) as Uint<64>
  ));
  devices.insert(next);
  auth_nonce = (auth_nonce + 1) as Uint<64>;
  bump_round();
  return next;
}

// The device-role types with no members of their own (RevokeAllGrants,
// CancelRecovery): the frame alone.
circuit require_authorised_with_evm_k256_bare(auth: EvmK256Auth, type_hash: Bytes<32>): Bytes<32> {
  const address = evm_address(auth.pk, auth.hint.key);
  const struct_hash = evm_k256_device_struct_bare(type_hash, kernel.self().bytes, address, auth_nonce, auth.hint.nonce);
  const entry = disclose(derive_device_entry_with_evm_k256(
    kernel.self(), address, auth.blind, device_epoch, auth.use_counter
  ));
  assert(devices.member(entry), "unknown device entry");
  assert(k256_ecdsa_verify(eip712_v1_digest(struct_hash), auth.hint.digest, auth.sig, auth.pk),
         "invalid signature");
  devices.remove(entry);
  const next = disclose(derive_device_entry_with_evm_k256(
    kernel.self(), address, auth.blind, device_epoch, (auth.use_counter + 1) as Uint<64>
  ));
  devices.insert(next);
  auth_nonce = (auth_nonce + 1) as Uint<64>;
  bump_round();
  return next;
}

// ── Custody: the encryption key ─────────────────────────────────────────────

// RotateEncKey(bytes32 account,address device,uint64 authNonce,string effect,bytes32 newKey)
export circuit rotate_enc_key_with_evm_k256(new_key: Bytes<32>, auth: EvmK256Auth): [] {
  const [t, tail] = evm_k256_parts_rotate_enc_key(new_key);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<32>]>(auth, t, tail);
  do_rotate_enc_key(new_key);
}

// ── Custody: unshielded (MIP-0012 §5) ───────────────────────────────────────
//
// Deposits are upstream's permissionless deposit_unshielded. The approval
// shows the token colour, the amount in base units, and the recipient's
// 32-byte user address; the mirror check and the send are the shared chip's.

// WithdrawUnshielded(bytes32 account,address device,uint64 authNonce,bytes32 color,uint128 amount,string amountLabel,
//                    bytes32 recipient)
// (`amountLabel`: "This site labels it: " and the site's label for the
// amount, its digits checked against the amount)
export circuit withdraw_unshielded_with_evm_k256(
  color:     Bytes<32>,
  amount:    Uint<128>,
  recipient: UserAddress,
  auth:      EvmK256Auth,
  hint:      EvmK256AmountHint,
): [] {
  const [t, tail] = evm_k256_parts_withdraw_unshielded(color, amount, recipient.bytes, hint);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>]>(auth, t, tail);
  do_withdraw_unshielded(color, amount, recipient);
}

// ── Custody: shielded (MIP-0012 §6) ─────────────────────────────────────────
//
// Deposits are upstream's permissionless deposit_shielded. The coin enters
// through the held_coin witness (never from ledger state), and the approval
// shows every value of it the spend consumes: the colour (as `color`), the
// nonce, the value and the Merkle index, and the change that returns to this
// account (value - amount). The digest is recomputed from the coin the
// witness actually returned, so a valid signature over one coin can never
// spend another (AUTH-10).
//
// The colour is shown once, as `color`, and the export ASSERTS that the
// spent coin is of that colour: without it a
// dishonest prover could pair a valid signature over a coin of colour A with
// a witness coin of colour B carrying the same nonce, value and index. The
// amount is bounded by the coin's value before the change is computed.

// WithdrawShielded(bytes32 account,address device,uint64 authNonce,bytes32 color,uint128 amount,string amountLabel,
//                  bytes32 recipient,bytes32 coinNonce,uint128 coinValue,uint64 coinMerkleIndex,uint128 change)
export circuit withdraw_shielded_with_evm_k256(
  recipient: ZswapCoinPublicKey,
  color:     Bytes<32>,
  amount:    Uint<128>,
  auth:      EvmK256Auth,
  hint:      EvmK256CoinHint,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  assert(amount <= coin.value, "amount above the spent coin's value");
  const [t, tail] = evm_k256_parts_withdraw_shielded(color, amount, recipient.bytes, coin.nonce, coin.value, coin.mt_index, hint);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>,
                                      Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(auth, t, tail);
  return do_withdraw_shielded(recipient, amount, coin);
}

// The contract-recipient spend: the direct-transfer mode of MIP-0012 §6.6
// (the output MUST be claimed by the receiving contract's deposit path in the
// same client-composed transaction; both addresses are public by design).
// The approval shows the recipient contract's 32-byte address; the coin, the
// colour assert and the change are as above. Returns [sent, change].

// WithdrawShieldedToContract(bytes32 account,address device,uint64 authNonce,bytes32 color,uint128 amount,
//                            string amountLabel,bytes32 recipientContract,bytes32 coinNonce,uint128 coinValue,uint64 coinMerkleIndex,uint128 change)
export circuit withdraw_shielded_to_contract_with_evm_k256(
  recipient: ContractAddress,
  color:     Bytes<32>,
  amount:    Uint<128>,
  auth:      EvmK256Auth,
  hint:      EvmK256CoinHint,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  assert(amount <= coin.value, "amount above the spent coin's value");
  const [t, tail] = evm_k256_parts_withdraw_shielded_to_contract(color, amount, recipient.bytes,
    coin.nonce, coin.value, coin.mt_index, hint);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>,
                                      Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(auth, t, tail);
  return do_withdraw_shielded_to_contract(recipient, amount, coin);
}

// ── Custody: the inbox ──────────────────────────────────────────────────────
//
// The change-coin backfill (MIP-0012 §6.2), gated as on every arm. The
// approval shows the 192-byte InboxEntry v1 ciphertext in full, as `bytes`.

// AppendInbox(bytes32 account,address device,uint64 authNonce,bytes entry)
export circuit append_inbox_with_evm_k256(entry: Bytes<192>, auth: EvmK256Auth): [] {
  const [t, tail] = evm_k256_parts_append_inbox(entry);
  require_authorised_with_evm_k256<Bytes<32>>(auth, t, tail);
  do_append_inbox(entry);
}

// ── Device lifecycle (MIP-0013 §6) ──────────────────────────────────────────
//
// The other key is a readable DESCRIPTOR: the
// tag text of its enrolment kind and its key payload, in the form the kind's
// entry names (modules/EvmK256, "Enrolment kinds": an address and privacy
// salt; an Ed25519 key by its point (a Curve25519Point: its 32-byte key
// derived in-circuit, the identity refused) and privacy salt; x, y and an
// envelope; a passkey's x, y, exact origin and RP hash; a JubJub point). The
// approval shows exactly those values under the kind's own typed-data type,
// and the circuit derives the target's entry from them with the recipe of
// the kind's form (modules/WalletArmDescriptors). A tag of no registered
// kind is refused, so a descriptor can never enrol an entry that no arm
// recognises by its tag.
//
// add_device derives at the CURRENT device_epoch and counter 0, never at a
// caller-chosen epoch or counter: this arm cannot plant an entry at
// device_epoch + 1 (README erratum 7), whatever the descriptor says.

// AddDevice(bytes32 account,address device,uint64 authNonce,string effect,<Kind>Device newDevice)
export circuit add_device_with_evm_k256(
  new_device: EvmK256Descriptor, ed_pk: Curve25519Point, ed_bytes: Vector<32, Uint<8>>, ed_x: Vector<32, Uint<8>>,
  auth: EvmK256Auth, hint: EvmK256DescriptorHint
): [] {
  const ed_entry = evm_k256_ed25519_device_target(kernel.self(), new_device, ed_pk, ed_bytes, ed_x, device_epoch, 0 as Uint<64>)[1];
  const [t, tail] = evm_k256_parts_add_device(new_device, ed_bytes, hint);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<32>]>(auth, t, tail);
  do_add_device(evm_k256_descriptor_entry(kernel.self(), new_device, ed_entry, device_epoch, 0 as Uint<64>));
}

// Two forms in one circuit:
//   - the target's descriptor with its epoch and use counter (removal only
//     reduces authority, so an explicit epoch is allowed: a device can evict
//     an entry planted at device_epoch + 1 by an upstream arm's raw
//     add_device), approved as
//     RemoveDevice(bytes32 account,address device,uint64 authNonce,<Kind>Device target,uint32 targetEpoch,uint64 targetCounter);
//   - the revocation-only literal entry, for an entry the wallet cannot
//     describe (`unknown_entry` present), approved as
//     RemoveUnknownDevice(bytes32 account,address device,uint64 authNonce,string effect,bytes32 entry)
//     under the fixed line "Removes a device this wallet cannot identify".
//     The descriptor arguments are then unused (the client passes the zero
//     descriptor under the evm tag).
// Either way the caller's own post-roll entry can never be removed (AUTH-5,
// S13: do_remove_device's guard), nor the last device.
export circuit remove_device_with_evm_k256(
  target:         EvmK256Descriptor,
  ed_pk:          Curve25519Point,
  ed_bytes:       Vector<32, Uint<8>>,
  ed_x:           Vector<32, Uint<8>>,
  target_epoch:   Uint<32>,
  target_counter: Uint<64>,
  unknown_entry:  Maybe<Bytes<32>>,
  auth:           EvmK256Auth,
  hint:           EvmK256RemoveHint,
): [] {
  assert(unknown_entry.is_some || unknown_entry.value == default<Bytes<32>>, "noncanonical absent entry");
  const ed_entry = evm_k256_ed25519_device_target(kernel.self(), target, ed_pk, ed_bytes, ed_x, target_epoch, target_counter)[1];
  const [t1, tail1] = evm_k256_parts_remove_device(target, ed_bytes, target_epoch, target_counter, hint);
  const [t2, tail2] = evm_k256_parts_remove_unknown_device(unknown_entry.value);
  const caller_entry = require_authorised_with_evm_k256_either<[Bytes<32>, Bytes<28>, Bytes<4>, Bytes<24>, Bytes<8>], [Bytes<32>, Bytes<32>]>(
    auth, unknown_entry.is_some, t1, tail1, t2, tail2);
  const described = evm_k256_descriptor_entry(kernel.self(), target, ed_entry, target_epoch, target_counter);
  do_remove_device(unknown_entry.is_some ? unknown_entry.value : described, caller_entry);
}

// ── Scoped grants (the scoped-grants MIP) ───────────────────────────────────
//
// The device role issues, revokes and revokes all grants through the device
// seam (over auth_nonce). The grantee is shown by its readable descriptor,
// under its enrolment kind's typed-data type: the key, the site label (or,
// for a k256 or JubJub grantee, the labelled origin hash; for a passkey, its
// exact origin) and the slot; the circuit derives the grant id from exactly
// those values with the grant-id recipe of the kind's form. Every scope
// field is a member of the approval, the caller pin included (#176).

// IssueGrant(bytes32 account,address device,uint64 authNonce,string effect,<Kind>Grantee grantee,
//            bool withdrawUnshielded,bool withdrawShielded,bool withdrawShieldedToContract,bool read,bytes32 color,
//            string recipientKind,bytes32 recipient,uint128 maxCoinValue,uint128 perCallCap,uint128 cap,uint64 expiresAt,
//            string expiry,bytes32 passkeyRpHash,string passkeyRp,bytes32 readKey,uint64 windowLength,uint128 windowCap,
//            string window,bool callerPinned,bytes32 caller)
// (`recipientKind`, `passkeyRp` and `window` are circuit-fixed texts selected by
// the executed values; `expiry` is "never", the expiry's UTC date and time,
// checked against `expiresAt`, or the words for a time after 9999)
//
// The delegate's read key is shown itself; the record stores its SHA-256
// (the MIP's read_pk_hash), and zero when `read` is off, in which case the
// key must be zero too (nothing stored that the wallet did not show). The
// passkey RP hash is a passkey grantee's labelled value: non-zero exactly for
// a passkey grantee whose scope can spend (upstream checks the pin only on
// the passkey spend path) and zero otherwise, so that no unchecked hash-like
// value is ever shown. Recipient kind 0 ("any recipient") requires a zero
// recipient. The issue rules themselves are upstream's shared chip's.
//
// The grant's scope salt, which every commitment of the record hides its
// opening under, is not an argument: the circuit derives it from values the
// device seam authenticates in the same call, the issuing device's blind
// (bound by that device's entry), the account and the auth_nonce the device
// signed (the value the seam reads before advancing it). No one who builds
// the proof can choose it, and each issuance gets its own. The issuing client
// computes the same value and hands it to the grantee.
export circuit issue_grant_with_evm_k256(
  grantee:                          EvmK256GranteeDescriptor,
  ed_pk:                            Curve25519Point,
  ed_bytes:                         Vector<32, Uint<8>>,
  ed_x:                             Vector<32, Uint<8>>,
  op_withdraw_unshielded:           Boolean,
  op_withdraw_shielded:             Boolean,
  op_withdraw_shielded_to_contract: Boolean,
  read:                             Boolean,
  color:                            Bytes<32>,
  recipient_kind:                   Uint<8>,
  recipient:                        Bytes<32>,
  max_coin_value:                   Uint<128>,
  per_call_cap:                     Uint<128>,
  cap:                              Uint<128>,
  expires_at:                       Uint<64>,
  rp_id_hash:                       Bytes<32>,
  read_pk:                          Bytes<32>,
  window_len:                       Uint<64>,
  window_cap:                       Uint<128>,
  caller:                           Maybe<ContractAddress>,
  auth:                             EvmK256Auth,
  hint:                             EvmK256IssueHint,
): [] {
  const scope_salt = derive_grant_scope_salt(salt_tag_evm_k256(), auth.blind, kernel.self(), auth_nonce);
  assert(read || read_pk == pad(32, ""), "evm_k256: a read key without read");
  assert(read_pk != pad(32, "") || !read, "evm_k256: read without a read key");
  // The RP-hash rules and the "any recipient" rule are asserted in
  // evm_k256_parts_issue_grant, which builds what is shown.
  const oh = evm_k256_grantee_origin_hash(grantee);
  const ed_id = evm_k256_ed25519_grantee_target(kernel.self(), grantee, oh, ed_pk, ed_bytes, ed_x)[1];
  const [t, tail] = evm_k256_parts_issue_grant(grantee, ed_bytes, op_withdraw_unshielded, op_withdraw_shielded,
    op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient, max_coin_value, per_call_cap, cap,
    expires_at, rp_id_hash, read_pk, window_len, window_cap, caller, hint);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<32>,
                                      Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>,
                                      Bytes<32>, Bytes<32>, Bytes<32>,
                                      Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>,
                                      Bytes<24>, Bytes<8>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>, Bytes<32>,
                                      Bytes<31>, Bytes<1>, Bytes<32>]>(auth, t, tail);
  do_issue_grant(evm_k256_grantee_grant_id(kernel.self(), grantee, oh, ed_id), op_withdraw_unshielded, op_withdraw_shielded,
    op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient, max_coin_value, per_call_cap, cap,
    expires_at, rp_id_hash, read ? persistentHash<Bytes<32>>(read_pk) : pad(32, ""), window_len, window_cap,
    caller, scope_salt);
}

// RevokeGrant(bytes32 account,address device,uint64 authNonce,<Kind>Grantee grantee)
export circuit revoke_grant_with_evm_k256(
  grantee: EvmK256GranteeDescriptor, ed_pk: Curve25519Point, ed_bytes: Vector<32, Uint<8>>, ed_x: Vector<32, Uint<8>>,
  auth: EvmK256Auth, hint: EvmK256GranteeHint
): [] {
  const oh = evm_k256_grantee_origin_hash(grantee);
  const ed_id = evm_k256_ed25519_grantee_target(kernel.self(), grantee, oh, ed_pk, ed_bytes, ed_x)[1];
  const [t, tail] = evm_k256_parts_revoke_grant(grantee, ed_bytes, hint);
  require_authorised_with_evm_k256<Bytes<32>>(auth, t, tail);
  do_revoke_grant(evm_k256_grantee_grant_id(kernel.self(), grantee, oh, ed_id));
}

// RevokeAllGrants(bytes32 account,address device,uint64 authNonce)
export circuit revoke_all_grants_with_evm_k256(auth: EvmK256Auth): [] {
  require_authorised_with_evm_k256_bare(auth, evm_k256_parts_revoke_all_grants());
  do_revoke_all_grants();
}

// ── Recovery (recovery MIP §5, §6) ──────────────────────────────────────────
//
// The two device-gated recovery operations, over upstream's shared chips
// (do_publish_recovery_session, do_recover_cancel) and the device seam. The
// recovery gate itself (recover_submit) and finalisation (recover_finalise)
// are arm-independent: gated by the recovery secret, not by a device.
// Finalisation clears the device set before it installs the successor
// (upstream #183), so every evm_k256 entry is retired with the others,
// including one an upstream arm's raw add_device planted at
// device_epoch + 1 (README erratum 7).
//
// The session approval shows every operand in full under the circuit-fixed
// line "Sets this account's recovery key": the new recovery key's
// JubJub coordinates and the four phi values as the contract encodes them
// (32 bytes little-endian each), the session identifier, phiLength, and
// the 64-byte wrap as `bytes`. The material comes from the client's own
// guardian ceremony; that it is the intended guardians' is not verifiable by
// eye (a client obligation). The chip's
// freshness and slot rules apply as on every arm.

// PublishRecoverySession(bytes32 account,address device,uint64 authNonce,string effect,
//                        bytes32 recoveryKeyX,bytes32 recoveryKeyY,bytes32 sessionNonce,
//                        bytes32 phi1,bytes32 phi2,bytes32 phi3,bytes32 phi4,uint8 phiLength,bytes wrap)
export circuit publish_recovery_session_with_evm_k256(
  new_recovery_pk: JubjubPoint,
  session_nonce:   Bytes<32>,
  phi_1:           Field,
  phi_2:           Field,
  phi_3:           Field,
  phi_4:           Field,
  phi_len:         Uint<8>,
  wrap:            Bytes<64>,
  auth:            EvmK256Auth,
): [] {
  const [t, tail] = evm_k256_parts_publish_recovery_session(new_recovery_pk, session_nonce,
    phi_1, phi_2, phi_3, phi_4, phi_len, wrap);
  require_authorised_with_evm_k256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                      Bytes<31>, Bytes<1>, Bytes<32>]>(auth, t, tail);
  do_publish_recovery_session(new_recovery_pk, session_nonce, phi_1, phi_2, phi_3, phi_4, phi_len, wrap);
}

// The veto (recovery MIP §6 step 5): any live device clears a pending
// recovery inside the window.
// CancelRecovery(bytes32 account,address device,uint64 authNonce)
export circuit recover_cancel_with_evm_k256(auth: EvmK256Auth): [] {
  require_authorised_with_evm_k256_bare(auth, evm_k256_parts_cancel_recovery());
  do_recover_cancel();
}

// ── The grant seam (grantee role) ───────────────────────────────────────────
//
// An evm_k256 key as a GRANTEE: its grant id is
//   H(pad32("midnight:account:grant:id:evm:v1") || account || address(20)
//     || blind(32) || origin_hash || slot),
// origin_hash = H(pad32("midnight:account:grant:origin:v1") || label(32)) of
// the 32-byte site label. The grantee signs its own readable type per
// operation (WithdrawUnshieldedAsGrantee, ...) over the grant FRAME
//   account, grantee address, site label, slot, the record's issuedAt and
//   the record's nonce,
// never auth_nonce (GR-5): a grant call reads and advances only its
// record's nonce, and never touches a device entry.
//
// As the device seam does, this seam owns the frame: it derives the
// grantee's address from the presented point, the grant id from that address
// and the label and slot it shows, and takes issuedAt and the nonce from the
// record itself. An export passes only its operation (1 unshielded, 2
// shielded, 3 shielded to a contract), the values the scope checks (the
// spent colour, the amount, the recipient's bytes) and its type hash and
// tail. The MIP's steps in order: identity (the record by id), liveness
// (active, epoch, generation, expiry), the spend scope (upstream's shared
// check_spend_scope: operation, caller pin, object, per-call cap, spent
// opening, cumulative cap, recipient pin), then the signature
// (k256_ecdsa_verify, which also refuses the point at infinity as the key
// and r = 0 or s = 0), the record written back with its nonce advanced and
// the new spent commitment, and round bumped.
struct EvmK256GrantAuth {
  pk:    Secp256k1Point;
  blind: Bytes<32>;
  sig:   Secp256k1EcdsaSignature;
  hint:  EvmK256GrantSeamHint;
}

// The checked byte hints of the grant seam (see EvmK256SeamHint): the
// key's and the digest's, and the frame's: the site label's bytes, and the
// record's issuedAt and nonce little-endian.
struct EvmK256GrantSeamHint {
  key:         EvmAddressHint;
  digest:      Vector<32, Uint<8>>;
  label:       Vector<32, Uint<8>>;
  issued_at:   Vector<8, Uint<8>>;
  grant_nonce: Vector<8, Uint<8>>;
}

circuit require_grant_with_evm_k256<T>(
  auth:             EvmK256GrantAuth,
  label:            Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  op:               Uint<8>,
  obj_color:        Bytes<32>,
  amount:           Uint<128>,
  recipient_bytes:  Bytes<32>,
  type_hash:        Bytes<32>,
  tail:             T,
): [] {
  const address = evm_address(auth.pk, auth.hint.key);
  const id = disclose(derive_grant_id_with_evm_k256(kernel.self(), address, auth.blind,
    derive_grant_origin_hash_label(label), slot));
  assert(grants.member(id), "unknown grant");
  const g = grants.lookup(id);
  assert(g.active, "grant revoked");
  assert(g.epoch == device_epoch, "grant epoch stale");
  assert(g.gen == grant_generation, "grant generation stale");
  assert(g.scope.expires_at == (0 as Uint<64>) || kernel.blockTimeLessThan(g.scope.expires_at), "grant expired");
  const admitted = op == 1 ? g.scope.op_withdraw_unshielded
                 : op == 2 ? g.scope.op_withdraw_shielded
                 : g.scope.op_withdraw_shielded_to_contract;
  const new_spent = check_spend_scope(g, admitted, scope_salt, obj_color, recipient_kind, pinned_recipient,
    max_coin_value, amount, spent_prev, op, recipient_bytes);
  const struct_hash = evm_k256_grantee_struct<T>(type_hash, kernel.self().bytes, address, label, auth.hint.label, slot,
    g.issued_at, auth.hint.issued_at, g.nonce, auth.hint.grant_nonce, tail);
  assert(k256_ecdsa_verify(eip712_v1_digest(struct_hash), auth.hint.digest, auth.sig, auth.pk),
         "invalid grant signature");
  grants.insert(id, GrantRecord {
    epoch:        g.epoch,
    gen:          g.gen,
    issued_at:    g.issued_at,
    nonce:        ((g.nonce + (1 as Uint<64>)) as Uint<64>),
    spent_commit: disclose(derive_grant_spent_commit(scope_salt, new_spent)),
    window_start: g.window_start,
    window_spent: g.window_spent,
    active:       g.active,
    scope:        g.scope
  });
  bump_round();
}

// ── Grant twins (grantee role) ──────────────────────────────────────────────
//
// Operation arguments first, then the grant opening in the order upstream's
// client passes it for this arm (signer.ts grantAuthArgs): the site label
// and slot, scope_salt, the recipient kind and pin, the max coin value, the
// cumulative spend so far, and the grantee's authorisation.

// WithdrawUnshieldedAsGrantee(bytes32 account,address grantee,string siteLabel,uint8 slot,uint64 issuedAt,
//                             uint64 grantNonce,bytes32 color,uint128 amount,string amountLabel,bytes32 recipient)
export circuit withdraw_unshielded_with_grant_evm_k256(
  color:            Bytes<32>,
  amount:           Uint<128>,
  recipient:        UserAddress,
  label:            Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  auth:             EvmK256GrantAuth,
  hint:             EvmK256AmountHint,
): [] {
  const [t, tail] = evm_k256_parts_withdraw_unshielded_as_grantee(color, amount, recipient.bytes, hint);
  require_grant_with_evm_k256<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>]>(auth, label, slot, scope_salt,
    recipient_kind, pinned_recipient, max_coin_value, spent_prev, 1, color, amount, recipient.bytes, t, tail);
  do_withdraw_unshielded(color, amount, recipient);
}

// The shielded twins: the spent coin (from the held_coin witness) is shown by
// its nonce, value and Merkle index under the approved colour (asserted),
// with the change; the change entry the grantee sealed to the live
// enc_key and that key are shown too, and the change entry is appended when
// the send produces change (INV-4 under a grant).

// WithdrawShieldedAsGrantee(…grantee frame…,bytes32 color,uint128 amount,string amountLabel,bytes32 recipient,bytes changeEntry,
//                           bytes32 encryptionKey,bytes32 coinNonce,uint128 coinValue,uint64 coinMerkleIndex,uint128 change)
export circuit withdraw_shielded_with_grant_evm_k256(
  recipient:        ZswapCoinPublicKey,
  color:            Bytes<32>,
  amount:           Uint<128>,
  change_entry:     Bytes<192>,
  enc_pk:           Bytes<32>,
  label:            Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  auth:             EvmK256GrantAuth,
  hint:             EvmK256CoinHint,
): Maybe<ShieldedCoinInfo> {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  assert(amount <= coin.value, "amount above the spent coin's value");
  check_shielded_grant_bounds(coin, max_coin_value, enc_pk);
  const [t, tail] = evm_k256_parts_withdraw_shielded_as_grantee(color, amount, recipient.bytes, change_entry, enc_pk,
    coin.nonce, coin.value, coin.mt_index, hint);
  require_grant_with_evm_k256<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                 Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
    auth, label, slot, scope_salt, recipient_kind, pinned_recipient, max_coin_value, spent_prev,
    2, coin.color, amount, recipient.bytes, t, tail);
  const result = do_withdraw_shielded(recipient, amount, coin);
  if (disclose(result.is_some)) {
    do_append_inbox(change_entry);
  }
  return result;
}

// WithdrawShieldedToContractAsGrantee(…grantee frame…,bytes32 color,uint128 amount,string amountLabel,bytes32 recipientContract,
//                                     bytes changeEntry,bytes32 encryptionKey,bytes32 coinNonce,uint128 coinValue,
//                                     uint64 coinMerkleIndex,uint128 change)
export circuit withdraw_shielded_to_contract_with_grant_evm_k256(
  recipient:        ContractAddress,
  color:            Bytes<32>,
  amount:           Uint<128>,
  change_entry:     Bytes<192>,
  enc_pk:           Bytes<32>,
  label:            Bytes<32>,
  slot:             Uint<8>,
  scope_salt:       Bytes<32>,
  recipient_kind:   Uint<8>,
  pinned_recipient: Bytes<32>,
  max_coin_value:   Uint<128>,
  spent_prev:       Uint<128>,
  auth:             EvmK256GrantAuth,
  hint:             EvmK256CoinHint,
): [ShieldedCoinInfo, Maybe<ShieldedCoinInfo>] {
  const coin = held_coin(color);
  assert(coin.color == color, "held coin colour does not match the withdrawn colour");
  assert(amount <= coin.value, "amount above the spent coin's value");
  check_shielded_grant_bounds(coin, max_coin_value, enc_pk);
  const [t, tail] = evm_k256_parts_withdraw_shielded_to_contract_as_grantee(color, amount, recipient.bytes,
    change_entry, enc_pk, coin.nonce, coin.value, coin.mt_index, hint);
  require_grant_with_evm_k256<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                 Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
    auth, label, slot, scope_salt, recipient_kind, pinned_recipient, max_coin_value, spent_prev,
    3, coin.color, amount, recipient.bytes, t, tail);
  const [sent, change] = do_withdraw_shielded_to_contract(recipient, amount, coin);
  if (disclose(change.is_some)) {
    do_append_inbox(change_entry);
  }
  return [sent, change];
}
