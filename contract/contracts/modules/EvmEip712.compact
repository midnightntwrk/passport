// ---------------------------------------------------------------------------
// EvmEip712 — the readable EIP-712 approvals of the `evm_eip712` arm
// (byte contract: contract/EVM-EIP712.md; client copy:
// src/wallet/evm-eip712-codec.ts).
//
// An Ethereum wallet signs
//
//   digest = keccak256(0x19 || 0x01 || domainSeparator || hashStruct(message))
//
// and the arm's circuits recompute that digest from exactly the values they
// execute, then verify the signature against it. Nothing else is signed: no
// challenge hash, no fingerprint. Every operand and every consumed witness
// value is a member of the message, shown by the wallet in full.
//
// DOMAIN. EIP712Domain(string name,string version,address verifyingContract)
// with name "Midnight Passport Account", version "1", and verifyingContract
// the low 20 bytes of keccak256 of the account's 32-byte contract address.
// There is no chainId and no salt: the contract holds no network value (the
// cross-network argument is in the arm document).
//
// TYPES. One primary type per operation and role (16): the device role's
// thirteen carry `bytes32 account, address device, uint64 authNonce`; the
// grantee role's three carry `bytes32 account, address grantee, string
// siteLabel, uint8 slot, uint64 issuedAt, uint64 grantNonce`. The operation
// and the role are separated by the type hash. Authority-granting operations
// carry a circuit-fixed `string effect` line. The other key of
// add_device, remove_device, issue_grant and revoke_grant is a nested
// descriptor of one type per target scheme, so a wallet shows only that
// scheme's fields; the parent's type hash follows the scheme.
//
// ENCODING (EIP-712 encodeData). Every member is one 32-byte word:
//   bytes32            the 32 bytes;
//   address            12 zero bytes || the 20 bytes;
//   uint8/32/64/128    big-endian, zero-extended to 32 bytes;
//   bool               0 or 1 as a uint;
//   string, bytes      keccak256 of the content;
//   struct             its hashStruct.
// Byte order of points and field elements: secp256k1 and P-256
// coordinates are shown big-endian (SEC1); JubJub coordinates and other Field
// values are shown as the contract encodes them, little-endian.
//
// The four hash-like values that may appear, each
// under a fixed member name: a k256/jubjub grantee's `siteLabelHash`, a
// passkey's `passkeyRpHash`, a target device's `privacySalt` (its blind),
// and RemoveUnknownDevice's `entry` under the fixed line "Removes a device
// this wallet cannot identify". None grants authority.
//
// Every preimage is a keccak256 over a tuple of fixed-width byte atoms (one
// tuple element per word, or per zero prefix and value), never a flat buffer
// assembled by slicing, which costs far more rows.
//
// Everything here is pure: a function of its arguments. The exported circuits
// are oracles on the compiled artefact, so a signer obtains the contract's
// own answer; they have no proving key and no deploy cost.
// ---------------------------------------------------------------------------

module EvmEip712 {
  import CompactStandardLibrary;
  import "./WalletArmDescriptors";
  import "./WalletArmRendering";

  // ── Descriptor inputs ─────────────────────────────────────────────────────
  //
  // The readable descriptor of another key, as the circuits take it. Which
  // fields a scheme uses (the rest are not hashed and not shown):
  //   evm_eip712   address, key2 = the target's blind
  //   sol_ed25519  key = the 32-byte RFC 8032 key, key2 = the target's blind
  //   jubjub       key = x_le, key2 = y_le
  //   k256         key = x_le, key2 = y_le, envelope
  //   p256         key = x_le, key2 = y_le, rp_id_hash, origin (21 bytes)
  export struct EvmEip712Descriptor {
    tag:        Bytes<32>;
    key:        Bytes<32>;
    key2:       Bytes<32>;
    address:    Bytes<20>;
    envelope:   Uint<8>;
    rp_id_hash: Bytes<32>;
    origin:     Bytes<21>;
  }

  // A grantee: the same key fields under the grant-id tag, plus the origin
  // the grant id binds and the slot:
  //   evm_eip712, sol_ed25519  label (32-byte zero-padded site label)
  //   p256                     origin (21 bytes; the RP is a scope field)
  //   k256, jubjub             origin_hash (shown as siteLabelHash)
  export struct EvmEip712GranteeDescriptor {
    tag:         Bytes<32>;
    key:         Bytes<32>;
    key2:        Bytes<32>;
    address:     Bytes<20>;
    envelope:    Uint<8>;
    origin:      Bytes<21>;
    label:       Bytes<32>;
    origin_hash: Bytes<32>;
    slot:        Uint<8>;
  }

  // ── Hint inputs ───────────────────────────────────────────────────────────
  //
  // The checked byte hints of the values a message renders from bytes (see
  // "Checked byte hints"): each field is the exact bytes of one value,
  // numbers little-endian. A descriptor's hint covers every field the module
  // reads, whatever the scheme (each is checked, unused or not).

  // The display inputs of a Solana key's base58 text (the shared rendering
  // module's base58_text_32): each character's digit, 58 for the padding,
  // and the read-back's three checked hints.
  export struct EvmEip712Base58Hint {
    digits: Vector<44, Uint<8>>;
    carry:  Uint<120>;
    low:    Uint<128>;
    top:    Uint<16>;
  }

  // A descriptor's key, second key and origin, and the base58 inputs of the
  // key shown under the Solana type.
  export struct EvmEip712DescriptorHint {
    key:    Vector<32, Uint<8>>;
    key2:   Vector<32, Uint<8>>;
    origin: Vector<21, Uint<8>>;
    b58:    EvmEip712Base58Hint;
  }

  // A grantee descriptor's key, second key, origin and site label, and the
  // base58 inputs of the key shown under the Solana type.
  export struct EvmEip712GranteeHint {
    key:    Vector<32, Uint<8>>;
    key2:   Vector<32, Uint<8>>;
    origin: Vector<21, Uint<8>>;
    label:  Vector<32, Uint<8>>;
    b58:    EvmEip712Base58Hint;
  }

  // An unshielded amount, and the site's label for it (49 bytes, the display
  // input of site_amount_label_text).
  export struct EvmEip712AmountHint {
    amount: Vector<16, Uint<8>>;
    label:  Vector<49, Uint<8>>;
  }

  // A shielded spend: the amount, the spent coin's value and Merkle index, the
  // change, and the site's label for the amount.
  export struct EvmEip712CoinHint {
    amount:   Vector<16, Uint<8>>;
    value:    Vector<16, Uint<8>>;
    mt_index: Vector<8, Uint<8>>;
    change:   Vector<16, Uint<8>>;
    label:    Vector<49, Uint<8>>;
  }

  // A removal: the target's descriptor, epoch and use counter.
  export struct EvmEip712RemoveHint {
    target:  EvmEip712DescriptorHint;
    epoch:   Vector<4, Uint<8>>;
    counter: Vector<8, Uint<8>>;
  }

  // A grant: the grantee's descriptor, the scope's numbers, and the expiry's
  // date inputs (the shared rendering module's utc_datetime_text: the 29-byte
  // text and the year's split).
  export struct EvmEip712IssueHint {
    grantee:        EvmEip712GranteeHint;
    max_coin_value: Vector<16, Uint<8>>;
    per_call_cap:   Vector<16, Uint<8>>;
    cap:            Vector<16, Uint<8>>;
    expires_at:     Vector<8, Uint<8>>;
    window_len:     Vector<8, Uint<8>>;
    window_cap:     Vector<16, Uint<8>>;
    expiry_text:    Vector<29, Uint<8>>;
    year_split:     Vector<4, Uint<8>>;
  }

  // ── Frozen constants (keccak256 of the domain fields, the type strings,
  //    the effect lines and the scheme tags) ─────────────────────────────────

  // keccak256("EIP712Domain(string name,string version,address verifyingContract)")
  pure circuit evm_eip712_domain_type_hash(): Bytes<32> {
    return Bytes[0x91, 0xab, 0x3d, 0x17, 0xe3, 0xa5, 0x0a, 0x9d, 0x89, 0xe6, 0x3f, 0xd3, 0x0b, 0x92, 0xbe, 0x7f,
               0x53, 0x36, 0xb0, 0x3b, 0x28, 0x7b, 0xb9, 0x46, 0x78, 0x7a, 0x83, 0xa9, 0xd6, 0x2a, 0x27, 0x66];
  }

  // keccak256("Midnight Passport Account")
  pure circuit evm_eip712_name_hash(): Bytes<32> {
    return Bytes[0x64, 0xd1, 0xc9, 0x23, 0xe5, 0x9d, 0xa2, 0x0d, 0x02, 0xc9, 0x2d, 0xc0, 0xd6, 0xca, 0xa0, 0x86,
               0x8c, 0xb5, 0xc8, 0xab, 0x17, 0xee, 0x06, 0x58, 0xaa, 0xfc, 0x5f, 0x0b, 0x72, 0xd5, 0x6c, 0x85];
  }

  // keccak256("1")
  pure circuit evm_eip712_version_hash(): Bytes<32> {
    return Bytes[0xc8, 0x9e, 0xfd, 0xaa, 0x54, 0xc0, 0xf2, 0x0c, 0x7a, 0xdf, 0x61, 0x28, 0x82, 0xdf, 0x09, 0x50,
               0xf5, 0xa9, 0x51, 0x63, 0x7e, 0x03, 0x07, 0xcd, 0xcb, 0x4c, 0x67, 0x2f, 0x29, 0x8b, 0x8b, 0xc6];
