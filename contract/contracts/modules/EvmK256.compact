      // keccak256("RevokeGrant(bytes32 account,address device,uint64 authNonce,SolanaGrantee grantee)SolanaGrantee(string scheme,string publicKey,bytes32 privacySalt,string siteLabel,uint8 slot)")
      revoke_grant_type:
