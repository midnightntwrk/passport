      // keccak256("RemoveDevice(bytes32 account,address device,uint64 authNonce,SolanaDevice target,uint32 targetEpoch,uint64 targetCounter)SolanaDevice(string scheme,string publicKey,bytes32 privacySalt)")
      remove_device_type:
