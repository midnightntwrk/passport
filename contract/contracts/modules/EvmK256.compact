  // The registered kinds. Each entry's tags are distinct from every other
  // entry's (the offline suite checks it, with every type hash).
  export pure circuit evm_k256_kinds(): Vector<5, EvmK256Kind> {
    return [
      evm_k256_kind_evm_k256(),
      evm_k256_kind_sol_ed25519(),
      evm_k256_kind_jubjub(),
      evm_k256_kind_k256(),
      evm_k256_kind_p256(),
    ];
  }

  // The kind whose device tag is `tag`; any other tag is refused.
  export pure circuit evm_k256_device_kind(tag: Bytes<32>): EvmK256Kind {
    const r = fold((acc: [Boolean, EvmK256Kind], k: EvmK256Kind): [Boolean, EvmK256Kind] =>
                     tag == k.device ? [true, k] : acc,
                   [false, evm_k256_kinds()[0]], evm_k256_kinds());
    assert(r[0], "evm_k256: not a registered device tag");
    return r[1];
  }

  // The kind whose grant-id tag is `tag`; any other tag is refused.
  export pure circuit evm_k256_grantee_kind(tag: Bytes<32>): EvmK256Kind {
    const r = fold((acc: [Boolean, EvmK256Kind], k: EvmK256Kind): [Boolean, EvmK256Kind] =>
                     tag == k.grant_id ? [true, k] : acc,
                   [false, evm_k256_kinds()[0]], evm_k256_kinds());
    assert(r[0], "evm_k256: not a registered grant-id tag");
    return r[1];
  }

  // The list's first kind of payload form `p`, resolved at compile time. A
  // circuit has no branches, so it derives the entry or grant id of every
  // form; a form that is not the descriptor's own is fed this kind's tag,
  // so that derivation's tag admission holds, and its result is discarded.
  // The first is taken so that appending a kind changes no existing result.
  pure circuit evm_k256_kind_of(p: EvmK256Payload): EvmK256Kind {
    return fold((r: [Boolean, EvmK256Kind], k: EvmK256Kind): [Boolean, EvmK256Kind] =>
                  r[0] || k.payload != p ? r : [true, k],
                [false, evm_k256_kinds()[0]], evm_k256_kinds())[1];
  }

  // ── Descriptors ───────────────────────────────────────────────────────────
  //
  // Every circuit below takes the kind's values from its entry (by the
  // descriptor's tag) and computes every payload form, keeping the one of
  // the kind's form.

  // An ed25519 target is a Curve25519Point: the descriptor module's
  // ed25519 class refuses the identity (A != O), checks the byte inputs
  // `ed_bytes` (the key's 32-byte RFC 8032 encoding) and `ed_x` (x
  // little-endian) against the point once per call, and returns the key and
  // the entry or grant id. The approval shows the key as the base58 text of
  // the same checked `ed_bytes`. For a target of any other form the ed25519
  // class is fed a registered tag and the point the client passes (any
  // non-identity point, with its own inputs); its results are discarded. The
  // point is an inline argument, not a struct member (compactc 0.35.0 cannot
  // emit an exported struct holding a Curve25519Point); `d.key` is unused for
  // an ed25519 target.
  // compact row optimization | Ed25519 descriptor key from checked bytes | -75% rows
  export pure circuit evm_k256_ed25519_device_target(
    self_addr: ContractAddress, d: EvmK256Descriptor, ed_pk: Curve25519Point, ed_bytes: Vector<32, Uint<8>>, ed_x: Vector<32, Uint<8>>,
    epoch: Uint<32>, counter: Uint<64>
  ): [Bytes<32>, Bytes<32>] {
    const f = evm_k256_device_kind(d.tag).payload;
    return derive_descriptor_entry_ed25519(
      f == EvmK256Payload.ed25519 ? d.tag : evm_k256_kind_of(EvmK256Payload.ed25519).device,
      self_addr, ed_pk, ed_bytes, ed_x, d.key2, epoch, counter);
  }

  // `oh` is the grantee's origin hash (evm_k256_grantee_origin_hash),
  // computed once by the caller and shared with evm_k256_grantee_grant_id.
  // compact row optimization | Ed25519 descriptor key from checked bytes | -75% rows
  export pure circuit evm_k256_ed25519_grantee_target(
    self_addr: ContractAddress, g: EvmK256GranteeDescriptor, oh: Bytes<32>, ed_pk: Curve25519Point,
    ed_bytes: Vector<32, Uint<8>>, ed_x: Vector<32, Uint<8>>
  ): [Bytes<32>, Bytes<32>] {
    const f = evm_k256_grantee_kind(g.tag).payload;
    return derive_descriptor_grant_id_ed25519(
      f == EvmK256Payload.ed25519 ? g.tag : evm_k256_kind_of(EvmK256Payload.ed25519).grant_id,
      self_addr, ed_pk, ed_bytes, ed_x, g.key2, oh, g.slot);
  }

  // hashStruct of the nested <Kind>Device member. `ed_bytes` is the bytes of
  // the key an ed25519 kind shows: in the circuits, the encoding the
  // ed25519 class checked against the point (evm_k256_ed25519_device_target's
  // `ed_bytes`).
  export pure circuit evm_k256_device_descriptor_hash(
    d: EvmK256Descriptor, ed_bytes: Vector<32, Uint<8>>, h: EvmK256DescriptorHint
  ): Bytes<32> {
    const k = evm_k256_device_kind(d.tag);
    const f = k.payload;
    const origin_visible = visible_21(d.origin, h.origin);
    assert(f != EvmK256Payload.passkey || origin_visible, "evm_k256: the passkey origin is not visible ASCII");
    // A passkey's own RP pin is never zero (no honest passkey meets it), so a
    // zero RP hash can only mean "no passkey".
    assert(f != EvmK256Payload.passkey || d.rp_id_hash != pad(32, ""), "evm_k256: a passkey's RP hash is zero");
    const xb = rev32(d.key, h.key);
    const yb = rev32(d.key2, h.key2);
    const h_address = keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<32>]>([
      k.device_type, k.device_scheme, pad(12, ""), d.address, d.key2]);
    assert(f != EvmK256Payload.k256 || d.envelope <= 1, "evm_k256: not a k256 envelope");
    // The ed25519 form (scheme, publicKey, privacySalt) and the jubjub
    // form (scheme, x, y) share one shape; an Ed25519 key is shown in base58,
    // JubJub coordinates little-endian. The base58 text is checked for every
    // target (for a target of any other form, the filler key's), so every
    // input of the call is checked.
    const ed_text = evm_k256_key_text_hash(ed_bytes, h.b58, k.key_text);
    const h_pair = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>([
      k.device_type, k.device_scheme, f == EvmK256Payload.ed25519 ? ed_text : d.key, d.key2]);
    const h_k1 = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>([
      k.device_type, k.device_scheme, xb, yb, evm_k256_envelope_label(d.envelope)]);
    const h_r1 = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>]>([
      k.device_type, k.device_scheme, xb, yb, keccak256<Bytes<21>>(d.origin), d.rp_id_hash]);
    return f == EvmK256Payload.address ? h_address
         : (f == EvmK256Payload.ed25519 || f == EvmK256Payload.jubjub) ? h_pair
         : f == EvmK256Payload.k256 ? h_k1 : h_r1;
  }

  // The target's entry at (epoch, counter), by the recipe of the kind's
  // payload form. Every form's recipe is derived (a circuit has no branches);
  // the forms that do not match are fed a registered tag of their own
  // (evm_k256_kind_of), so the module's tag asserts hold, and their results
  // are discarded. `ed_entry` is an ed25519 target's entry
  // (evm_k256_ed25519_device_target).
  export pure circuit evm_k256_descriptor_entry(
    self_addr: ContractAddress, d: EvmK256Descriptor, ed_entry: Bytes<32>, epoch: Uint<32>, counter: Uint<64>
  ): Bytes<32> {
    const f = evm_k256_device_kind(d.tag).payload;
    const e52 = derive_descriptor_entry_w52(
      f == EvmK256Payload.address ? d.tag : evm_k256_kind_of(EvmK256Payload.address).device,
      self_addr, d.address, d.key2, epoch, counter);
    const e64 = derive_descriptor_entry_w64(
      f == EvmK256Payload.jubjub ? d.tag : evm_k256_kind_of(EvmK256Payload.jubjub).device,
      self_addr, d.key, d.key2, epoch, counter);
    const e65 = derive_descriptor_entry_w65(
      f == EvmK256Payload.k256 ? d.tag : evm_k256_kind_of(EvmK256Payload.k256).device,
      self_addr, d.key, d.key2, d.envelope, epoch, counter);
    const e117 = derive_descriptor_entry_w117(
      f == EvmK256Payload.passkey ? d.tag : evm_k256_kind_of(EvmK256Payload.passkey).device,
      self_addr, d.key, d.key2, d.rp_id_hash, d.origin, epoch, counter);
    return f == EvmK256Payload.address ? e52 : f == EvmK256Payload.ed25519 ? ed_entry
         : f == EvmK256Payload.jubjub ? e64 : f == EvmK256Payload.k256 ? e65 : e117;
  }

  // The origin_hash a grantee's grant id binds: from the site label (address
  // and ed25519 forms), from the exact origin (passkey), or the
  // labelled origin_hash itself (jubjub, k256).
  export pure circuit evm_k256_grantee_origin_hash(g: EvmK256GranteeDescriptor): Bytes<32> {
    const f = evm_k256_grantee_kind(g.tag).payload;
    const from_label = derive_grant_origin_hash_label(g.label);
    const from_origin = derive_grant_origin_hash_origin(g.origin);
    return (f == EvmK256Payload.address || f == EvmK256Payload.ed25519) ? from_label
         : f == EvmK256Payload.passkey ? from_origin : g.origin_hash;
  }

  // The grantee's grant id, by the grant-id recipe of the kind's payload
  // form (a passkey's binds its key only, as JubJub's does, under its own
  // tag). `oh` is the grantee's origin hash (evm_k256_grantee_origin_hash)
  // and `ed_id` an ed25519 grantee's grant id
  // (evm_k256_ed25519_grantee_target).
  export pure circuit evm_k256_grantee_grant_id(
    self_addr: ContractAddress, g: EvmK256GranteeDescriptor, oh: Bytes<32>, ed_id: Bytes<32>
  ): Bytes<32> {
    const f = evm_k256_grantee_kind(g.tag).payload;
    const i52 = derive_descriptor_grant_id_w52(
      f == EvmK256Payload.address ? g.tag : evm_k256_kind_of(EvmK256Payload.address).grant_id,
      self_addr, g.address, g.key2, oh, g.slot);
    const i64 = derive_descriptor_grant_id_w64(
      (f == EvmK256Payload.jubjub || f == EvmK256Payload.passkey) ? g.tag : evm_k256_kind_of(EvmK256Payload.jubjub).grant_id,
      self_addr, g.key, g.key2, oh, g.slot);
    const i65 = derive_descriptor_grant_id_w65(
      f == EvmK256Payload.k256 ? g.tag : evm_k256_kind_of(EvmK256Payload.k256).grant_id,
      self_addr, g.key, g.key2, g.envelope, oh, g.slot);
    return f == EvmK256Payload.address ? i52 : f == EvmK256Payload.ed25519 ? ed_id
         : f == EvmK256Payload.k256 ? i65 : i64;
  }

  // hashStruct of the nested <Kind>Grantee member. `ed_bytes` is the bytes of
  // the key an ed25519 kind shows: in the circuits, the encoding the
  // ed25519 class checked against the point (evm_k256_ed25519_grantee_target's
  // `ed_bytes`).
  export pure circuit evm_k256_grantee_descriptor_hash(
    g: EvmK256GranteeDescriptor, ed_bytes: Vector<32, Uint<8>>, h: EvmK256GranteeHint
  ): Bytes<32> {
    const k = evm_k256_grantee_kind(g.tag);
    const f = k.payload;
    const [text, label_ok] = label_text(g.label, h.label);
    assert(!(f == EvmK256Payload.address || f == EvmK256Payload.ed25519) || label_ok, "evm_k256: not a site label");
    const origin_visible = visible_21(g.origin, h.origin);
    assert(f != EvmK256Payload.passkey || origin_visible, "evm_k256: the passkey origin is not visible ASCII");
    assert(f != EvmK256Payload.k256 || g.envelope <= 1, "evm_k256: not a k256 envelope");
    const label_hash = keccak256<Bytes<32>>(text);
    // checked for every grantee (for a grantee of any other form, the filler key's)
    const ed_text = evm_k256_key_text_hash(ed_bytes, h.b58, k.key_text);
    const xb = rev32(g.key, h.key);
    const yb = rev32(g.key2, h.key2);
    const h_address = keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      k.grantee_type, k.grantee_scheme, pad(12, ""), g.address, g.key2,
      label_hash, pad(31, ""), u8b(g.slot)]);
    // The ed25519 form (scheme, publicKey, privacySalt, siteLabel,
    // slot), the jubjub form (scheme, x, y, siteLabelHash, slot) and the
    // passkey form (scheme, x, y, origin, slot) share one shape.
    const h_six = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      k.grantee_type, k.grantee_scheme,
      f == EvmK256Payload.passkey ? xb : f == EvmK256Payload.ed25519 ? ed_text : g.key,
      f == EvmK256Payload.passkey ? yb : g.key2,
      f == EvmK256Payload.ed25519 ? label_hash : f == EvmK256Payload.jubjub ? g.origin_hash : keccak256<Bytes<21>>(g.origin),
      pad(31, ""), u8b(g.slot)]);
    const h_k1 = keccak256<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<31>, Bytes<1>]>([
      k.grantee_type, k.grantee_scheme, xb, yb, evm_k256_envelope_label(g.envelope),
      g.origin_hash, pad(31, ""), u8b(g.slot)]);
    return f == EvmK256Payload.address ? h_address : f == EvmK256Payload.k256 ? h_k1 : h_six;
  }

  // ── The frames ────────────────────────────────────────────────────────────
  //
  // Every device-role primary type begins with the same frame,
  //   typeHash, bytes32 account, address device, uint64 authNonce,
  // and every grantee-role type with
  //   typeHash, bytes32 account, address grantee, string siteLabel,
  //   uint8 slot, uint64 issuedAt, uint64 grantNonce,
  // followed by the operation's own members (its "tail"). The frame builders
  // below are the only place the frame is encoded: the exported struct-hash
  // oracles use them, and so does the arm's seam, which supplies the frame's
  // values itself (the account is kernel.self(), the device the address of
  // the presented point, the nonce the ledger's) — so no export can ever name
  // a frame value. Each operation's type hash and tail
  // come from its `evm_k256_parts_*` circuit, shared by the oracle and the
  // export. The tail is a tuple of byte atoms and is hashed in place, flat
  // (keccak256 of a tuple encodes its elements in declaration order).

  // `nonce_h` is a checked hint of auth_nonce (see "Words").
  export circuit evm_k256_device_struct<T>(
    type_hash: Bytes<32>, account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>, tail: T
  ): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<24>, Bytes<8>, T]>([
      type_hash, account, pad(12, ""), device, pad(24, ""), evm_k256_be8(auth_nonce, nonce_h), tail]);
  }

  // The device-role types with no members of their own (RevokeAllGrants,
  // CancelRecovery): the frame alone.
  export circuit evm_k256_device_struct_bare(
    type_hash: Bytes<32>, account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>
  ): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<24>, Bytes<8>]>([
      type_hash, account, pad(12, ""), device, pad(24, ""), evm_k256_be8(auth_nonce, nonce_h)]);
  }

  // `label_h`, `issued_at_h` and `grant_nonce_h` are checked hints of the
  // label's bytes and of the two numbers.
  export circuit evm_k256_grantee_struct<T>(
    type_hash: Bytes<32>, account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, label_h: Vector<32, Uint<8>>, slot: Uint<8>,
    issued_at: Uint<64>, issued_at_h: Vector<8, Uint<8>>, grant_nonce: Uint<64>, grant_nonce_h: Vector<8, Uint<8>>, tail: T
  ): Bytes<32> {
    return keccak256<[Bytes<32>, Bytes<32>, Bytes<12>, Bytes<20>, Bytes<32>, Bytes<31>, Bytes<1>,
                      Bytes<24>, Bytes<8>, Bytes<24>, Bytes<8>, T]>([
      type_hash, account, pad(12, ""), grantee, evm_k256_site_label_hash(label, label_h), pad(31, ""), u8b(slot),
      pad(24, ""), evm_k256_be8(issued_at, issued_at_h), pad(24, ""), evm_k256_be8(grant_nonce, grant_nonce_h), tail]);
  }

  // ── Parts: each operation's type hash and tail ────────────────────────────

  // color, amount, recipient
  export circuit evm_k256_parts_withdraw_unshielded(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, h: EvmK256AmountHint
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>]] {
    return [evm_k256_type_withdraw_unshielded(), [color, pad(16, ""), evm_k256_be16(amount, h.amount),
            evm_k256_amount_label_hash(amount, h.label), recipient]];
  }

  // The spent coin is shown by its nonce, value and Merkle index; its colour is
  // `color` (the exports assert coin.color == color); change = value - amount.
  circuit coin_tail(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>] {
    const change = (coin_value - amount) as Uint<128>;
    return [color, pad(16, ""), evm_k256_be16(amount, h.amount), evm_k256_amount_label_hash(amount, h.label), recipient,
            coin_nonce, pad(16, ""), evm_k256_be16(coin_value, h.value), pad(24, ""), evm_k256_be8(coin_mt_index, h.mt_index),
            pad(16, ""), evm_k256_be16(change, h.change)];
  }

  export circuit evm_k256_parts_withdraw_shielded(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_k256_type_withdraw_shielded(), coin_tail(color, amount, recipient, coin_nonce, coin_value, coin_mt_index, h)];
  }

  export circuit evm_k256_parts_withdraw_shielded_to_contract(
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_k256_type_withdraw_shielded_to_contract(),
            coin_tail(color, amount, recipient_contract, coin_nonce, coin_value, coin_mt_index, h)];
  }

  // `bytes entry`: the 192-byte InboxEntry v1 ciphertext, shown in full hex.
  export circuit evm_k256_parts_append_inbox(entry: Bytes<192>): [Bytes<32>, Bytes<32>] {
    return [evm_k256_type_append_inbox(), keccak256<Bytes<192>>(entry)];
  }

  export circuit evm_k256_parts_rotate_enc_key(new_key: Bytes<32>): [Bytes<32>, [Bytes<32>, Bytes<32>]] {
    return [evm_k256_type_rotate_enc_key(), [evm_k256_effect_rotate_enc_key(), new_key]];
  }

  export circuit evm_k256_parts_add_device(
    new_device: EvmK256Descriptor, ed_bytes: Vector<32, Uint<8>>, h: EvmK256DescriptorHint
  ): [Bytes<32>, [Bytes<32>, Bytes<32>]] {
    const child = evm_k256_device_descriptor_hash(new_device, ed_bytes, h);
    return [evm_k256_device_kind(new_device.tag).add_device_type, [evm_k256_effect_add_device(), child]];
  }

  export circuit evm_k256_parts_remove_device(
    target: EvmK256Descriptor, ed_bytes: Vector<32, Uint<8>>, target_epoch: Uint<32>, target_counter: Uint<64>, h: EvmK256RemoveHint
  ): [Bytes<32>, [Bytes<32>, Bytes<28>, Bytes<4>, Bytes<24>, Bytes<8>]] {
    const child = evm_k256_device_descriptor_hash(target, ed_bytes, h.target);
    return [evm_k256_device_kind(target.tag).remove_device_type,
            [child, pad(28, ""), evm_k256_be4(target_epoch, h.epoch), pad(24, ""), evm_k256_be8(target_counter, h.counter)]];
  }

  // The revocation-only literal form: the entry under a fixed line.
  export circuit evm_k256_parts_remove_unknown_device(entry: Bytes<32>): [Bytes<32>, [Bytes<32>, Bytes<32>]] {
    return [evm_k256_type_remove_unknown_device(), [evm_k256_effect_remove_unknown_device(), entry]];
  }

  // Every scope field, the grantee descriptor, the RP hash (a passkey grantee's
  // labelled value; zero otherwise), the delegate's read key itself (its hash is
  // what the record stores; zero when `read` is off), and the caller pin.
  export circuit evm_k256_parts_issue_grant(
    grantee: EvmK256GranteeDescriptor, ed_bytes: Vector<32, Uint<8>>,
    op_withdraw_unshielded: Boolean, op_withdraw_shielded: Boolean, op_withdraw_shielded_to_contract: Boolean,
    read: Boolean, color: Bytes<32>, recipient_kind: Uint<8>, recipient: Bytes<32>, max_coin_value: Uint<128>,
    per_call_cap: Uint<128>, cap: Uint<128>, expires_at: Uint<64>, rp_id_hash: Bytes<32>, read_pk: Bytes<32>,
    window_len: Uint<64>, window_cap: Uint<128>, caller: Maybe<ContractAddress>, h: EvmK256IssueHint
  ): [Bytes<32>, [Bytes<32>, Bytes<32>,
                  Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>,
                  Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>,
                  Bytes<24>, Bytes<8>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>, Bytes<32>,
                  Bytes<31>, Bytes<1>, Bytes<32>]] {
    const child = evm_k256_grantee_descriptor_hash(grantee, ed_bytes, h.grantee);
    const k = evm_k256_grantee_kind(grantee.tag);
    // The passkey RP hash is a passkey grantee's own pin, and upstream
    // reads it only on the passkey spend path (account-p256.compact): it is
    // non-zero exactly for a passkey grantee whose scope can spend and zero
    // otherwise, so that "not applicable" means exactly "no passkey
    // pin is checked".
    const rp_pinned = k.payload == EvmK256Payload.passkey && (op_withdraw_unshielded || op_withdraw_shielded || op_withdraw_shielded_to_contract);
    assert(rp_pinned || rp_id_hash == pad(32, ""), "evm_k256: an RP hash belongs to a spending passkey grant");
    assert(!rp_pinned || rp_id_hash != pad(32, ""), "evm_k256: a spending passkey grant's RP hash is zero");
    // "any recipient" carries no recipient, so no shown value is without
    // effect.
    assert(recipient_kind != 0 || recipient == pad(32, ""), "evm_k256: a recipient for any recipient");
    return [k.issue_grant_type, [evm_k256_effect_issue_grant(), child,
      pad(31, ""), boolb(op_withdraw_unshielded), pad(31, ""), boolb(op_withdraw_shielded),
      pad(31, ""), boolb(op_withdraw_shielded_to_contract), pad(31, ""), boolb(read),
      color, evm_k256_recipient_kind_label(recipient_kind), recipient,
      pad(16, ""), evm_k256_be16(max_coin_value, h.max_coin_value), pad(16, ""), evm_k256_be16(per_call_cap, h.per_call_cap),
      pad(16, ""), evm_k256_be16(cap, h.cap),
      pad(24, ""), evm_k256_be8(expires_at, h.expires_at), evm_k256_expiry_hash(expires_at, h.expiry_text, h.year_split),
      rp_id_hash, evm_k256_passkey_rp_word(rp_id_hash),
      read ? read_pk : pad(32, ""), pad(24, ""), evm_k256_be8(window_len, h.window_len),
      pad(16, ""), evm_k256_be16(window_cap, h.window_cap), evm_k256_window_word(window_len, window_cap),
      pad(31, ""), boolb(caller.is_some), caller.is_some ? caller.value.bytes : pad(32, "")]];
  }

  export circuit evm_k256_parts_revoke_grant(
    grantee: EvmK256GranteeDescriptor, ed_bytes: Vector<32, Uint<8>>, h: EvmK256GranteeHint
  ): [Bytes<32>, Bytes<32>] {
    const child = evm_k256_grantee_descriptor_hash(grantee, ed_bytes, h);
    return [evm_k256_grantee_kind(grantee.tag).revoke_grant_type, child];
  }

  export circuit evm_k256_parts_revoke_all_grants(): Bytes<32> {
    return evm_k256_type_revoke_all_grants();
  }

  // JubJub coordinates and the phi Field values are shown little-endian;
  // `bytes wrap` is the 64-byte wrap in full.
  export circuit evm_k256_parts_publish_recovery_session(
    new_recovery_pk: JubjubPoint, session_nonce: Bytes<32>, phi_1: Field, phi_2: Field, phi_3: Field, phi_4: Field,
    phi_len: Uint<8>, wrap: Bytes<64>
  ): [Bytes<32>, [Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<31>, Bytes<1>, Bytes<32>]] {
    return [evm_k256_type_publish_recovery_session(), [evm_k256_effect_publish_recovery_session(),
      jubjubPointX(new_recovery_pk) as Bytes<32>, jubjubPointY(new_recovery_pk) as Bytes<32>, session_nonce,
      phi_1 as Bytes<32>, phi_2 as Bytes<32>, phi_3 as Bytes<32>, phi_4 as Bytes<32>,
      pad(31, ""), u8b(phi_len), keccak256<Bytes<64>>(wrap)]];
  }

  export circuit evm_k256_parts_cancel_recovery(): Bytes<32> {
    return evm_k256_type_cancel_recovery();
  }

  // The grantee role: color, amount, recipient (+ the change entry, its key and
  // the coin for the shielded twins).
  export circuit evm_k256_parts_withdraw_unshielded_as_grantee(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, h: EvmK256AmountHint
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>]] {
    return [evm_k256_type_withdraw_unshielded_as_grantee(), [color, pad(16, ""), evm_k256_be16(amount, h.amount),
            evm_k256_amount_label_hash(amount, h.label), recipient]];
  }

  circuit grantee_coin_tail(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
      Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>] {
    const change = (coin_value - amount) as Uint<128>;
    return [color, pad(16, ""), evm_k256_be16(amount, h.amount), evm_k256_amount_label_hash(amount, h.label), recipient,
            keccak256<Bytes<192>>(change_entry), enc_pk,
            coin_nonce, pad(16, ""), evm_k256_be16(coin_value, h.value), pad(24, ""), evm_k256_be8(coin_mt_index, h.mt_index),
            pad(16, ""), evm_k256_be16(change, h.change)];
  }

  export circuit evm_k256_parts_withdraw_shielded_as_grantee(
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_k256_type_withdraw_shielded_as_grantee(),
            grantee_coin_tail(color, amount, recipient, change_entry, enc_pk, coin_nonce, coin_value, coin_mt_index, h)];
  }

  export circuit evm_k256_parts_withdraw_shielded_to_contract_as_grantee(
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): [Bytes<32>, [Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                  Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]] {
    return [evm_k256_type_withdraw_shielded_to_contract_as_grantee(),
            grantee_coin_tail(color, amount, recipient_contract, change_entry, enc_pk, coin_nonce, coin_value, coin_mt_index, h)];
  }

  // ── Struct hashes: the exported oracles (frame + parts) ───────────────────
  //
  // Each takes the frame's values, the operation's values and their checked
  // hints (`nonce_h` of auth_nonce; `h` of the operation's own values), as the
  // seams do.

  export pure circuit evm_k256_struct_withdraw_unshielded(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, h: EvmK256AmountHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_withdraw_unshielded(color, amount, recipient, h);
    return evm_k256_device_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_withdraw_shielded(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_withdraw_shielded(color, amount, recipient, coin_nonce, coin_value, coin_mt_index, h);
    return evm_k256_device_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_withdraw_shielded_to_contract(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_withdraw_shielded_to_contract(color, amount, recipient_contract, coin_nonce, coin_value, coin_mt_index, h);
    return evm_k256_device_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_append_inbox(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>, entry: Bytes<192>
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_append_inbox(entry);
    return evm_k256_device_struct<Bytes<32>>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_rotate_enc_key(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>, new_key: Bytes<32>
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_rotate_enc_key(new_key);
    return evm_k256_device_struct<[Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_add_device(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    new_device: EvmK256Descriptor, ed_bytes: Vector<32, Uint<8>>, h: EvmK256DescriptorHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_add_device(new_device, ed_bytes, h);
    return evm_k256_device_struct<[Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_remove_device(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    target: EvmK256Descriptor, ed_bytes: Vector<32, Uint<8>>, target_epoch: Uint<32>, target_counter: Uint<64>, h: EvmK256RemoveHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_remove_device(target, ed_bytes, target_epoch, target_counter, h);
    return evm_k256_device_struct<[Bytes<32>, Bytes<28>, Bytes<4>, Bytes<24>, Bytes<8>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_remove_unknown_device(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>, entry: Bytes<32>
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_remove_unknown_device(entry);
    return evm_k256_device_struct<[Bytes<32>, Bytes<32>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_issue_grant(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    grantee: EvmK256GranteeDescriptor, ed_bytes: Vector<32, Uint<8>>,
    op_withdraw_unshielded: Boolean, op_withdraw_shielded: Boolean, op_withdraw_shielded_to_contract: Boolean,
    read: Boolean, color: Bytes<32>, recipient_kind: Uint<8>, recipient: Bytes<32>, max_coin_value: Uint<128>,
    per_call_cap: Uint<128>, cap: Uint<128>, expires_at: Uint<64>, rp_id_hash: Bytes<32>, read_pk: Bytes<32>,
    window_len: Uint<64>, window_cap: Uint<128>, caller: Maybe<ContractAddress>, h: EvmK256IssueHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_issue_grant(grantee, ed_bytes, op_withdraw_unshielded, op_withdraw_shielded,
      op_withdraw_shielded_to_contract, read, color, recipient_kind, recipient, max_coin_value, per_call_cap, cap,
      expires_at, rp_id_hash, read_pk, window_len, window_cap, caller, h);
    return evm_k256_device_struct<[Bytes<32>, Bytes<32>,
                                     Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>, Bytes<31>, Bytes<1>,
                                     Bytes<32>, Bytes<32>, Bytes<32>,
                                     Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>, Bytes<16>,
                                     Bytes<24>, Bytes<8>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>, Bytes<32>,
                                     Bytes<31>, Bytes<1>, Bytes<32>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_revoke_grant(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>,
    grantee: EvmK256GranteeDescriptor, ed_bytes: Vector<32, Uint<8>>, h: EvmK256GranteeHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_revoke_grant(grantee, ed_bytes, h);
    return evm_k256_device_struct<Bytes<32>>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_revoke_all_grants(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>
  ): Bytes<32> {
    return evm_k256_device_struct_bare(evm_k256_parts_revoke_all_grants(), account, device, auth_nonce, nonce_h);
  }

  export pure circuit evm_k256_struct_publish_recovery_session(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>, new_recovery_pk: JubjubPoint,
    session_nonce: Bytes<32>, phi_1: Field, phi_2: Field, phi_3: Field, phi_4: Field,
    phi_len: Uint<8>, wrap: Bytes<64>
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_publish_recovery_session(new_recovery_pk, session_nonce,
      phi_1, phi_2, phi_3, phi_4, phi_len, wrap);
    return evm_k256_device_struct<[Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                     Bytes<31>, Bytes<1>, Bytes<32>]>(t, account, device, auth_nonce, nonce_h, tail);
  }

  export pure circuit evm_k256_struct_cancel_recovery(
    account: Bytes<32>, device: Bytes<20>, auth_nonce: Uint<64>, nonce_h: Vector<8, Uint<8>>
  ): Bytes<32> {
    return evm_k256_device_struct_bare(evm_k256_parts_cancel_recovery(), account, device, auth_nonce, nonce_h);
  }

  // The grantee role: the grant is shown by its descriptor without the
  // signer's own blind (a ledger-pinned opening): the grantee's address, site
  // label and slot, then the record's issuedAt and nonce (never auth_nonce).
  // `label_h`, `issued_at_h` and `grant_nonce_h` are the frame's checked hints.

  export pure circuit evm_k256_struct_withdraw_unshielded_as_grantee(
    account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, label_h: Vector<32, Uint<8>>, slot: Uint<8>,
    issued_at: Uint<64>, issued_at_h: Vector<8, Uint<8>>, grant_nonce: Uint<64>, grant_nonce_h: Vector<8, Uint<8>>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, h: EvmK256AmountHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_withdraw_unshielded_as_grantee(color, amount, recipient, h);
    return evm_k256_grantee_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>]>(
      t, account, grantee, label, label_h, slot, issued_at, issued_at_h, grant_nonce, grant_nonce_h, tail);
  }

  export pure circuit evm_k256_struct_withdraw_shielded_as_grantee(
    account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, label_h: Vector<32, Uint<8>>, slot: Uint<8>,
    issued_at: Uint<64>, issued_at_h: Vector<8, Uint<8>>, grant_nonce: Uint<64>, grant_nonce_h: Vector<8, Uint<8>>,
    color: Bytes<32>, amount: Uint<128>, recipient: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_withdraw_shielded_as_grantee(color, amount, recipient, change_entry, enc_pk,
      coin_nonce, coin_value, coin_mt_index, h);
    return evm_k256_grantee_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                      Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, grantee, label, label_h, slot, issued_at, issued_at_h, grant_nonce, grant_nonce_h, tail);
  }

  export pure circuit evm_k256_struct_withdraw_shielded_to_contract_as_grantee(
    account: Bytes<32>, grantee: Bytes<20>, label: Bytes<32>, label_h: Vector<32, Uint<8>>, slot: Uint<8>,
    issued_at: Uint<64>, issued_at_h: Vector<8, Uint<8>>, grant_nonce: Uint<64>, grant_nonce_h: Vector<8, Uint<8>>,
    color: Bytes<32>, amount: Uint<128>, recipient_contract: Bytes<32>, change_entry: Bytes<192>, enc_pk: Bytes<32>,
    coin_nonce: Bytes<32>, coin_value: Uint<128>, coin_mt_index: Uint<64>, h: EvmK256CoinHint
  ): Bytes<32> {
    const [t, tail] = evm_k256_parts_withdraw_shielded_to_contract_as_grantee(color, amount, recipient_contract,
      change_entry, enc_pk, coin_nonce, coin_value, coin_mt_index, h);
    return evm_k256_grantee_struct<[Bytes<32>, Bytes<16>, Bytes<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
                                      Bytes<32>, Bytes<16>, Bytes<16>, Bytes<24>, Bytes<8>, Bytes<16>, Bytes<16>]>(
      t, account, grantee, label, label_h, slot, issued_at, issued_at_h, grant_nonce, grant_nonce_h, tail);
  }
}
