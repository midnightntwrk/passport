              0x0b, 0x9b, 0x54, 0x7c, 0x08, 0x14, 0x8b, 0x56, 0xa0, 0x5a, 0xdf, 0x25, 0xfa, 0xde, 0x83, 0xe5],
      // keccak256("EvmGrantee(string scheme,address wallet,bytes32 privacySalt,string siteLabel,uint8 slot)")
