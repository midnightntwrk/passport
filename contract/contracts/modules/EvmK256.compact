              0xc5, 0xa4, 0x03, 0x07, 0xd0, 0xfb, 0xc0, 0xf1, 0xa8, 0xbd, 0x80, 0x26, 0xc0, 0xe2, 0xd7, 0x19]
    };
  }

  // sol_ed25519: a Solana key, shown as its base58 text, and its privacy salt (SolanaDevice, SolanaGrantee).
  pure circuit evm_k256_kind_sol_ed25519(): EvmK256Kind {
    return EvmK256Kind {
      device: device_tag_sol_ed25519(), grant_id: grant_id_tag_sol_ed25519(), payload: EvmK256Payload.ed25519, key_text: EvmK256KeyText.base58,
