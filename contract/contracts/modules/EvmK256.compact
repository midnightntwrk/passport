        Bytes[0x52, 0x1f, 0x99, 0x07, 0xb8, 0x97, 0xbe, 0x26, 0x9c, 0xa4, 0x82, 0x56, 0x72, 0xcf, 0x91, 0x0f,
              0x41, 0x60, 0xcf, 0x9e, 0x12, 0x55, 0xf3, 0x34, 0x48, 0x90, 0x35, 0xb9, 0xab, 0xd1, 0xf8, 0x08],
      // keccak256("midnight:account:grant:id:evm:v1")
      grantee_scheme:
        Bytes[0xf6, 0xf4, 0xf2, 0x47, 0x4b, 0x65, 0x0f, 0xee, 0xb7, 0x03, 0x6f, 0xc2, 0xc7, 0x55, 0x63, 0x81,
              0x12, 0xb3, 0xf4, 0xe2, 0xd9, 0x37, 0x6f, 0x8a, 0xa2, 0xf0, 0x59, 0x6a, 0xa1, 0xbe, 0x31, 0x1c],
      // keccak256("AddDevice(bytes32 account,address device,uint64 authNonce,string effect,EvmDevice newDevice)EvmDevice(string scheme,address wallet,bytes32 privacySalt)")
      add_device_type:
        Bytes[0x0d, 0x75, 0xa3, 0x00, 0xd2, 0xc3, 0x2d, 0xd0, 0x0b, 0xc7, 0x61, 0x7a, 0x4a, 0xeb, 0x08, 0x85,
              0x1b, 0xef, 0xa6, 0x7c, 0x7a, 0xf4, 0x4e, 0xa6, 0xa1, 0x54, 0xef, 0xcb, 0x89, 0xf2, 0x02, 0x29],
      // keccak256("RemoveDevice(bytes32 account,address device,uint64 authNonce,EvmDevice target,uint32 targetEpoch,uint64 targetCounter)EvmDevice(string scheme,address wallet,bytes32 privacySalt)")
      remove_device_type:
        Bytes[0xfb, 0xda, 0x80, 0x6f, 0xf8, 0x10, 0xad, 0xb3, 0xa9, 0x26, 0xb9, 0xd7, 0xc6, 0x51, 0xab, 0x03,
              0x3d, 0x62, 0x24, 0xa6, 0x91, 0x95, 0xe9, 0x59, 0x39, 0xe5, 0xec, 0xc8, 0x40, 0x10, 0x4d, 0x7b],
      // keccak256("IssueGrant(bytes32 account,address device,uint64 authNonce,string effect,EvmGrantee grantee,bool withdrawUnshielded,bool withdrawShielded,bool withdrawShieldedToContract,bool read,bytes32 color,string recipientKind,bytes32 recipient,uint128 maxCoinValue,uint128 perCallCap,uint128 cap,uint64 expiresAt,string expiry,bytes32 passkeyRpHash,string passkeyRp,bytes32 readKey,uint64 windowLength,uint128 windowCap,string window,bool callerPinned,bytes32 caller)EvmGrantee(string scheme,address wallet,bytes32 privacySalt,string siteLabel,uint8 slot)")
      issue_grant_type:
        Bytes[0x49, 0x83, 0xa0, 0xbd, 0xae, 0xe4, 0xa8, 0xfb, 0x28, 0x9a, 0xce, 0xac, 0x17, 0xfe, 0x67, 0xdf,
              0xdb, 0x64, 0xd9, 0x47, 0x98, 0x52, 0xca, 0x1a, 0x44, 0xed, 0x37, 0xa5, 0xb9, 0x14, 0x43, 0xc5],
      // keccak256("RevokeGrant(bytes32 account,address device,uint64 authNonce,EvmGrantee grantee)EvmGrantee(string scheme,address wallet,bytes32 privacySalt,string siteLabel,uint8 slot)")
