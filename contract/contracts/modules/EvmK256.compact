  // keccak256("not applicable")
  pure circuit evm_k256_label_passkey_rp_0(): Bytes<32> {
    return Bytes[0x3d, 0xba, 0x47, 0x33, 0xc8, 0x6d, 0xab, 0xe6, 0xe8, 0xdc, 0x73, 0x87, 0xba, 0x7a, 0x57, 0x7c,
               0xb4, 0x02, 0x43, 0x4b, 0x52, 0xb0, 0xc1, 0xa6, 0x36, 0x66, 0x7d, 0x3a, 0x13, 0xe6, 0x55, 0x20];
  }

  // keccak256("see passkeyRpHash")
  pure circuit evm_k256_label_passkey_rp_1(): Bytes<32> {
    return Bytes[0x57, 0x37, 0x4e, 0xcb, 0x5a, 0x18, 0x39, 0xb6, 0xdf, 0x55, 0x3e, 0x8f, 0xa2, 0x82, 0x86, 0x75,
               0xf2, 0xf4, 0x3a, 0x10, 0x57, 0x9b, 0x00, 0x69, 0x6c, 0x23, 0x5f, 0x0f, 0x5c, 0x6a, 0xe4, 0xc4];
  }

  // ── Words ─────────────────────────────────────────────────────────────────
  //
  // EIP-712 integers are big-endian (the zero prefix is a separate tuple
  // element). Each word comes from a checked hint of the value's
  // little-endian bytes (see "Checked byte hints"): the hint is rebuilt as a
  // number and compared with the value, then emitted in reverse.

  // compact row optimization | hinted big-endian uint32 word | -90% rows
  export circuit evm_k256_be4(v: Uint<32>, h: Vector<4, Uint<8>>): Bytes<4> {
    assert((Bytes[...h] as Field) == (v as Field), "evm_k256: word hint does not match its value");
    return Bytes[h[3], h[2], h[1], h[0]];
  }
  // compact row optimization | hinted big-endian uint64 word | -89% rows
  export circuit evm_k256_be8(v: Uint<64>, h: Vector<8, Uint<8>>): Bytes<8> {
    assert((Bytes[...h] as Field) == (v as Field), "evm_k256: word hint does not match its value");
    return Bytes[h[7], h[6], h[5], h[4], h[3], h[2], h[1], h[0]];
  }
  // compact row optimization | hinted big-endian uint128 word | -89% rows
  export circuit evm_k256_be16(v: Uint<128>, h: Vector<16, Uint<8>>): Bytes<16> {
    assert((Bytes[...h] as Field) == (v as Field), "evm_k256: word hint does not match its value");
    return Bytes[h[15], h[14], h[13], h[12], h[11], h[10], h[9], h[8], h[7], h[6], h[5], h[4], h[3], h[2], h[1], h[0]];
  }
  // A 32-byte value in reverse byte order (secp256k1 and P-256 coordinates are
  // stored little-endian and shown big-endian), from a checked hint of its bytes.
  // compact row optimization | reversed 32-byte coordinate from a checked hint | -79% rows
  circuit rev32(b: Bytes<32>, h: Vector<32, Uint<8>>): Bytes<32> {
    const v = evm_reversed(evm_bytes_of(b, h));
    return Bytes[...v];
  }
  circuit u8b(v: Uint<8>): Bytes<1> { return v as Bytes<1>; }
  circuit boolb(b: Boolean): Bytes<1> { return (b ? 1 : 0) as Uint<8> as Bytes<1>; }

  // ── Checked byte hints ────────────────────────────────────────────────────
  //
  // Taking bytes out of a value costs a full field decomposition per byte, so
  // the circuits take a value's bytes as a hint instead: a `Uint<8>` vector
  // that must be exactly the value's bytes in the order Compact stores them
  // (a `Bytes<n>` in order, a number little-endian). Each check rebuilds the
  // value from the vector and compares: every element is range-checked to 8
  // bits as a circuit argument, each limb has at most 31 bytes (below the
  // field size, so no wrap-around), and base-256 digits are unique, so no
  // other vector passes. A hint is bound once and the checked vector is the
  // one used. The 32-byte helpers (evm_bytes_of, evm_reversed, evm_low20)
  // are the EVM identity module's, which the address needs.

  // ── Text ──────────────────────────────────────────────────────────────────

  // Exact visible ASCII (0x21..0x7e): a passkey origin, shown byte for byte.
  // `h` is a checked hint of the origin's bytes.
  // compact row optimization | passkey origin bytes from a checked hint | -73% rows
  circuit visible_21(b: Bytes<21>, h: Vector<21, Uint<8>>): Boolean {
    assert(Bytes[...h] == b, "evm_k256: byte hint does not match its value");
    return fold((ok: Boolean, c: Uint<8>): Boolean => ok && c >= 33 && c <= 126, true, h);
  }

  // A 32-byte site label: one or more words of visible ASCII separated by
  // single spaces, then zero bytes only (the grammar of the shared rendering
  // module's label_text_32). Returns the label as the wallet shows it, zero
  // bytes as spaces, and whether it follows the grammar; the grammar makes the
  // shown text one-to-one with the stored bytes. `h` is a checked hint of the
  // label's bytes.
  // compact row optimization | site label bytes from a checked hint | -66% rows
  circuit label_text(label: Bytes<32>, h: Vector<32, Uint<8>>): [Bytes<32>, Boolean] {
    const v = evm_bytes_of(label, h);
    // [the previous byte was a space (true before the first byte),
    //  the padding has begun, every byte fits]
    const r = fold((s: [Boolean, Boolean, Boolean], c: Uint<8>): [Boolean, Boolean, Boolean] => {
      const zero = c == 0;
      const space = c == 32;
      const shown = c >= 33 && c <= 126;
      const fits = s[1] ? zero
                 : zero ? !s[0]
                 : shown || (space && !s[0]);
      return [space, s[1] || zero, s[2] && fits];
    }, [true, false, true], v);
    const m = map((c: Uint<8>): Uint<8> => (c == 0 ? 32 : c) as Uint<8>, v);
    return [Bytes[m[0],  m[1],  m[2],  m[3],  m[4],  m[5],  m[6],  m[7],  m[8],  m[9],  m[10], m[11], m[12], m[13], m[14], m[15],
                  m[16], m[17], m[18], m[19], m[20], m[21], m[22], m[23], m[24], m[25], m[26], m[27], m[28], m[29], m[30], m[31]],
            r[2] && !r[0]];
  }

  // keccak256 of a site label as the wallet shows it (the `string siteLabel`);
  // `h` is a checked hint of the label's bytes.
  export pure circuit evm_k256_site_label_hash(label: Bytes<32>, h: Vector<32, Uint<8>>): Bytes<32> {
    const [text, ok] = label_text(label, h);
    assert(ok, "evm_k256: not a site label");
    return keccak256<Bytes<32>>(text);
  }

  // ── Labels ──────────────────────────────────────────────────────────
  //
  // An enumerated member is shown as a text label: a circuit constant chosen
  // by the value, so the label and the value can never disagree; a value with
  // no label is refused.

  circuit evm_k256_recipient_kind_label(kind: Uint<8>): Bytes<32> {
    assert(kind <= 3, "evm_k256: not a recipient kind");
    return kind == 0 ? evm_k256_label_recipient_kind_0() : kind == 1 ? evm_k256_label_recipient_kind_1()
         : kind == 2 ? evm_k256_label_recipient_kind_2() : evm_k256_label_recipient_kind_3();
  }

  circuit evm_k256_envelope_label(envelope: Uint<8>): Bytes<32> {
    return envelope == 0 ? evm_k256_label_envelope_0() : evm_k256_label_envelope_1();
  }

  // The exact words, each one of two fixed texts selected by exact equality
  // with the executed values. "not applicable" and "no window" are the base's
  // words (src/wallet/rendering.ts); the other text of each points at the
  // typed members that carry the values. A zero RP hash only occurs on a
  // grant whose RP pin is never checked (no passkey grantee, or one that
  // cannot spend).
  circuit evm_k256_passkey_rp_word(rp_id_hash: Bytes<32>): Bytes<32> {
    return rp_id_hash == pad(32, "") ? evm_k256_label_passkey_rp_0() : evm_k256_label_passkey_rp_1();
  }

  // `string window`: "no window" when the window length and the window cap
  // are both 0 (no per-window bound applies), else the pointer.
  circuit evm_k256_window_word(window_len: Uint<64>, window_cap: Uint<128>): Bytes<32> {
    return window_len == 0 && window_cap == 0 ? evm_k256_label_window_0() : evm_k256_label_window_1();
  }

  // ── Readable texts (the shared rendering module's checked texts) ────────
  //
  // Each text is a display input checked against the executed value by the
  // base's circuit, so the shown text and the value cannot disagree, and
  // each value has exactly one valid input.

  // keccak256 of `string expiry`: "never" for 0, the UTC date and time
  // "yyyy-mm-dd hh:mm:ss UTC" for 1 to 253402300799, and the words "after
  // 9999-12-31 23:59:59 UTC" above; the exact text, no padding.
  // `text` and `year_split` are utc_datetime_text's inputs, which it checks
  // against the value (for 0 the date of 0, which is not shown). The date
  // fills the text's first 23 bytes; only the date needs a hash here, the
  // two other texts are constants.
  circuit evm_k256_expiry_hash(expires_at: Uint<64>, text: Vector<29, Uint<8>>, year_split: Vector<4, Uint<8>>): Bytes<32> {
    const t = utc_datetime_text(expires_at, text, year_split);
    const date = keccak256<Bytes<23>>(Bytes[t[0],  t[1],  t[2],  t[3],  t[4],  t[5],  t[6],  t[7],  t[8],  t[9],  t[10], t[11],
                                            t[12], t[13], t[14], t[15], t[16], t[17], t[18], t[19], t[20], t[21], t[22]]);
    return expires_at == 0 ? evm_k256_label_expiry_0()
         : expires_at > 253402300799 ? evm_k256_label_expiry_after() : date;
  }

  // keccak256 of `string amountLabel`: the fixed words "This site labels it: "
  // (the label is the site's claim, not a value the contract knows), then
  // the site's 49-byte space-padded label for the amount, whose digits
  // site_amount_label_text checks against the amount; the site chooses only
  // the decimal point and the symbol.
  circuit evm_k256_amount_label_hash(amount: Uint<128>, label: Vector<49, Uint<8>>): Bytes<32> {
    const t = site_amount_label_text(amount, label);
    return keccak256<[Bytes<21>, Bytes<49>]>([pad(21, "This site labels it: "), Bytes[...t]]);
  }

  // keccak256 of an Ed25519 kind's publicKey text: base58 (44 padded
  // bytes), the same text with the ed25519: prefix, or 64 lowercase hex
  // characters. Every form checks the base58 hint against the key.
  export circuit evm_k256_key_text_hash(key: Vector<32, Uint<8>>, h: EvmK256Base58Hint, form: EvmK256KeyText): Bytes<32> {
    const ED25519_KEY_PREFIX = pad(8, "ed25519:");
    // Also check hints for hex and for non-Ed25519 descriptor fillers.
    const text = Bytes[...base58_text_32(key, h.digits, h.carry, h.low, h.top)];
    const base58_hash = keccak256<Bytes<44>>(text);
    const prefixed_base58_hash = keccak256<[Bytes<8>, Bytes<44>]>([ED25519_KEY_PREFIX, text]);
    const hex_hash = keccak256<Bytes<64>>(Bytes[...hex_text_32(Bytes[...key])]);
    return form == EvmK256KeyText.prefixed_base58 ? prefixed_base58_hash : form == EvmK256KeyText.hex ? hex_hash : base58_hash;
  }

  // ── Enrolment kinds ───────────────────────────────────────────────────────
  //
  // The kinds of key the arm can add, remove, or grant to, one entry each in
  // evm_k256_kinds(): the kind's device and grant-id tags (registered in the
  // descriptor module; a descriptor names its kind by its tag, and the
  // typed data shows the tag's text as `scheme`), the form of its key
  // payload, and the type hashes its typed data uses: its nested
  // <Kind>Device and <Kind>Grantee types, the keccak256 of their `scheme`
  // texts, and the four parent types that nest them.
  //
  // To add a kind whose key fits an existing payload form: write its entry
  // circuit (its tags and its eight type hashes), add it to evm_k256_kinds()
  // and raise the vector's length by one. Every circuit below reads its
  // per-kind values from the entry; nothing else changes. A kind whose key
  // fits no form needs a form of its own: a member of EvmK256Payload, its
  // nested hashStructs and its derivations.
  //
  // The kind is selected by the descriptor's tag, which comes from the
  // signed values: one tag comparison per entry.

  // How a kind's key is shown and derived. Each form fixes the members of
  // its nested types after `string scheme`, and the descriptor module's
  // recipes of its entry and its grant id:
  //   address: wallet, privacySalt; the grantee adds siteLabel and slot;
  //     entry and grant id by class w52 (an address and the blind)
  //   ed25519: publicKey (the kind's selected key text), privacySalt; the
  //     grantee adds siteLabel and slot; by the ed25519 class
  //   jubjub: x, y; the grantee adds siteLabelHash and slot; by w64
  //   k256: x, y, envelope; the grantee adds siteLabelHash and slot; by w65
  //   passkey: x, y, origin, passkeyRpHash; the grantee has x, y, origin and
  //     slot; the entry by w117, the grant id by w64
  export enum EvmK256Payload { address, ed25519, jubjub, k256, passkey }

  // Presentation does not alter the identity or descriptor derivation.
  export enum EvmK256KeyText { base58, prefixed_base58, hex }

  export struct EvmK256Kind {
    device:             Bytes<32>;
    grant_id:           Bytes<32>;
    payload:            EvmK256Payload;
    key_text:           EvmK256KeyText;
    device_type:        Bytes<32>;
    device_scheme:      Bytes<32>;
    grantee_type:       Bytes<32>;
    grantee_scheme:     Bytes<32>;
    add_device_type:    Bytes<32>;
    remove_device_type: Bytes<32>;
    issue_grant_type:   Bytes<32>;
    revoke_grant_type:  Bytes<32>;
  }

  // evm_k256: an Ethereum address and its privacy salt (EvmDevice, EvmGrantee).
  pure circuit evm_k256_kind_evm_k256(): EvmK256Kind {
    return EvmK256Kind {
      device: device_tag_evm_k256(), grant_id: grant_id_tag_evm_k256(), payload: EvmK256Payload.address, key_text: EvmK256KeyText.base58,
      // keccak256("EvmDevice(string scheme,address wallet,bytes32 privacySalt)")
      device_type:
        Bytes[0x36, 0xfe, 0xd4, 0xcb, 0x1f, 0x99, 0x65, 0x85, 0xfb, 0x40, 0x3e, 0x01, 0xa6, 0x15, 0xc8, 0x54,
              0xb5, 0x92, 0x3c, 0xaa, 0x1d, 0x28, 0xe5, 0x20, 0xba, 0x14, 0x8c, 0x81, 0x92, 0x04, 0xa8, 0xf8],
