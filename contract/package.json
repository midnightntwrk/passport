{
  "name": "midnight-account-custody",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Reference implementation of the Midnight account custody standard: MIP-0012 (contract custody of native assets) with the authorisation seam carried as co-resident arms: JubJub Schnorr (the MIP-0013 scheme) and an interim ECDSA-secp256k1 engineering arm.",
  "scripts": {
    "compile": "compact compile +0.33.0-rc.2 --feature-zkir-v3 contracts/account.compact contracts/managed/account && compact compile +0.33.0-rc.2 --feature-zkir-v3 contracts/control.compact contracts/managed/control && compact compile +0.33.0-rc.2 --feature-zkir-v3 contracts/faucet.compact contracts/managed/faucet",
    "build": "tsc",
    "test:unit": "tsx src/tests/unit-offline.ts",
    "test:crossimpl-offline": "tsx src/tests/crossimpl-offline.ts",
    "test:auth-crossimpl": "tsx src/tests/auth-crossimpl.ts",
    "test:auth": "tsx src/tests/auth-conformance.ts",
    "test:auth-coinless": "tsx src/tests/auth-coinless.ts",
    "test:auth-lifecycle": "tsx src/tests/auth-lifecycle.ts",
    "test:auth-replay": "tsx src/tests/auth-replay.ts",
    "test:custody-shielded": "tsx src/tests/custody-shielded.ts",
    "test:custody-discovery": "tsx src/tests/custody-discovery.ts",
    "test:custody-unshielded": "tsx src/tests/custody-unshielded.ts",
    "test:custody-payments": "tsx src/tests/custody-payments.ts",
    "test:leak-audit": "tsx src/tests/leak-audit.ts",
    "probe:revocation": "tsx src/tests/probe-revocation.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.5-rc.6",
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.4",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.4",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-beta.1",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-beta.2",
    "@noble/curves": "2.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  }
}
