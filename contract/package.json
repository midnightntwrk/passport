{
  "name": "midnight-account-custody",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Reference implementation of Midnight account custody with co-resident JubJub Schnorr, secp256k1 ECDSA and profiled P-256 WebAuthn authorisation arms.",
  "scripts": {
    "compile:ecc": "compact compile +0.35.0 --feature-zkir-v3 --skip-zk contracts/account.compact contracts/managed/account",
    "compile": "compact compile +0.35.0 --feature-zkir-v3 contracts/account.compact contracts/managed/account && compact compile +0.35.0 --feature-zkir-v3 contracts/control.compact contracts/managed/control && compact compile +0.35.0 --feature-zkir-v3 contracts/faucet.compact contracts/managed/faucet && compact compile +0.35.0 --feature-zkir-v3 contracts/probe-block-time.compact contracts/managed/probe-block-time && compact compile +0.35.0 --feature-zkir-v3 contracts/probe-p256.compact contracts/managed/probe-p256 && compact compile +0.35.0 contracts/probe-grant-caller.compact contracts/managed/probe-grant-caller && compact compile +0.35.0 --feature-zkir-v3 contracts/probe-wallet-arms-base.compact contracts/managed/probe-wallet-arms-base && compact compile +0.35.0 --feature-zkir-v3 contracts/probe-sol-ed25519-fixtures.compact contracts/managed/probe-sol-ed25519-fixtures",
    "build": "tsc",
    "test:unit": "tsx src/tests/unit-offline.ts",
    "test:ecc": "node --import tsx src/tests/ecc-validation.ts",
    "test:ecc-wallet": "node --import tsx src/tests/ecc-wallet.ts",
    "test:ecc-nonces": "node --import tsx src/tests/ecc-followups.ts nonces",
    "test:ecc-encodings": "node --import tsx src/tests/ecc-followups.ts encodings",
    "test:ecc-recovery": "node --import tsx src/tests/ecc-followups.ts recovery",
    "test:p256-offline": "tsx src/tests/p256-offline.ts",
    "compile:webauthn-variable": "node ../experiments/webauthn-variable-json/generate.mjs && compact compile +0.35.0 --feature-zkir-v3 contracts/probe-webauthn-variable.compact contracts/managed/probe-webauthn-variable",
    "test:webauthn-variable": "tsx src/tests/webauthn-variable/offline.ts",
    "check:webauthn-variable": "tsc -p tsconfig.webauthn-variable.json",
    "measure:webauthn-variable": "tsx src/tests/webauthn-variable/measure.ts",
    "prove:webauthn-variable": "tsx src/tests/webauthn-variable/prove.ts",
    "resources:webauthn-variable": "tsx src/tests/webauthn-variable/resources.ts",
    "check:webauthn-transcripts": "tsx src/tests/webauthn-variable/check-transcripts.ts",
    "test:sol-ed25519-offline": "tsx src/tests/sol-ed25519-offline.ts && tsx src/tests/sol-ed25519-message-offline.ts && tsx src/tests/sol-ed25519-seam-offline.ts && tsx src/tests/sol-ed25519-custody-offline.ts && tsx src/tests/sol-ed25519-devices-offline.ts && tsx src/tests/sol-ed25519-grants-offline.ts && tsx src/tests/sol-ed25519-recovery-sim.ts && tsx src/tests/sol-ed25519-taint-offline.ts && tsx src/tests/sol-ed25519-client-offline.ts && tsx src/tests/sol-ed25519-fixtures-offline.ts",
    "check:sol-ed25519-taint-controls": "tsx src/tests/sol-ed25519-taint-controls.ts",
    "test:sol-ed25519": "tsx src/tests/sol-ed25519-prover.ts",
    "test:p256": "tsx src/tests/p256-conformance.ts",
    "test:p256-browser": "tsx src/tests/p256-browser.ts",
    "verify:p256-browser": "tsx src/tests/p256-browser-evidence.ts",
    "test:view-envelope-offline": "tsx src/tests/inbox-view-envelope/offline.ts",
    "test:view-envelope": "tsx src/tests/inbox-view-envelope/localnet.ts",
    "test:view-envelope-browser": "tsx src/tests/inbox-view-envelope/browser.ts",
    "report:view-envelope": "tsx src/tests/inbox-view-envelope/report.ts",
    "measure:p256": "tsx src/tests/p256-measure.ts",
    "report:p256": "tsx src/tests/p256-report.ts",
    "test:toolchain-offline": "tsx src/tests/toolchain-offline.ts",
    "test:recovery-offline": "tsx src/tests/recovery-offline.ts",
    "test:recovery-sim": "tsx src/tests/recovery-sim.ts",
    "test:recovery": "tsx src/tests/recovery-conformance.ts",
    "test:grants-offline": "tsx src/tests/grants-offline.ts",
    "test:grants-caller-offline": "tsx src/tests/grants-caller-offline.ts",
    "test:grants-caller": "tsx src/tests/grants-caller.ts",
    "test:crossimpl-offline": "tsx src/tests/crossimpl-offline.ts",
    "test:auth-crossimpl": "tsx src/tests/auth-crossimpl.ts",
    "test:auth": "tsx src/tests/auth-conformance.ts",
    "test:auth-coinless": "tsx src/tests/auth-coinless.ts",
    "test:auth-lifecycle": "tsx src/tests/auth-lifecycle.ts",
    "test:auth-replay": "tsx src/tests/auth-replay.ts",
    "test:custody-shielded": "tsx src/tests/custody-shielded.ts",
    "test:custody-discovery": "tsx src/tests/custody-discovery.ts",
    "test:custody-unshielded": "tsx src/tests/custody-unshielded.ts",
    "test:custody-payments": "tsx src/tests/custody-payments.ts",
    "test:grants-conformance": "tsx src/tests/grants-conformance.ts",
    "test:grants-unshielded": "tsx src/tests/grants-unshielded.ts",
    "test:leak-audit": "tsx src/tests/leak-audit.ts",
    "probe:revocation": "tsx src/tests/probe-revocation.ts",
    "probe:block-time": "tsx src/tests/probe-block-time.ts",
    "probe:wave-ceiling": "tsx src/tests/probe-wave-ceiling.ts",
    "probe:onchain-vk": "tsx src/tests/probe-onchain-vk.ts ../experiments/proving-key-regeneration/onchain",
    "probe:vk-derived-pk": "tsx src/tests/probe-vk-derived-pk.ts",
    "probe:dismiss-cost": "tsx src/tests/probe-dismiss-cost.ts",
    "test:p256-grants": "tsx src/tests/p256-grants.ts",
    "test:p256-grant-refusals": "tsx src/tests/p256-grant-refusals.ts",
    "test:grants-capability-offline": "tsx src/tests/grants-capability-offline.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0-rc.3",
    "@midnight-ntwrk/compact-runtime": "0.20.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-rc.2",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-rc.0",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-rc.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-rc.0",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-rc.0",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-rc.0",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-rc.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.19.0"
  }
}
